<link href="~/Content/font-icon.css" rel="stylesheet" type="text/css" />

<!--  My Style  -->
<link href="~/Content/css/style.css" rel="stylesheet" type="text/css" />

<link href="~/Content/RootStyle.css" rel="stylesheet" type="text/css" />
<div class='top_baner' style="background-image:url(../Uploade/Images/@Model.Image_Cover);">
    <center>
        @* <span>@Model.Title</span>
            <p>هذا النص هو مثال لنص يمكن أن يستبدل في نفس المساحة</p>
                 <a href="javascript:;">للمزيد</a>*@
    </center>
</div>

<!-- Nav tabs -->
<div class="tabs_sec sec sidebar_type" style="background-color:white">
    <div class="container" style="max-width: 100%; background-color: white">
        <ul id="tabs" class="nav nav-tabs scrollbar" style="background-color: #113464" role="tablist">

            @for (int i = 0; i < Model.L_aboutTabmodel.ToList().Count; i++)
            {
                if (i == 0)
                {
                    <li role="presentation"><a href="#tab_@Model.L_aboutTabmodel.ToList()[i].ID" role="tab" data-toggle="tab" class="active"> @Model.L_aboutTabmodel.ToList()[i].Tab_Title</a></li>

                }
                else
                {

                    <li role="presentation"><a href="#tab_@Model.L_aboutTabmodel.ToList()[i].ID" role="tab" data-toggle="tab"> @Model.L_aboutTabmodel.ToList()[i].Tab_Title</a></li>
                }
            }
            @*<li role="presentation"><a href="#tab1" role="tab" data-toggle="tab">نشأة الجامعة</a></li>
                <li role="presentation"><a href="#tab2" role="tab" data-toggle="tab" class="active">الرؤية والرسالة</a></li>
                <li role="presentation"><a href="#tab3" role="tab" data-toggle="tab"> الأهداف</a></li>
                <li role="presentation"><a href="#tab4" role="tab" data-toggle="tab"> نظام التدريس</a></li>
                <li role="presentation"><a href="#tab5" role="tab" data-toggle="tab"> الإعتمادات</a></li>
                <li role="presentation"><a href="#tab6" role="tab" data-toggle="tab"> اتصل بنا</a></li>*@
        </ul>

        <div class="tab-content">
            @for (int i = 0; i < Model.L_aboutTabmodel.ToList().Count; i++)
            {
                if (i == 0)
                {
                    <div role="tabpanel" class="tab-pane fade in active" id="tab_@Model.L_aboutTabmodel.ToList()[i].ID">
                        @Html.Raw(Model.L_aboutTabmodel.ToList()[i].Tab_Content)
                    </div>

                }
                else
                {
                    <div role="tabpanel" class="tab-pane fade" id="tab_@Model.L_aboutTabmodel.ToList()[i].ID">
                        @Html.Raw(Model.L_aboutTabmodel.ToList()[i].Tab_Content)
                    </div>
                }
            }


        </div>
    </div>
</div>

