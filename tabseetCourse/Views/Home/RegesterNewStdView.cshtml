<div class="login_content">
    <div class="form_sec" style="width:600px">
        <h1>إنشاء حساب</h1>

        <div class="form_section">

            @Html.AntiForgeryToken()


            <h4 style="
    color: white;">
                معلومات شخصية
            </h4>

            <table style="width:100%">
                <tr>
                    <td>
                        <div class="form-group">
                            <label for="Country" style="
    color: white;
    direction: rtl;
    float: right;
">البلد</label>
                            <select id="Country_ID" name="Country" class="form-control">
                            </select>
                        </div>
                    </td>
                    <td>
                        <div class="form-group">
                            <label for="FlullName" style="
    color: white;
    direction: rtl;
    float: right;
">الاسم </label>
                            <input name="FullName" id="FullName" class="form-control" placeholder="@Model.FirstName_tran " />
                        </div>
                    </td>

                </tr>
                <tr>
                    <td>
                        <div class="form-group">
                            <label form="PhoneNumber" style="
    color: white;
    direction: rtl;
    float: right;
">رقم الهاتف</label>
                            <input name="PhoneNumber" id="Mobile_Number" class="form-control" placeholder="@Model.Mobile_number_tran" onkeyup="isValid(this)" />
                        </div>
                    </td>
                    <td>
                        <div class="form-group">
                            <label for="Email" style="
    color: white;
    direction: rtl;
    float: right;
">البريد الإلكتروني</label>
                            <input name="Email" id="Email" type="email" class="form-control" placeholder="@Model.Email_tran" onchange="ValidateEmail('Email')" />
                        </div>
                    </td>
                </tr>
                <tr>
                    <td colspan="2">
                        <div class="form-group">
                            <label for="Password" style="
    color: white;
    direction: rtl;
    float: right;
">كلمة المرور</label>
                            <input name="Password" id="Password_ID" required class="form-control" type="password" placeholder="@Model.Password_tran" />
                        </div>
                    </td>
                </tr>

            </table>
        </div>
        <button type="submit" class="btn btn-primary submit_btn" onsubmit="" onclick="RegjesterNewStd()">تسجيل</button>


        <button type="button" class="btn btn-primary facebook_btn">
            <i class="fab fa-facebook"></i>
            تسجيل دخول فيسبوك
        </button>

        <div class="form-group">

            <a href="@Url.Action("LogIn","Home")" class="register">تسجيل دخول  </a>
        </div>

        @if (ViewBag.Message != null)
        {
            <div class="form-group">
                <div class="alert alert-danger">
                    <h3>

                        @ViewBag.Message
                    </h3>
                </div>
            </div>
        }
    </div>
</div>
