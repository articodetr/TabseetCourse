    function RegjesterNewStd() {
        const Toast = Swal.mixin({
            toast: true,

            position: 'top-center',
            showConfirmButton: true,
            timer: 9999
        });
        var fd = new FormData();




         fd.append('RealName', $('#FullName').val());
         fd.append('Gender', $('#Gender').val());
         fd.append('Email', $('#Email').val());
         fd.append('PhoneNumber', $('#Mobile_Number').val());
         fd.append('Password', $('#Password_ID').val());
         fd.append('Country', $('#Country_ID').val());



        // AJAX request
        $.ajax({
            url: '@Url.Action("RegesterNewStdView", "Home")',
            async: true,
            type: 'POST',
            data: fd,
            contentType: false,
            processData: false,
            success: function (data) {


                if (data.success == false) {
                    alert(data.responsetext);
                } else {

                    Toast.fire({
                        icon: 'success',
                        title: 'تهاتينا لقد أكملت التسجيل بنجاح <br> يرجى متابعة برامجنا واختيار مايناسبك منها',

                        showClass: {
                            popup: 'animate__animated animate__fadeInDown'
                        },
                        confirmButtonText: 'التوجه لإختيار برنامج!',


                    }).then(function () {
                        location.href = "@Url.Action("MoreCourse", "Home")";
                    });

                }
            },
            error: function (response) {
                    Toast.fire({
                        icon: 'error',
                        title: 'يرجى ملأ كافة المعلومات',

                        showClass: {
                            popup: 'animate__animated animate__fadeInDown'
                        },



                    }) ;
                //alert('There is an error Please make sure to fill in all the information ');
            },
            complete: function (response) {
                //alert("finish call jasion " + response);
            }
        });
    }

