<script>
    var isLoading = true;
    var parallax = $('.top_banar');
    parallax.css({ 'background-position': 'center center' }); // better use CSS

    $(window).scroll(function () {
        var st = $(this).scrollTop();
        parallax.css({ 'background-position': 'center calc(50% + ' + (st / 5) + 'px)' });
    });

    function Validate(uemail) {
        var phone = $('#PhoneNumber').val();

        var message = $('#Message').val();

        var name = $('#Name').val();


        var mailformat = /^([\w-\.]+)@@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.)|(([\w-]+\.)+))([a-zA-Z]{2,4}|[0-9]{1,3})(\]?)$/;
        if (mailformat.test(uemail)) {

        } else {
            alert("يجب إضافة ايميل صحيح")
            return false;
        }
        console.log("nameLeng " + name.length);
        if (name.length > 0) {


        } else {
            alert("يجب إضافة اسم صحيح")
            return false;
        }
        console.log("phoneLeng " + phone.length);
        if (phone.length > 0) {


        } else {
            alert("يجب إضافة رقم هاتف صحيح")
            return false;
        }
        console.log("messageLeng " + message.length);
        if (message.length > 0) {


        } else {
            alert("يجب اضافة رسالة  ")
            return false;
        }
        return true;
    }

    function SendMessage() {
        const Toast = Swal.mixin({
            toast: true,
            position: 'top-center',
            showConfirmButton: true,
            timer: 9999
        });
        var _name = $('#Name').val()
        var _Email = $('#Email').val()
        var _PhoneNumber = $('#PhoneNumber').val()
        var _Message = $('#Message').val()
        var result = Validate(_Email)
        if (result == false) {
            return;
        }
        $.ajax(
            {
                async: true,

                type: 'POST',
                data: { Name: _name, Phonenumber: _PhoneNumber, Email: _Email, Message: _Message },
                url: '@Url.Action("SendContactUsMessage", "Home")',
                success: function (data) {

       Toast.fire({
                        icon: 'success',
                        title: 'تم ارسال <br> سيتم الرد في اقرب وقت.',

                        showClass: {
                            popup: 'animate__animated animate__fadeInDown'
                        },
                        confirmButtonText: 'التوجه للصفحة الرئيسية!',


                    }).then(function () {
                        location.href = "@Url.Action("Index", "Home")";
                    });

                },
                error: function (result) {

                },
                complete: function (response) {
                }
            });
    }
</script>

