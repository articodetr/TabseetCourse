<link href="~/Content/RootStyle.css" rel="stylesheet" type="text/css" />
<div class='top_baner' style="background-image:url(../Uploade/Images/@Model.Image_Cover)">
    <center>
        @*<span>@Model.title</span>*@

    </center>
</div>


<style>
    body {
        background: #F5F5F7;
    }

    .top_banar {
        border-bottom: 8px solid #f15a24;
    }

    .form_section {
        float: left;
        width: 100%;
        min-height: 250px;
        max-width: 100%;
        margin: 0px auto;
    }

    iframe {
        border-radius: 10px;
        -webkit-box-shadow: 0px 3px 6px 0px rgba(171,171,171,0.5);
        -moz-box-shadow: 0px 3px 6px 0px rgba(171,171,171,0.5);
    }

    textarea {
        min-height: 120px;
    }
</style>

<div class="container">
    <div class="center_sec int_sub_content contact_sec">

        <div class="col-md-6 col-sm-12 col-xs-12" style="background-image: url(~/Content2/img/logo.png)">
            <!---- Register ---->
            <div class="form_section">
                <h3>@Model.title</h3>
                <form>
                    <div class="form-group">
                        <label>@Model.Name_word_trans</label>
                        <input name="name" id="Name" class="form-control" placeholder="@Model.Name_word_trans " />
                    </div>

                    <div class="form-group">
                        <label>@Model.Email_word_trans</label>
                        <input name="name" id="Email" class="form-control" placeholder="@Model.Email_word_trans" />
                    </div>

                    <div class="form-group">
                        <label>@Model.PhoneNumber_word_trans</label>
                        <input name="name" id="PhoneNumber" class="form-control" placeholder="@Model.PhoneNumber_word_trans" />
                    </div>

                    <div class="form-group">
                        <label>@Model.Message_word_trans</label>
                        <textarea name="name" id="Message" class="form-control" placeholder="@Model.Message_word_trans" row='3'></textarea>
                    </div>


                    <div class="form-group">
                        <button type="button" onclick="SendMessage()" class="btn-primary send_btn">@Model.Send_word_trans</button>
                    </div>

                </form>
            </div>




        </div>

        <div class="col-md-6 col-sm-12 col-xs-12">
            <iframe width="100%" height="450" frameborder="0" style="border:0"
                    src="@Model.Map_Link"></iframe>
            <ul class="address_sec">
                @*<li>
                        <b>@Model.Adress_word_trans</b>
                        <span class="adr">
                            @Model.UN_Adress
                        </span>
                    </li>*@
                <li>
                    <b>@Model.PhoneNumber_word_trans</b>
                    <span class="phone"><a href="tel:@Model.UN_PhoneNumber">@Model.UN_PhoneNumber</a></span>
                </li>
                <li>
                    <b>@Model.Email_word_trans</b>
                    <span class="email"><a href="mailto:@Model.UN_Email">@Model.UN_Email</a></span>
                </li>
            </ul>
        </div>

    </div>
</div>

