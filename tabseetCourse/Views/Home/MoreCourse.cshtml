</div>
@Html.AntiForgeryToken()
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
<script type="text/javascript" src="https://code.jquery.com/jquery-1.10.0.min.js"></script>
<script src="//cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>

    var isLoading = true;
    var lang_ID=@Session["Lang_ID"]
    $(document).ready(function () {
        SerchOnClick();

    });

    function SerchOnClick(courseName) {
        $.ajax(
            {
                async: true,

                type: 'POST',
                data: { CourseName: courseName },
                url: '@Url.Action("GetAllMoreCourse", "Home")',
                success: function (data) {
                    var s = '';


                    for (var i = 0; i < data.length; ++i) {
                   
                        s += '<div class="col-md-4">';
                        s += '<div class="item">';
                        s += '<div class="image">';
                        s += '<a href="#" onclick="DivClicked(' + data[i].New_Page_ID + ')">';
                        if (data[i].Icon == null) {
                            s += '<img src="https://cdn.europosters.eu/image/1300/zen-nature-i49609.jpg" alt="event name">';
                        }
                        else {
                            s +='<img src="/Uploade/Images/' + data[i].Icon + '" alt="event name">';
                        }


                        if (lang_ID == 2) {
                            s += '</a></div><h3>' + data[i].NameEn + '</h3>';
                        } else {
                            s += '</a></div><h3>' + data[i].NameAr + '</h3>';
                        }
                        
                        if (data[i].IsPayed == 1 && data[i].PayedValue != "0") {
                            s += '<span class="date">' + data[i].PayedValue + 'USD</span>';

                        }
                        else {
                            if (lang_ID == 2) {
                                s += '<span class="date">Free</span>';
                            } else {
                                s += '<span class="date">مجاني</span>';
                            }
                            
                        }
                        if (lang_ID == 2) {
                            if (data[i].CanRegister == 1) {
                                s += '<a href="#" onclick="TackThisCourse(' + data[i].ID + '); return false;" class="read_more">' + (data[i].IsPayed == 1 ? 'Request enrollment' : 'Enroll for free') + '</a>';
                            }
                            else {
                                s += '@@Html.ActionLink("Read More", "GoPageMenu", new { PageID =' + data[i].New_Page_ID + '}, new { @@class = "read_more" })';
                            }
                        } else {
                            if (data[i].CanRegister == 1) {
                                s += '<a href="#" onclick="TackThisCourse(' + data[i].ID + '); return false;" class="read_more">' + (data[i].IsPayed == 1 ? 'طلب الاشتراك' : 'اشترك مجانًا') + '</a>';
                            }
                            else {
                                s += '@@Html.ActionLink("اقرأ المزيد", "GoPageMenu", new { PageID =' + data[i].New_Page_ID + '}, new { @@class = "read_more" })';
                            }
                        }
                        
                        s += '</div></div>';
                    }

                    console.log( s);
                    $('#AllCouse').html(s);

                },
                error: function (result) {

                    //window.location.href = '/Home/Login?Coursid=' + result.responseJSON.responsetext;
                },
                complete: function (response) {
                    //alert("finish call jasion " + response);
                }
            });
    }

    function DivClicked(pageid) {
                        window.location.href = '/Home/GoPageMenu?PageID=' + pageid;
    };
    // طلب الاشتراك في دورة (آلية موحدة): المجانية تُفعَّل فوراً، والمدفوعة تُسجَّل بانتظار موافقة الإدارة بلا أي دفع داخل الموقع.
    // الاستجابة من الخادم: { success, response, state, alreadyRegistered, requiresLogin, courseId }
    function TackThisCourse(Course_ID) {
        var tokenEl = document.querySelector('input[name="__RequestVerificationToken"]');
        var notify = function (icon, title, done) {
            if (window.Swal) {
                Swal.fire({ icon: icon, title: title, confirmButtonText: 'حسناً', confirmButtonColor: '#113464' }).then(function () { if (done) done(); });
            } else {
                alert(title);
                if (done) done();
            }
        };
        $.ajax({
            async: true,
            type: 'POST',
            data: { course_ID: Course_ID, __RequestVerificationToken: tokenEl ? tokenEl.value : '' },
            url: '@Url.Action("TackThisCurse", "Home")',
            success: function (data) {
                if (data && data.requiresLogin) {
                    window.location.href = '@Url.Action("LogIn", "Home")?Coursid=' + Course_ID;
                    return;
                }
                if (data && data.success) {
                    notify('success', data.response, function () { window.location.href = '@Url.Action("CategoriesStd", "Students")'; });
                } else if (data && data.alreadyRegistered) {
                    notify('info', data.response, function () { window.location.href = '@Url.Action("CategoriesStd", "Students")'; });
                } else {
                    notify('warning', (data && data.response) ? data.response : 'تعذر إتمام طلب الاشتراك.');
                }
            },
            error: function () {
                notify('error', 'حدث خطأ أثناء إرسال طلب الاشتراك، يرجى تحديث الصفحة والمحاولة مجدداً.');
            }
        });
    }

</script>


