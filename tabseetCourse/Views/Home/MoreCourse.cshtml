
@{
    ViewBag.Title = "MoreCourse";
    Layout = "~/Views/Shared/_Layout.cshtml";
    //var viewmodelHomepage = (tabseetCourse.Models_UI.HomePageModel)ViewBag.HomepageViewModel;
}

@*<div class='top_baner' style="background-image:url(../Uploade/Images/@viewmodelHomepage.MainImage);">*@
<div class='top_baner' style="background-image: url(../Uploade/Images/image1.png);">
    <center>
        @* <span>@viewmodelHomepage.MainText</span>
            @*<p>هذا النص هو مثال لنص يمكن أن يستبدل في نفس المساحة</p>
                <a href="javascript:;">@Model.Title</a>*@
    </center>
</div>




<div class="grid_sec">

    <div class="container">

        <form class="form-inline" dir="rtl" method="get" action="MoreCourse">
            <input onkeyup="SerchOnClick(this.value)" onkeydown="return (event.keyCode!=13);" dir="rtl" class="form-control mr-sm-2" name="CourseName" value="@ViewData["CourseName"]" type="search" placeholder="بحث " aria-label="بحث">
            @*  <button dir="rtl" style="margin:5px" class="btn btn-outline-success my-2 my-sm-0" type="submit">بحث</button>*@
        </form>

        <div class="row" id="AllCouse">








        </div>
    </div>


</div>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
<script type="text/javascript" src="https://code.jquery.com/jquery-1.10.0.min.js"></script>
<script src="//cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>

    var isLoading = true;
    var lang_ID=@Session["Lang_ID"]
    $(document).ready(function () {
        SerchOnClick();

    });

    function SerchOnClick(courseName) {
        $.ajax(
            {
                async: true,

                type: 'POST',
                data: { CourseName: courseName },
                url: '@Url.Action("GetAllMoreCourse", "Home")',
                success: function (data) {
                    var s = '';


                    for (var i = 0; i < data.length; ++i) {
                   
                        s += '<div class="col-md-4">';
                        s += '<div class="item">';
                        s += '<div class="image">';
                        s += '<a href="#" onclick="DivClicked(' + data[i].New_Page_ID + ')">';
                        if (data[i].Icon == null) {
                            s += '<img src="https://cdn.europosters.eu/image/1300/zen-nature-i49609.jpg" alt="event name">';
                        }
                        else {
                            s +='<img src="/Uploade/Images/' + data[i].Icon + '" alt="event name">';
                        }


                        if (lang_ID == 2) {
                            s += '</a></div><h3>' + data[i].NameEn + '</h3>';
                        } else {
                            s += '</a></div><h3>' + data[i].NameAr + '</h3>';
                        }
                        
                        if (data[i].IsPayed == 1 && data[i].PayedValue != "0") {
                            s += '<span class="date">' + data[i].PayedValue + 'USD</span>';

                        }
                        else {
                            if (lang_ID == 2) {
                                s += '<span class="date">Free</span>';
                            } else {
                                s += '<span class="date">مجاني</span>';
                            }
                            
                        }
                        if (lang_ID == 2) {
                            if (data[i].CanRegister == 1) {
                                s += '<a href="#" onclick="TackThisCourse(' + data[i].ID + ')" class="read_more">Subscribe</a>';
                            }
                            else {
                                s += '@@Html.ActionLink("Read More", "GoPageMenu", new { PageID =' + data[i].New_Page_ID + '}, new { @@class = "read_more" })';
                            }
                        } else {
                            if (data[i].CanRegister == 1) {
                                s += '<a href="#" onclick="TackThisCourse(' + data[i].ID + ')" class="read_more">اشترك</a>';
                            }
                            else {
                                s += '@@Html.ActionLink("اقرأ المزيد", "GoPageMenu", new { PageID =' + data[i].New_Page_ID + '}, new { @@class = "read_more" })';
                            }
                        }
                        
                        s += '</div></div>';
                    }

                    console.log( s);
                    $('#AllCouse').html(s);

                },
                error: function (result) {

                    //window.location.href = '/Home/Login?Coursid=' + result.responseJSON.responsetext;
                },
                complete: function (response) {
                    //alert("finish call jasion " + response);
                }
            });
    }

    function DivClicked(pageid) {
                        window.location.href = '/Home/GoPageMenu?PageID=' + pageid;
    };
    function TackThisCourse(Course_ID) {
        const Toast = Swal.mixin({
            toast: true,

            position: 'top-center',
            showConfirmButton: true,
            timer: 9999
        });
                $.ajax(
                                    {
                        async: true,

                        type: 'POST',
                        data: { course_ID: Course_ID },
                        url: '@Url.Action("TackThisCurse", "Home")',
                        success: function (data) {
                                if (data.success == true) {
                                    window.location.href = '@Url.Action("CategoriesStd", "Students")';
                                } else {
                                    Toast.fire({
                                        icon: 'success',
                                        title: 'أنت بلغعل أخذت هذا الكورس',
                                        showClass: {
                                            popup: 'animate__animated animate__fadeInDown'
                                        },
                                        confirmButtonText: '!تمام',


                                    }).then(function () {
                                        window.location.href = '/Home/Login?Coursid=' + result.responseJSON.responsetext;
                                    });


                                }


                            },
                        error: function (result) {

                                //window.location.href = '/Home/Login?Coursid=' + result.responseJSON.responsetext;
                            },
                        complete: function (response) {
                                //alert("finish call jasion " + response);
                            }
                        });
    }

</script>


