}

@*<div class='top_baner' style="background-image:url(../Uploade/Images/@viewmodelHomepage.MainImage);">*@
<div class='top_baner' style="background-image: url(../Uploade/Images/image1.png);">
    <center>
        @* <span>@viewmodelHomepage.MainText</span>
            @*<p>هذا النص هو مثال لنص يمكن أن يستبدل في نفس المساحة</p>
                <a href="javascript:;">@Model.Title</a>*@
    </center>
</div>




<div class="grid_sec">

    <div class="container">

        <form class="form-inline" dir="rtl" method="get" action="MoreCourse">
            <input onkeyup="SerchOnClick(this.value)" onkeydown="return (event.keyCode!=13);" dir="rtl" class="form-control mr-sm-2" name="CourseName" value="@ViewData["CourseName"]" type="search" placeholder="بحث " aria-label="بحث">
            @*  <button dir="rtl" style="margin:5px" class="btn btn-outline-success my-2 my-sm-0" type="submit">بحث</button>*@
        </form>

        <div class="row" id="AllCouse">








        </div>
