<link href="~/Content/font-icon.css" rel="stylesheet" type="text/css" />
@{
    <!--  My Style  -->
    <link href="~/Content/css/style.css" rel="stylesheet" type="text/css" />
    if (Session["Direction_ID"] != null)
    {
        int value = int.Parse(Session["Direction_ID"].ToString());
        if (value == 0)
        {

            <link href="~/Content/css/style-en.css" rel="stylesheet" type="text/css" />
        }
    }
}
<link href="~/Content/RootStyle.css" rel="stylesheet" type="text/css" />
<div class='top_baner' style="background-image:url(../Uploade/Images/@Model.Image_Cover);">
    <center>
        @*<span>@Model.Title</span>*@

        @*<p>@Model.Title</p>*@
        @*<p>هذا النص هو مثال لنص يمكن أن يستبدل في نفس المساحة</p>
            <a href="javascript:;">@Model.Title</a>*@
    </center>
</div>
<style>
    body {
        background: #F5F5F7;
    }
</style>



<!-- Nav tabs -->
<div class="tabs_sec sec sidebar_type">
    <div class="container">
        <ul id="tabs" class="nav nav-tabs scrollbar" style="background-color: #113464" role="tablist">
            @for (int i = 0; i < Model.TabeContent.ToList().Count; i++)
            {
                if (i == 0)
                {
                    <li role="presentation"><a href="#tab_@Model.TabeContent.ToList()[i].ID" role="tab" data-toggle="tab" class="active"> @Model.TabeContent.ToList()[i].Tabe_title</a></li>

                }
                else
                {

                    <li role="presentation"><a href="#tab_@Model.TabeContent.ToList()[i].ID" role="tab" data-toggle="tab"> @Model.TabeContent.ToList()[i].Tabe_title</a></li>
                }
            }
            @*<li role="presentation"><a href="#tab1" role="tab" data-toggle="tab">بوابة الهيئة التدريسية </a></li>
                <li role="presentation"><a class="active" href="#tab2" role="tab" data-toggle="tab">بوابة الطلبة</a></li>
                <li role="presentation"><a href="#tab3" role="tab" data-toggle="tab">طلب الالتحاق</a></li>*@
        </ul>

        <div class="tab-content">
            @for (int i = 0; i < Model.TabeContent.ToList().Count; i++)
            {
                if (i == 0)
                {
                    <div role="tabpanel" class="tab-pane fade in active" id="tab_@Model.TabeContent.ToList()[i].ID">
                        @Html.Raw(Model.TabeContent.ToList()[i].Tab_Description)
                    </div>

                }
                else
                {
                    <div role="tabpanel" class="tab-pane fade" id="tab_@Model.TabeContent.ToList()[i].ID">
                        @Html.Raw(Model.TabeContent.ToList()[i].Tab_Description)
                    </div>
                }
            }
        </div>
    </div>
</div>
