@model tabseetCourse.Models_UI.GridPageModel

@{
    //ViewBag.Title = "GridPage";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class='top_baner' style="background-image: url(../Uploade/Images/373613211slider.jpg); background-size: cover">
    <center>
        @*  <span>@Model.Title</span>
            @*<p>هذا النص هو مثال لنص يمكن أن يستبدل في نفس المساحة</p>
                <a href="javascript:;">@Model.Title</a>*@
    </center>
</div>




<div class="grid_sec">

    <div class="container">
        @Html.AntiForgeryToken()
        @*@if (Model.ContentBtnReg == 1)
        {
            <div style="direction:rtl;text-align:center">
                <button class="btn btn-success" onclick="TackThisCourse(@Model.ID)" dir="rtl">تسجيل في الدبلوم</button>
            </div>
        }*@

        <div class="row">
            @if (Model.GirdContent != null)
            {


                foreach (var item in Model.GirdContent)
                {

                    <div class="col-md-4">
                        <div class="item">
                            <div class="image">
                                <a href="javascript:;" onclick="DivClicked(@item.GridPageID)">
                                    @if (item.Image == null)
                                    {
                                        <img src="https://cdn.europosters.eu/image/1300/zen-nature-i49609.jpg" alt="event name">
                                    }
                                    else
                                    {
                                        <img src="~/Uploade/Images/@item.Image" alt="event name">
                                    }


                                </a>
                            </div>
                            <h3>@item.Title</h3>
                            @if (item.PayValue > 0)
                            {
                                <span class="date">
                                    @item.PayValue USD
                                </span>

                            }
                            else
                            {
                                if (Session["Lang_ID"] != null && Session["Lang_ID"].ToString() == "2")
                                {
                                    <span class="date">
                                        Free
                                    </span>
                                }
                                else
                                {
                                    <span class="date">
                                        مجاني
                                    </span>
                                }

                            }
                            @if (item.Is_reg == 1)
                            {
                                if (Session["Lang_ID"] != null && Session["Lang_ID"].ToString() == "2")
                                {
                                    <button type="button" onclick="TackThisCourse(@item.ID)" class="read_more">@(item.PayValue > 0 ? "Request enrollment" : "Enroll for free")</button>
                                }
                                else
                                {
                                    <button type="button" onclick="TackThisCourse(@item.ID)" class="read_more">@(item.PayValue > 0 ? "طلب الاشتراك" : "اشترك مجانًا")</button>
                                }

                            }

                        </div>
                    </div>

                }
            }



            @*@Html.ActionLink("اقرأ المزيد", "GoPageMenu", new { PageID = item.DocLinke }, new { class = "nav-link" })*@


        </div>
    </div>


</div>

<script type="text/javascript" src="https://code.jquery.com/jquery-1.10.0.min.js"></script>
<script src="//cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>

    var isLoading = true;
                    function DivClicked(pageid) {
                        window.location.href = '/Home/GoPageMenu?PageID=' + pageid;
                    };

    // طلب الاشتراك في دورة (آلية موحدة): المجانية تُفعَّل فوراً، والمدفوعة تُسجَّل بانتظار موافقة الإدارة بلا أي دفع داخل الموقع.
    // الاستجابة من الخادم: { success, response, state, alreadyRegistered, requiresLogin, courseId }
    function TackThisCourse(Course_ID) {
        var tokenEl = document.querySelector('input[name="__RequestVerificationToken"]');
        var notify = function (icon, title, done) {
            if (window.Swal) {
                Swal.fire({ icon: icon, title: title, confirmButtonText: 'حسناً', confirmButtonColor: '#113464' }).then(function () { if (done) done(); });
            } else {
                alert(title);
                if (done) done();
            }
        };
        $.ajax({
            async: true,
            type: 'POST',
            data: { course_ID: Course_ID, __RequestVerificationToken: tokenEl ? tokenEl.value : '' },
            url: '@Url.Action("TackThisCurse", "Home")',
            success: function (data) {
                if (data && data.requiresLogin) {
                    window.location.href = '@Url.Action("LogIn", "Home")?Coursid=' + Course_ID;
                    return;
                }
                if (data && data.success) {
                    notify('success', data.response, function () { window.location.href = '@Url.Action("CategoriesStd", "Students")'; });
                } else if (data && data.alreadyRegistered) {
                    notify('info', data.response, function () { window.location.href = '@Url.Action("CategoriesStd", "Students")'; });
                } else {
                    notify('warning', (data && data.response) ? data.response : 'تعذر إتمام طلب الاشتراك.');
                }
            },
            error: function () {
                notify('error', 'حدث خطأ أثناء إرسال طلب الاشتراك، يرجى تحديث الصفحة والمحاولة مجدداً.');
            }
        });
    }
</script>

 

