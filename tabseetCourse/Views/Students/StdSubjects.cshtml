        font-size: 20px;
        margin: 12px 0;
        line-height: 1.5;
        font-weight: 700;
    }

    #studentSubjects .sub-modal-meta {
        display: grid;
        gap: 10px;
        padding: 16px;
        background: #F8FAFC;
        border-radius: 12px;
        color: #475569;
        font-size: 14px;
        margin-bottom: 20px;
    }

    #studentSubjects .sub-modal-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    #studentSubjects .sub-modal-actions a,
