@model IEnumerable<tabseetCourse.Models.StudentSubjectItemModel>
@using System.Globalization

@{
    ViewBag.Title = "المواد الدراسية - أكاديمية تبسيط الدولية";
    Layout = "~/Views/Shared/_LayoutStudent.cshtml";

    var courses = Model != null ? Model.ToList() : new List<tabseetCourse.Models.StudentSubjectItemModel>();
    int totalCourses = courses.Count;
    int totalLectures = courses.Sum(c => c.LectureCount);
}

@functions {
    public static bool IsSafeHttpsUrl(string url)
    {
        if (string.IsNullOrWhiteSpace(url)) return false;
        Uri uri;
        return Uri.TryCreate(url.Trim(), UriKind.Absolute, out uri)
            && uri != null
            && string.Equals(uri.Scheme, Uri.UriSchemeHttps, StringComparison.OrdinalIgnoreCase);
    }
}

<style>
