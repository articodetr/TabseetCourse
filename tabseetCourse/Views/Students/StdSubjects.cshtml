    /* النافذة المنبثقة للتفاصيل */
    #studentSubjects .sub-modal[hidden] {
        display: none !important;
    }

    #studentSubjects .sub-modal {
        position: fixed;
        inset: 0;
        z-index: 10050;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 16px;
        direction: rtl;
    }

    #studentSubjects .sub-modal-shade {
        position: absolute;
        inset: 0;
        background: rgba(10, 26, 48, 0.65);
    }

    #studentSubjects .sub-modal-panel {
