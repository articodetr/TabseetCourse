        float: left;
        width: 100%;
        min-height: 100vh;
        background-color: #F8FAFC;
        padding-top: 118px;
        padding-bottom: 64px;
        direction: rtl;
        text-align: right;
        font-family: 'Cairo', sans-serif;
        color: #1E293B;
        box-sizing: border-box;
    }

