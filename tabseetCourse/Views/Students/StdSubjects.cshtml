    @@media (max-width: 767px) {
        #studentSubjects {
            padding-top: 90px;
            padding-bottom: 40px;
        }

        #studentSubjects .sub-page-header {
            padding: 16px;
        }

        #studentSubjects .sub-page-title {
            font-size: 20px;
        }

        #studentSubjects .sub-courses-grid {
            grid-template-columns: 1fr;
        }

        #studentSubjects .sub-lec-row {
            flex-direction: column;
            align-items: flex-start;
        }

        #studentSubjects .sub-lec-actions {
            width: 100%;
        }

        #studentSubjects .sub-lec-actions a,
        #studentSubjects .sub-lec-actions button {
            flex: 1 1 calc(50% - 8px);
            justify-content: center;
        }
