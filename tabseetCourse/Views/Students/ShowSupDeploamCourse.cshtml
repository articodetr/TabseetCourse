<div class="modal fade" id="Exams_ID" dir="ltr" style="direction:rtl;text-align:right">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title"> معلومات الامتحان</h4>
                <button type="button" class="close" style="padding-right:70%" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>

            </div>
            <div class="modal-body">
                <table style="width:100%">
                    <tr>
                        <td>
                            <div class="row">
                                <div class="col-sm-12">
                                    <!-- select -->
                                    <div class="form-group">
                                        <label>اسم الامتحان</label><br />
                                        <P id="Exam_Name"></P>
                                    </div>
                                </div>
                            </div>
                        </td>
                        <td>
                            <div class="row">
                                <div class="col-sm-12">
                                    <!-- select -->
                                    <div class="form-group">
                                        <label style="color:darkred">مدة الامتحان </label><br />
                                        <P id="ExamDuration_ID"></P>

                                    </div>
                                </div>
                            </div>
                        </td>
                        <td>
                            <div class="row">
                                <div class="col-sm-12">
                                    <!-- select -->
                                    <div class="form-group">
                                        <label>درجة الامتحان</label><br />
                                        <p id="ExamsDegry_ID"></p>

                                    </div>
                                </div>
                            </div>
                        </td>
                        <td>
                            <div class="row">
                                <div class="col-sm-12">
                                    <!-- select -->
                                    <div class="form-group">
                                        <label style="color:darkred">الدرجة الواجبة للنجاح </label><br />
                                        <P id="ExamWinDegry_ID"></P>

                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="4">
                            <div class="row">
                                <div class="col-sm-12">
                                    <!-- select -->
                                    <div class="form-group">
                                        <label>ملاحظات</label><br />
                                        <p id="examDescription"></p>

                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                </table>
            </div>
            <div class="modal-footer justify-content-between">
                @*<button type="button" class="btn btn-default" data-dismiss="modal">الغاء</button>*@
                <button type="button" class="btn btn-primary" onclick="btnStartExam()">بدء</button>
            </div>
        </div>
        <!-- /.modal-content -->
    </div>
    <!-- /.modal-dialog -->
</div>
<!-- End Slider -->
<!-- Start Footer -->
<!-- End Footer -->

<input type="hidden" id="examID" />
<script>
    var isLoading = false;


    function getExam(examID, categoryID) {

        $.ajax({
            async: true,
            type: 'POST',
            data: { Exam_ID: examID, category_ID: categoryID },
            url: '@Url.Action("StdExams", "Students")',
            success: function (result) {
                if (result.CanStartExam == 1) {


                    $("#examID").val(result.ID);
                    $("#examDescription").html(result.Description);
                    var examDuration = (result.Duration * 60).toFixed(0);
                    $("#ExamDuration_ID").html(examDuration + " دقيقة");
                    $("#Exam_Name").html(result.Name);


                    $("#ExamsDegry_ID").html(result.Exam_Degry);
                    $("#ExamWinDegry_ID").html(result.Exam_win_Degry);
                    $("#Exams_ID").modal();
                } else {
                    const swalWithBootstrapButtons = Swal.mixin({
                        customClass: {
                            confirmButton: 'btn btn-success',

                        },
                    });

                    swalWithBootstrapButtons.fire({
                        title: 'تحذير؟',
                        text: "لا يمكن البدء بلامتحانات قبل الانتهاء من المحاضرات والوظائف ؟",
                        icon: 'warning',
                        confirmButtonText: 'حسنا',
                    })

                };

            },
            error: function (response) {
            },
            complete: function (response) {

            }
        });
    }
    function btnStartExam() {

        var id = $("#examID").val();

        window.location.href = "/Students/Exams?examID=" + id;
    }

</script>
<!--  End Content  -->
<!--  Start Footer  -->
<!--  End Footer  -->
