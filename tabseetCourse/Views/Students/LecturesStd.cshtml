            //            container: 'my-swal'
            //        }
            //    }
            //)
        }
    }

    function ViewMedialinkInModel() {
        var MediaLink = $("#MediaLink").val();
        if (MediaLink != 0 && MediaLink != "" && MediaLink != "0" && MediaLink != null) {
            window.open(MediaLink, '_blank');
        }
        else {

            //Swal.fire(
            //    'تنبيه!',
            //    'لا يوجد مرفقات.',
            //    'question',
            //    {
            //        customClass: {
            //            container: 'my-swal'
            //        }
            //    }
            //)
        }
    }

    //function ViewAssingmentInmodel() {

    //    var assingm_ID=  $("#assingm_ID").val();
    //    if (assingm_ID != 0 && assingm_ID != "" && assingm_ID != "0" && assingm_ID != null) {
    //        window.location.href = "/Students/AssignmentQuestion?A_Q=" + assingm_ID;
    //    }
    //    else {
    //        Swal.fire(
    //            'تنبيه!',
    //            'لا يوجد وظيفة.',
    //            'question'
    //        )
    //    }
    //}

    function ViewAssingment(assingm_ID) {

        if (assingm_ID != 0 && assingm_ID != "" && assingm_ID != "0" && assingm_ID != null) {
            window.location.href = "/Students/AssignmentQuestion?A_Q=" + assingm_ID;
        }
        else {
            Swal.fire(
                'تنبيه!',
                'لا يوجد وظيفة.',
                'question',

            )
        }
    }


    function assingLectureInfo(ID, LectureLink_Client, LectureAssingment, LectureMinTime, Others, DocumenFile, MediaLink,LectureName)
    {
        // YouTube: يُستخرج معرّف الفيديو ويُبنى رابط التضمين تلقائياً (مع رسالة واضحة وزر "مشاهدة على YouTube" عند تعذر التشغيل)؛
        // المصادر الأخرى (Google Drive, Vimeo ...) تُعرض داخل iframe كما كان سابقاً.
        var playerHost = document.getElementById("lecturePlayer");
        if (playerHost && window.TabseetYouTube) {
            TabseetYouTube.mount(playerHost, { url: LectureLink_Client, title: LectureName });
        }

        $("#assingm_ID").val(LectureAssingment);
        $("#Lecture_ID").val(ID);
        $("#Lecture_Title_ID").html(LectureName);
        $("#Description_ID").html('<p>'+Others+'</p>');

        $("#Lec_mini_Time").val(LectureMinTime);
        $("#DocumentFile").val(DocumenFile);
        $("#MediaLink").val(MediaLink);

        // احتساب الحضور بوقت التشغيل الفعلي (بدل المؤقّت القديم الذي كان يبدأ بمجرد فتح النافذة)
        lectureCompletedNow = false;
        renderAttendanceProgress(null);
        if (playerHost && window.TabseetAttendance) {
            TabseetAttendance.track(playerHost, { lectureId: ID, onStatus: onAttendanceStatus });
        }
    }

    var lectureCompletedNow = false;

    function renderAttendanceProgress(status) {
        var box = document.getElementById("attendanceProgress");
        if (!box) return;
        if (!status) {
            box.hidden = true;
            box.textContent = "";
            box.classList.remove("is-finished");
            return;
        }
        var fmt = window.TabseetAttendance ? TabseetAttendance.formatDuration : function (s) { return s; };
        box.hidden = false;
        if (status.isFinish) {
            box.classList.add("is-finished");
            box.textContent = "تم احتساب حضور هذه المحاضرة ✔";
        } else if (status.isTimeEnd && status.hasAssignment && !status.isAssignmentFinish) {
            box.classList.remove("is-finished");
            box.textContent = "اكتملت المشاهدة؛ يبقى اجتياز واجب المحاضرة لاحتسابها";
        } else {
            box.classList.remove("is-finished");
            box.textContent = "المشاهدة المحتسبة: " + fmt(status.watchedSeconds || 0) + " من " + fmt(status.requiredSeconds || 0) + " (" + (status.progressPercent || 0) + "%)";
        }
    }

    function onAttendanceStatus(status) {
        renderAttendanceProgress(status);
        if (status && status.isFinish && !lectureCompletedNow) {
            lectureCompletedNow = true;
            if (window.Swal) {
                Swal.fire({ toast: true, position: 'top', icon: 'success', title: 'تم احتساب حضور المحاضرة', showConfirmButton: false, timer: 3500 });
            }
        }
    }
</script>


