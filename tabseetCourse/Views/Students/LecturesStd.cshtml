<!-- Page specific script -->
<script>
    var isLoading = false;
    $(document).ready(function () {
        $(".menu_top").addClass("fixed");
        //var category_ID = $("#Category_ID").val();

        // فتح المحاضرة من بيانات الزر (data-*) بدلاً من تمرير النصوص داخل onclick
        $(document).on("click", ".js-open-lecture", function () {
            var d = this.dataset;
            assingLectureInfo(d.id, d.link, d.assign, d.min, d.others, d.doc, d.media, d.name);
        });

        // عند إغلاق نافذة المحاضرة: إرسال ما تبقى من وقت المشاهدة، ثم إيقاف التشغيل وإزالة المشغّل بصورة سليمة
        $("#courseModal").on("hidden.bs.modal", function () {
            if (window.TabseetAttendance) {
                TabseetAttendance.stop();
            }
            var playerHost = document.getElementById("lecturePlayer");
            if (playerHost && window.TabseetYouTube) {
                TabseetYouTube.destroy(playerHost);
            }
            renderAttendanceProgress(null);
            if (lectureCompletedNow) {
                // اكتملت المحاضرة الآن: إعادة التحميل لفتح المحاضرة التالية بالتسلسل
                lectureCompletedNow = false;
                window.location.reload();
            }
        });
    });

    function ViewDocumentInmodel() {
        var DocumentFile = $("#DocumentFile").val();
        if (DocumentFile != 0 && DocumentFile != "" && DocumentFile != "0" && DocumentFile != null) {
            window.open('https://tbsetaca.com/Uploade/Images/'+DocumentFile, '_blank');
        } else {

