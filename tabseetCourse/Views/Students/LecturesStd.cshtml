@model IEnumerable<tabseetCourse.Models.LectureModel>

@{
    ViewBag.Title = "LecturesStd";
    Layout = "~/Views/Shared/_LayoutStudent.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome-animation/0.3.0/font-awesome-animation.css" integrity="sha512-OodagY/LAbXf1TAkypAk+8OWjR+wGA8k3H7TGH+gku7+VsOmJRCQ2pTQJoTo/bATGwTOFdypCXqMV8snRZkC+w==" crossorigin="anonymous" />
<style>
    /* مشغّل المحاضرة المتجاوب داخل نافذة المحاضرة (الكمبيوتر والهاتف) */
    #courseModal .lecture-player-host {
        width: 100%;
    }

    /* شريط حالة الحضور تحت المشغّل */
    #courseModal .attendance-progress {
        margin-top: 10px;
        padding: 8px 12px;
        border-radius: 8px;
        background: rgba(255, 255, 255, 0.92);
        color: #113464;
        font-size: 14px;
        font-weight: 700;
        text-align: right;
        direction: rtl;
    }

    #courseModal .attendance-progress.is-finished {
        background: #DCFCE7;
        color: #166534;
    }

    @@media (max-width: 900px) {
        #courseModal .slider_sec {
            float: none;
            width: 100%;
        }

        #courseModal .text_sec {
            position: static;
            float: none;
            width: 100%;
            height: auto;
            margin-top: 15px;
        }
    }
</style>
<input type="text" value="@ViewBag.CategoryID" hidden="hidden" id="CategoryID" />
<input type="text" hidden="hidden" id="Lecture_ID" />
<input type="text" hidden="hidden" id="Lec_mini_Time" />
<input type="text" hidden="hidden" id="assingm_ID" />
<input type="text" hidden="hidden" id="DocumentFile" />
<input type="text" hidden="hidden" id="MediaLink" />

<!-- Start Slider -->
<!-- Start Slider -->
<div class="sec_content padding_menu cours_details">
    <div class="container">

        <div class="col-md-4 float-right">

            <div class="text_sec">
                <img class="cours_image" alt="course Name" src="~/Content2/img/pr-2.jpg">
                <h1>@ViewBag.LectureName</h1>

                <p>عدد المحاضرات</p>
                <span class="number">@Model.Count()</span>

                @if (ViewBag.BookDocument != null)
                {
                    <p>الكتاب</p>
                    <a class="btn" href="~/Uploade/Images/@ViewBag.BookDocument" target="_blank">

                        <span class='small'>
                            <svg version="1.1" id="Layer_1" x="0px" y="0px" viewBox="0 0 866.8 1024" style="enable-background:new 0 0 866.8 1024;" xml:space="preserve"><path d="M820.3,125c-21.9,0-29.2,7.3-29.2,29.2v730.9c0,36.5-29.2,65.8-65.8,65.8H155.2c-36.5,0-73.1-29.2-80.4-65.8V812c7.3-36.5,43.9-58.5,73.1-58.5h533.5c21.9,0,29.2-7.3,29.2-29.2V110.4C710.7,44.6,666.8,0.8,601,0.8H155.2C89.4-6.5,31,37.3,16.3,110.4v796.6C31,965.5,82.1,1016.7,140.6,1024H718c65.8,0,116.9-58.5,131.6-116.9V147C849.5,139.7,827.6,125,820.3,125L820.3,125z" /></svg>
                            <br>
                            الكتاب
                        </span>

                    </a>
                }

            </div>

        </div>
        <div class="col-md-8 float-left">
            <div class="text_sec content">
                <h2>المحتويات</h2>


                <ul class="content_list" id="LectureStd">

                    @{ bool lectureEnable = true;
                        int index = 0;
                        foreach (var item in Model)
                        {
                            index++;
                            if (item.Is_Std_Finish_Lecture == 1)
                            {
                                <li>
                                    <b class="">@index</b>
                                    <div style="overflow-wrap: break-word; direction: rtl; float: right; width: 40%; display:flex;text-align:right" dir="rtl">
                                        @item.Lecture_Name
                                    </div>
                                    <div style="width:50%">
                                        <div class="form-group">
                                            <label for="completed">المكتمل</label>
                                            <input type="checkbox" id="costs" checked="checked" disabled="disabled">
                                        </div>
                                        <div class="form-group">
                                            <label for="costs">التكاليف</label>

                                            <input type="checkbox" id="costs" checked="checked" disabled="disabled">
                                        </div>
                                        <div class="form-group">
                                            <label for="costs">تشغيل</label>

                                            <button type="button" class="btn btn-info js-open-lecture" data-toggle="modal" data-target="#courseModal" data-id="@item.ID" data-link="@item.LectureLink_Client" data-assign="@item.Assingn_ID" data-min="@item.LectureMinTime" data-others="@item.Others" data-doc="@item.DocumenFile" data-media="@item.MediaLink" data-name="@item.Lecture_Name">

                                                <i class="fas fa-play-circle"></i>


                                            </button>
                                        </div>
                                    </div>
                                </li>
                            }
                            else
                            {
                                if (item.Is_Std_Finish_Lecture == 0)
                                {
                                    if (lectureEnable == true)
                                    {
                                        lectureEnable = false;
                                        <li>
                                            <b class="">@index</b>
                                            <div style="overflow-wrap: break-word; direction: rtl; float: right; width: 40%; display:flex;text-align:right" dir="rtl">
                                                @item.Lecture_Name
                                            </div>
                                            <div style="width:50%">
                                                @if (item.DocumenFile != null)
                                                {
                                                    <div class="form-group">
                                                        <label for="completed">ملفات مساعدة</label>
                                                        <a href="#" class="btn btn-info"
                                                           onclick="window.open('https://tbsetaca.com/Uploade/Images/@item.DocumenFile', '_blank');">اضغط هنا</a>
                                                    </div>
                                                }



                                                <div class="form-group">
                                                    <label for="costs">التكاليف</label>

                                                    <button class="btn btn-info" onclick="ViewAssingment(@item.Assingn_ID)">

                                                        <i class="nav-icon fas fa-book">
                                                        </i>
                                                        الوظيفة
                                                    </button>

                                                </div>
                                                <div class="form-group">
                                                    <label for="costs">تشغيل</label>

                                                    <button type="button" class="btn btn-info js-open-lecture" data-toggle="modal" data-target="#courseModal" data-id="@item.ID" data-link="@item.LectureLink_Client" data-assign="@item.Assingn_ID" data-min="@item.LectureMinTime" data-others="@item.Others" data-doc="@item.DocumenFile" data-media="@item.MediaLink" data-name="@item.Lecture_Name">

                                                        <i class="fas fa-play-circle"></i>


                                                    </button>
                                                </div>
                                            </div>
                                        </li>
                                    }
                                    else
                                    {
                                        <li>
                                            <b class=""> @index</b>
                                            <div style="overflow-wrap: break-word; direction: rtl; float: right; width: 40%; display:flex;text-align:right" dir="rtl">
                                                @item.Lecture_Name
                                            </div>
                                            <div style="width:50%">
                                                <div class="form-group">
                                                    <label for="completed">المكتمل</label>
                                                    <input type="checkbox" id="costs" disabled>
                                                </div>
                                                <div class="form-group">
                                                    <label for="costs">التكاليف</label>

                                                    <input type="checkbox" id="costs" disabled="disabled">
                                                </div>
                                                <div class="form-group">
                                                    <label for="costs">تشغيل</label>

                                                    <button class="btn btn-info" disabled>

                                                        <i class="fas fa-play-circle"></i>


                                                    </button>
                                                </div>
                                            </div>
                                        </li>
                                    }
                                }
                            }
                        }
                    }
                </ul>
            </div>
        </div>
    </div>
</div>
<!-- End Slider -->
<!-- Cours Modal -->
<div class="modal fade" id="courseModal" tabindex="-1" role="dialog" aria-labelledby="courseModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-body">

                <div class="slider_sec">
                    @* مشغّل الفيديو المتجاوب (16:9): يُبنى عند فتح النافذة من LectureLink_Client عبر Scripts/tabseet-youtube.js ويُزال عند الإغلاق *@
                    <div id="lecturePlayer" class="lecture-player-host"></div>
                    <div id="attendanceProgress" class="attendance-progress" hidden></div>
                </div>

                <div class="text_sec">
                    <span class="title" id="Lecture_Title_ID">عنوان المحاضرة</span>
                    <div class="w_text" id="Description_ID">
                        <p>
                            شرح مختصر عن البرنامج التعليمي
                        </p>
                    </div>

                    <ul>
                        <li>
                            <a id="document_ID" href="#" onclick="ViewDocumentInmodel()">
                                <span class='small'>
                                    <svg version="1.1" id="Layer_1" x="0px" y="0px" viewBox="0 0 866.8 1024" style="enable-background:new 0 0 866.8 1024;" xml:space="preserve"><path d="M820.3,125c-21.9,0-29.2,7.3-29.2,29.2v730.9c0,36.5-29.2,65.8-65.8,65.8H155.2c-36.5,0-73.1-29.2-80.4-65.8V812c7.3-36.5,43.9-58.5,73.1-58.5h533.5c21.9,0,29.2-7.3,29.2-29.2V110.4C710.7,44.6,666.8,0.8,601,0.8H155.2C89.4-6.5,31,37.3,16.3,110.4v796.6C31,965.5,82.1,1016.7,140.6,1024H718c65.8,0,116.9-58.5,131.6-116.9V147C849.5,139.7,827.6,125,820.3,125L820.3,125z" /></svg>
                                    <br>
                                    <label id="tkalif_ID">المرفقات</label>
                                </span>

                            </a>
                            <a href="#" onclick="ViewMedialinkInModel()">
                                <span class="small">
                                    <svg version="1.1" id="Layer_1" x="0px" y="0px" viewBox="0 0 676 772" style="enable-background:new 0 0 676 772;" xml:space="preserve"><path d="M605.3,70.6c-94.2-94.2-247.6-94.2-341.7,0L2.6,331.4c-1.7,1.7-2.6,4-2.6,6.4s0.9,4.7,2.6,6.4l36.9,36.9c3.5,3.5,9.2,3.5,12.7,0l261-260.8c32.4-32.4,75.5-50.2,121.3-50.2s88.9,17.8,121.2,50.2c32.4,32.4,50.2,75.5,50.2,121.2c0,45.8-17.8,88.8-50.2,121.2l-266,265.9l-43.1,43.1c-40.3,40.3-105.8,40.3-146.1,0c-19.5-19.5-30.2-45.4-30.2-73s10.7-53.5,30.2-73l263.9-263.8c6.7-6.6,15.5-10.3,24.9-10.3h0.1c9.4,0,18.1,3.7,24.7,10.3c6.7,6.7,10.3,15.5,10.3,24.9c0,9.3-3.7,18.1-10.3,24.7L198.4,527c-1.7,1.7-2.6,4-2.6,6.4s0.9,4.7,2.6,6.4l36.9,36.9c3.5,3.5,9.2,3.5,12.7,0l215.6-215.6c19.9-19.9,30.8-46.3,30.8-74.4s-11-54.6-30.8-74.4c-41.1-41.1-107.9-41-149,0L289,238L50.8,476.1C18,509,0,552.5,0,598.8c0,46.3,18.1,89.8,50.8,122.5c33.9,33.8,78.3,50.7,122.7,50.7s88.8-16.9,122.6-50.7l309.2-309C650.8,366.8,676,306,676,241.5C676.1,176.9,650.9,116.2,605.3,70.6z" /></svg>
                                    <br>
                                    <label id="tkalif_ID">روابط اخرى</label>
                                </span>
                            </a>
                        </li>
                    </ul>

                </div>
            </div>

            <button type="button" class="btn btn-secondary close_modal" data-dismiss="modal">X</button>

        </div>
    </div>
</div>
@*////////////////////////*@

