                {
                    async: true,
                    type: 'POST',
                    data: { Lect_ID: lecture_ID },
                    url: '@Url.Action("LecutreTimeEnd", "Students")',
                    success: function (data) {
                        //window.location.reload();
                    },
                    error: function (response) {
                    },
                    complete: function (response) {
                        //alert("finish call jasion " + response);
                    }
                });
        }, minit);

    }
</script>


