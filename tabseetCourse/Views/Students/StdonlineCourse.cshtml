@model IEnumerable<tabseetCourse.Models.LectureModel>
@using System.Globalization

@{
    ViewBag.Title = "جدول حصصي - أكاديمية تبسيط الدولية";
    Layout = "~/Views/Shared/_LayoutStudent.cshtml";
}

@functions {
    public class TimetableLectureEntry
    {
        public int ID { get; set; }
        public int CategoryId { get; set; }
        public string LectureName { get; set; }
        public string CourseName { get; set; }
        public string RawDayAndTime { get; set; }
        public bool HasValidDate { get; set; }
        public DateTime StartDateTime { get; set; }
        public string DateKey { get; set; }
        public string TimeText { get; set; }
        public int Year { get; set; }
        public int Month { get; set; }
        public int Day { get; set; }
        public int Hour { get; set; }
        public int Minute { get; set; }
        public int DayColIndex { get; set; }
        public string DayNameAr { get; set; }
        public string StatusKey { get; set; }
        public string StatusLabel { get; set; }
        public bool IsValidHttpsLink { get; set; }
        public string SafeClientLink { get; set; }
        public bool HasDocument { get; set; }
        public string DocumentFileName { get; set; }
        public string SafeDocumentUrl { get; set; }
        public string ThemeClass { get; set; }
    }

    public static int GetArabicWeekDayIndex(DayOfWeek dow)
    {
        // السبت = 0, الأحد = 1, الاثنين = 2, الثلاثاء = 3, الأربعاء = 4, الخميس = 5, الجمعة = 6
        return ((int)dow + 1) % 7;
    }

    public static string GetArabicDayName(DayOfWeek dow)
    {
        switch (dow)
        {
            case DayOfWeek.Saturday: return "السبت";
            case DayOfWeek.Sunday: return "الأحد";
            case DayOfWeek.Monday: return "الاثنين";
            case DayOfWeek.Tuesday: return "الثلاثاء";
            case DayOfWeek.Wednesday: return "الأربعاء";
            case DayOfWeek.Thursday: return "الخميس";
            case DayOfWeek.Friday: return "الجمعة";
            default: return "";
        }
    }

    public static string GetArabicMonthName(int month)
    {
        string[] months = new string[]
        {
            "", "يناير", "فبراير", "مارس", "أبريل", "مايو", "يونيو",
            "يوليو", "أغسطس", "سبتمبر", "أكتوبر", "نوفمبر", "ديسمبر"
        };
        return (month >= 1 && month <= 12) ? months[month] : "";
    }

    public static string FormatArabicWeekRange(DateTime weekStart, DateTime weekEnd)
    {
        if (weekStart.Year == weekEnd.Year && weekStart.Month == weekEnd.Month)
        {
            return string.Format("{0} – {1} {2} {3}", weekStart.Day, weekEnd.Day, GetArabicMonthName(weekStart.Month), weekStart.Year);
        }
        if (weekStart.Year == weekEnd.Year)
        {
            return string.Format("{0} {1} – {2} {3} {4}", weekStart.Day, GetArabicMonthName(weekStart.Month), weekEnd.Day, GetArabicMonthName(weekEnd.Month), weekStart.Year);
        }
        return string.Format("{0} {1} {2} – {3} {4} {5}", weekStart.Day, GetArabicMonthName(weekStart.Month), weekStart.Year, weekEnd.Day, GetArabicMonthName(weekEnd.Month), weekEnd.Year);
    }

    public static string GetCourseThemeClass(int categoryId, int fallbackIndex)
    {
        string[] themes = new string[] { "tt-theme-blue", "tt-theme-gold", "tt-theme-green", "tt-theme-purple" };
        int idx = categoryId > 0 ? (categoryId - 1) % themes.Length : fallbackIndex % themes.Length;
        if (idx < 0) idx = 0;
        return themes[idx];
    }
}

@{
    var rawLectures = Model != null ? Model.ToList() : new List<tabseetCourse.Models.LectureModel>();
    DateTime now = DateTime.Now;
    DateTime todayDate = now.Date;
    string todayKey = todayDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);

    int offsetFromSat = GetArabicWeekDayIndex(todayDate.DayOfWeek);
    DateTime currentWeekStart = todayDate.AddDays(-offsetFromSat);
    DateTime currentWeekEnd = currentWeekStart.AddDays(6);

    string[] supportedFormats = new string[]
    {
        "yyyy-MM-dd HH:mm",
        "yyyy-MM-dd HH:mm:ss",
        "yyyy-MM-ddTHH:mm:ss",
        "yyyy-MM-ddTHH:mm",
        "yyyy-MM-dd",
        "MM/dd/yyyy HH:mm:ss",
        "MM/dd/yyyy HH:mm",
        "dd/MM/yyyy HH:mm:ss",
        "dd/MM/yyyy HH:mm"
    };

    var allEntries = new List<TimetableLectureEntry>();
    int itemCounter = 0;

    foreach (var item in rawLectures)
    {
        if (item == null) { continue; }
        itemCounter++;

        var entry = new TimetableLectureEntry();
        entry.ID = item.ID;
        entry.CategoryId = item.Category_ID;
        entry.LectureName = !string.IsNullOrWhiteSpace(item.Lecture_Name) ? item.Lecture_Name.Trim() : "محاضرة بدون عنوان";
        entry.CourseName = !string.IsNullOrWhiteSpace(item.CategoresName) ? item.CategoresName.Trim() : "دورة تعليمية";
        entry.RawDayAndTime = item.DayandTime != null ? item.DayandTime.Trim() : "";
        entry.ThemeClass = GetCourseThemeClass(item.Category_ID, itemCounter);

        // فحص رابط دخول المحاضرة بأمان (HTTPS فقط)
        Uri parsedClientUri = null;
        bool validHttps = !string.IsNullOrWhiteSpace(item.LectureLink_Client)
            && Uri.TryCreate(item.LectureLink_Client.Trim(), UriKind.Absolute, out parsedClientUri)
            && parsedClientUri != null
            && string.Equals(parsedClientUri.Scheme, Uri.UriSchemeHttps, StringComparison.OrdinalIgnoreCase);

        entry.IsValidHttpsLink = validHttps;
        entry.SafeClientLink = validHttps ? parsedClientUri.AbsoluteUri : "";

        // فحص المرفق التعليمي
        if (!string.IsNullOrWhiteSpace(item.DocumenFile))
        {
            string cleanDoc = item.DocumenFile.Trim();
            entry.HasDocument = true;
            entry.DocumentFileName = cleanDoc;
            entry.SafeDocumentUrl = "https://tbsetaca.com/Uploade/Images/" + Uri.EscapeUriString(cleanDoc);
        }
        else
        {
            entry.HasDocument = false;
            entry.DocumentFileName = "";
            entry.SafeDocumentUrl = "";
        }

        // تحليل التاريخ والوقت بشكل آمن دون تخمين أو تغيير المنطقة الزمنية
        DateTime parsedDt = DateTime.MinValue;
        bool isDateValid = false;

        if (!string.IsNullOrWhiteSpace(entry.RawDayAndTime) && entry.RawDayAndTime != "موعد غير محدد")
        {
            if (DateTime.TryParseExact(entry.RawDayAndTime, supportedFormats, CultureInfo.InvariantCulture, DateTimeStyles.None, out parsedDt))
            {
                if (parsedDt.Year >= 1900 && parsedDt.Year <= 2100)
                {
                    isDateValid = true;
                }
            }
        }

        if (isDateValid)
        {
            entry.HasValidDate = true;
            entry.StartDateTime = parsedDt;
            entry.Year = parsedDt.Year;
            entry.Month = parsedDt.Month;
            entry.Day = parsedDt.Day;
            entry.Hour = parsedDt.Hour;
            entry.Minute = parsedDt.Minute;
            entry.DateKey = parsedDt.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
            entry.TimeText = parsedDt.ToString("HH:mm", CultureInfo.InvariantCulture);
            entry.DayColIndex = GetArabicWeekDayIndex(parsedDt.DayOfWeek);
            entry.DayNameAr = GetArabicDayName(parsedDt.DayOfWeek);

            if (item.Is_Lecture_End)
            {
                entry.StatusKey = "past";
                entry.StatusLabel = "سابقة";
            }
            else if (parsedDt <= now)
            {
                entry.StatusKey = "ongoing";
                entry.StatusLabel = "جارية";
            }
            else
            {
                entry.StatusKey = "upcoming";
                entry.StatusLabel = "قادمة";
            }
        }
        else
        {
            entry.HasValidDate = false;
            entry.StartDateTime = DateTime.MinValue;
            entry.DateKey = "";
            entry.TimeText = "";
            entry.DayColIndex = -1;
            entry.DayNameAr = "";
            entry.StatusKey = "unscheduled";
            entry.StatusLabel = "موعد غير محدد";
        }

        allEntries.Add(entry);
    }

    // إحصائيات الملخص من بيانات Model الحالية فقط
    var currentWeekLectures = allEntries
        .Where(x => x.HasValidDate && x.StartDateTime.Date >= currentWeekStart && x.StartDateTime.Date <= currentWeekEnd)
        .OrderBy(x => x.StartDateTime)
        .ToList();

    var upcomingAndOngoingLectures = allEntries
        .Where(x => x.HasValidDate && (x.StatusKey == "upcoming" || x.StatusKey == "ongoing"))
        .OrderBy(x => x.StartDateTime)
        .ToList();

    // أقرب محاضرة مباشرة مستقبلية (أو جارية إن لم توجد مستقبلية بعدها)
    var nextLecture = allEntries
        .Where(x => x.HasValidDate && x.StatusKey == "upcoming")
        .OrderBy(x => x.StartDateTime)
        .FirstOrDefault()
        ?? upcomingAndOngoingLectures.FirstOrDefault();

    // حصص اليوم
    var todayLectures = allEntries
        .Where(x => x.HasValidDate && x.DateKey == todayKey)
        .OrderBy(x => x.StartDateTime)
        .ToList();

    // الحصص السابقة (جميع الحصص السابقة في بيانات الطالب مرتبة من الأحدث إلى الأقدم)
    var previousLectures = allEntries
        .Where(x => x.HasValidDate && x.StatusKey == "past")
        .OrderByDescending(x => x.StartDateTime)
        .ToList();

    // المحاضرات ذات الموعد غير المحدد
    var unscheduledLectures = allEntries
        .Where(x => !x.HasValidDate || x.StatusKey == "unscheduled")
        .ToList();

    // حساب نطاق الساعات للأسبوع الحالي (مع هامش قبل وبعد أول وآخر حصة)
    int weekMinHour = 9;
    int weekMaxHour = 17;
    if (currentWeekLectures.Any())
    {
        int minH = currentWeekLectures.Min(x => x.Hour);
        int maxH = currentWeekLectures.Max(x => x.Hour);
        weekMinHour = Math.Max(0, minH - 1);
        weekMaxHour = Math.Min(23, maxH + 1);
        if (weekMaxHour - weekMinHour < 5)
        {
            weekMinHour = Math.Max(0, weekMinHour - 1);
            weekMaxHour = Math.Min(23, Math.Max(weekMaxHour + 2, weekMinHour + 5));
        }
    }

    string[] arabicWeekDayNames = new string[] { "السبت", "الأحد", "الاثنين", "الثلاثاء", "الأربعاء", "الخميس", "الجمعة" };
}

<input type="text" value="@ViewBag.CategoryID" hidden="hidden" id="CategoryID" />
<input type="text" hidden="hidden" id="Lecture_ID" />
