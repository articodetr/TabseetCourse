</style>

<div id="studentTimetable" class="sec_content padding_menu" dir="rtl">
    <div class="tt-container">

        <!-- A. عنوان الصفحة والملخص -->
        <header class="tt-page-header">
            <div class="tt-header-info">
                <div class="tt-title-row">
                    <span class="tt-title-icon"><i class="fas fa-calendar-alt"></i></span>
                    <h1 class="tt-page-title">جدول حصصي</h1>
                </div>
                <p class="tt-page-subtitle">تابع مواعيد محاضراتك المباشرة والحصص القادمة والسابقة.</p>
            </div>

            <div class="tt-summary-stats">
                <div class="tt-stat-pill tt-stat-pill-navy">
                    <span class="tt-stat-icon"><i class="fas fa-calendar-week"></i></span>
                    <div class="tt-stat-content">
                        <span class="tt-stat-value" id="ttStatWeekCount">@currentWeekLectures.Count</span>
                        <span class="tt-stat-label">حصص هذا الأسبوع</span>
                    </div>
                </div>
                <div class="tt-stat-pill tt-stat-pill-gold">
                    <span class="tt-stat-icon"><i class="fas fa-video"></i></span>
                    <div class="tt-stat-content">
                        <span class="tt-stat-value" id="ttStatUpcomingCount">@upcomingAndOngoingLectures.Count</span>
                        <span class="tt-stat-label">الحصص القادمة</span>
                    </div>
                </div>
            </div>
        </header>

        @if (ViewBag.ErrorMessage != null)
        {
            <div class="tt-card" style="padding: 18px 22px; margin-bottom: 20px; border-right: 4px solid #EF4444; background: #FEF2F2; color: #991B1B; font-weight: 600;">
                <i class="fas fa-exclamation-circle"></i> @ViewBag.ErrorMessage
            </div>
        }

        <!-- منطقة العمل الرئيسية: اللوحة الجانبية يمينًا والجدول الأسبوعي والحصص السابقة يسارًا -->
        <div class="tt-workspace">

            <!-- 6. اللوحة الجانبية (على اليمين في سطح المكتب) -->
            <aside class="tt-sidebar" aria-label="اللوحة الجانبية للجدول">

                <!-- العنصر الأول: تقويم مصغر -->
                <div class="tt-card">
                    <div class="tt-widget-header">
                        <h2 class="tt-widget-title">
                            <i class="far fa-calendar"></i>
                            <span id="ttCalMonthYear">@GetArabicMonthName(todayDate.Month) @todayDate.Year</span>
                        </h2>
                        <div class="tt-cal-nav">
                            <button type="button" class="tt-cal-btn" id="ttBtnPrevMonth" title="الشهر السابق" aria-label="الشهر السابق">
                                <i class="fas fa-chevron-right"></i>
                            </button>
                            <button type="button" class="tt-cal-btn" id="ttBtnNextMonth" title="الشهر التالي" aria-label="الشهر التالي">
                                <i class="fas fa-chevron-left"></i>
                            </button>
                        </div>
                    </div>
                    <div class="tt-widget-body">
                        <div class="tt-cal-weekdays">
                            <span class="tt-cal-weekday" title="السبت">س</span>
                            <span class="tt-cal-weekday" title="الأحد">ح</span>
                            <span class="tt-cal-weekday" title="الاثنين">ن</span>
                            <span class="tt-cal-weekday" title="الثلاثاء">ث</span>
                            <span class="tt-cal-weekday" title="الأربعاء">ر</span>
                            <span class="tt-cal-weekday" title="الخميس">خ</span>
                            <span class="tt-cal-weekday" title="الجمعة">ج</span>
                        </div>
                        <div class="tt-cal-days" id="ttMiniCalGrid">
                            @{
                                DateTime firstOfMonth = new DateTime(todayDate.Year, todayDate.Month, 1);
                                int startOffset = GetArabicWeekDayIndex(firstOfMonth.DayOfWeek);
                                DateTime gridStart = firstOfMonth.AddDays(-startOffset);
                                var lectureDateSet = new HashSet<string>(allEntries.Where(e => e.HasValidDate).Select(e => e.DateKey));

                                for (int i = 0; i < 42; i++)
                                {
                                    DateTime cellDate = gridStart.AddDays(i);
                                    string cellKey = cellDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
                                    bool isOtherMonth = cellDate.Month != todayDate.Month;
                                    bool isCellToday = cellDate.Date == todayDate;
                                    bool hasLec = lectureDateSet.Contains(cellKey);
                                    bool inCurrWeek = cellDate.Date >= currentWeekStart && cellDate.Date <= currentWeekEnd;

                                    string classes = "tt-cal-day";
                                    if (isOtherMonth) { classes += " is-other-month"; }
                                    if (inCurrWeek) { classes += " is-in-week"; }
                                    if (hasLec) { classes += " has-lecture"; }
                                    if (isCellToday) { classes += " is-today"; }

                                    <button type="button" class="@classes" data-date="@cellKey" title="@cellKey">@cellDate.Day</button>
                                }
                            }
                        </div>
                        <div class="tt-cal-legend">
                            <span class="tt-legend-item">
                                <span class="tt-legend-dot" style="background: #113464;"></span> اليوم
                            </span>
                            <span class="tt-legend-item">
                                <span class="tt-legend-dot" style="background: #C5A052;"></span> يوم به محاضرة
                            </span>
                        </div>
                    </div>
                </div>

                <!-- العنصر الثاني: الحصة القادمة -->
                <div class="tt-card">
                    <div class="tt-widget-header">
                        <h2 class="tt-widget-title">
                            <i class="fas fa-bell"></i>
                            <span>الحصة القادمة</span>
                        </h2>
                    </div>
                    <div class="tt-widget-body" id="ttNextLectureWidget">
                        @if (nextLecture != null)
                        {
                            <div class="tt-side-lec-card @nextLecture.ThemeClass">
                                <div class="tt-card-top">
                                    <span class="tt-side-lec-course">@nextLecture.CourseName</span>
                                    <span class="tt-status-badge @(nextLecture.StatusKey == "ongoing" ? "tt-status-ongoing" : "tt-status-upcoming")">@nextLecture.StatusLabel</span>
                                </div>
                                <h3 class="tt-side-lec-title">@nextLecture.LectureName</h3>
                                <div class="tt-side-lec-meta">
                                    <span><i class="far fa-calendar-alt"></i> @nextLecture.DayNameAr، @nextLecture.DateKey</span>
                                    <span style="direction: ltr;"><i class="far fa-clock"></i> @nextLecture.TimeText</span>
                                </div>
                                <div class="tt-card-footer">
                                    @if (nextLecture.IsValidHttpsLink)
                                    {
                                        <a href="@nextLecture.SafeClientLink" target="_blank" rel="noopener noreferrer" class="tt-join-btn">
                                            <i class="fas fa-video"></i> دخول المحاضرة
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="tt-no-link">رابط المحاضرة غير متوفر</span>
                                    }

                                    @if (nextLecture.HasDocument)
                                    {
                                        <a href="@nextLecture.SafeDocumentUrl" target="_blank" rel="noopener noreferrer" class="tt-doc-link">
                                            <i class="fas fa-paperclip"></i> المرفق التعليمي
                                        </a>
                                    }
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="tt-side-empty">لا توجد حصص قادمة حاليًا.</div>
                        }
                    </div>
                </div>

                <!-- العنصر الثالث: حصص اليوم -->
                <div class="tt-card">
                    <div class="tt-widget-header">
                        <h2 class="tt-widget-title">
                            <i class="fas fa-chalkboard-teacher"></i>
                            <span>حصص اليوم</span>
                        </h2>
                        <span style="font-size: 12px; color: #64748B; font-weight: 600;">@GetArabicDayName(todayDate.DayOfWeek)</span>
                    </div>
                    <div class="tt-widget-body" id="ttTodayLecturesWidget">
                        @if (todayLectures.Any())
                        {
                            foreach (var tLec in todayLectures)
                            {
                                string badgeCls = tLec.StatusKey == "past" ? "tt-status-past" : (tLec.StatusKey == "ongoing" ? "tt-status-ongoing" : "tt-status-upcoming");
                                <div class="tt-side-lec-card @tLec.ThemeClass">
                                    <div class="tt-card-top">
                                        <span class="tt-side-lec-course">@tLec.CourseName</span>
                                        <span class="tt-status-badge @badgeCls">@tLec.StatusLabel</span>
                                    </div>
                                    <h3 class="tt-side-lec-title">@tLec.LectureName</h3>
                                    <div class="tt-side-lec-meta">
                                        <span style="direction: ltr;"><i class="far fa-clock"></i> @tLec.TimeText</span>
                                    </div>
                                    <div class="tt-card-footer">
                                        @if (tLec.IsValidHttpsLink)
                                        {
                                            <a href="@tLec.SafeClientLink" target="_blank" rel="noopener noreferrer" class="tt-join-btn">
                                                <i class="fas fa-video"></i> دخول المحاضرة
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="tt-no-link">رابط المحاضرة غير متوفر</span>
                                        }

                                        @if (tLec.HasDocument)
                                        {
                                            <a href="@tLec.SafeDocumentUrl" target="_blank" rel="noopener noreferrer" class="tt-doc-link">
                                                <i class="fas fa-paperclip"></i> المرفق التعليمي
                                            </a>
                                        }
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="tt-side-empty">لا توجد حصص مجدولة اليوم.</div>
                        }
                    </div>
                </div>

            </aside>

            <!-- المنطقة الرئيسية: الجدول الأسبوعي + الحصص السابقة -->
            <main class="tt-main-area">

                <!-- B & C. بطاقة الجدول الأسبوعي والتنقل بين الأسابيع -->
                <section class="tt-card" aria-label="الجدول الأسبوعي">
                    <div class="tt-week-toolbar">
                        <div class="tt-week-range-box">
                            <span class="tt-week-badge-icon"><i class="fas fa-calendar-week"></i></span>
                            <div>
                                <span class="tt-week-range-label">النطاق الأسبوعي المعروض</span>
                                <h2 class="tt-week-range-text" id="ttWeekRangeDisplay">@FormatArabicWeekRange(currentWeekStart, currentWeekEnd)</h2>
                            </div>
                        </div>

                        <div class="tt-week-controls">
                            <button type="button" class="tt-nav-btn" id="ttBtnPrevWeek">
                                <i class="fas fa-chevron-right"></i> الأسبوع السابق
                            </button>
                            <button type="button" class="tt-nav-btn tt-nav-btn-current" id="ttBtnCurrentWeek">
                                العودة إلى الأسبوع الحالي
                            </button>
                            <button type="button" class="tt-nav-btn" id="ttBtnNextWeek">
                                الأسبوع التالي <i class="fas fa-chevron-left"></i>
                            </button>
                        </div>
                    </div>

                    <!-- رسالة الأسبوع الفارغ -->
                    <div class="tt-week-empty-banner" id="ttWeekEmptyBanner" style="@(currentWeekLectures.Any() ? "display:none;" : "")">
                        <div class="tt-week-empty-icon"><i class="far fa-calendar-times"></i></div>
                        <p class="tt-week-empty-text">لا توجد حصص مجدولة خلال هذا الأسبوع.</p>
                        <p class="tt-week-empty-sub">يمكنك التنقل بين الأسابيع أو مراجعة قسم الحصص السابقة أدناه.</p>
                    </div>

                    <!-- الجدول الأسبوعي لسطح المكتب والأجهزة اللوحية -->
                    <div class="tt-desktop-timetable" id="ttDesktopTimetableContainer">
                        <table class="tt-grid-table" aria-label="شبكة الجدول الأسبوعي">
                            <thead>
                                <tr id="ttDesktopHeaderRow">
                                    <th class="tt-time-col-header" scope="col" title="الساعة">
                                        <i class="far fa-clock"></i>
                                    </th>
                                    @for (int d = 0; d < 7; d++)
                                    {
                                        DateTime colDate = currentWeekStart.AddDays(d);
                                        string colKey = colDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
                                        bool isColToday = colDate.Date == todayDate;
                                        <th class="tt-day-col-header @(isColToday ? "is-today" : "")" scope="col" data-date="@colKey" data-day-index="@d">
                                            <span class="tt-day-header-name">@arabicWeekDayNames[d]</span>
                                            <span class="tt-day-header-num">@colDate.Day</span>
                                        </th>
                                    }
                                </tr>
                            </thead>
                            <tbody id="ttDesktopGridBody">
                                @for (int hr = weekMinHour; hr <= weekMaxHour; hr++)
                                {
                                    string hourLabel = string.Format(CultureInfo.InvariantCulture, "{0:00}:00", hr);
                                    <tr>
                                        <td class="tt-time-cell">@hourLabel</td>
                                        @for (int d = 0; d < 7; d++)
                                        {
                                            DateTime slotDate = currentWeekStart.AddDays(d);
                                            bool isTodayCol = slotDate.Date == todayDate;
                                            var slotLectures = currentWeekLectures.Where(x => x.DayColIndex == d && x.Hour == hr).ToList();
                                            <td class="tt-slot-cell @(isTodayCol ? "is-today-col" : "")" data-day-index="@d" data-hour="@hr">
                                                @if (slotLectures.Any())
                                                {
                                                    <div class="tt-slot-stack">
                                                        @foreach (var sLec in slotLectures)
                                                        {
                                                            string statusCls = sLec.StatusKey == "past" ? "tt-status-past" : (sLec.StatusKey == "ongoing" ? "tt-status-ongoing" : "tt-status-upcoming");
                                                            <article class="tt-lecture-card @sLec.ThemeClass" data-lecture-id="@sLec.ID">
                                                                <div class="tt-card-top">
                                                                    <span class="tt-card-time"><i class="far fa-clock"></i> @sLec.TimeText</span>
                                                                    <span class="tt-status-badge @statusCls">@sLec.StatusLabel</span>
                                                                </div>
                                                                <div class="tt-card-course">@sLec.CourseName</div>
                                                                <h3 class="tt-card-title" title="@sLec.LectureName">@sLec.LectureName</h3>
                                                                <div class="tt-card-footer">
                                                                    @if (sLec.IsValidHttpsLink)
                                                                    {
                                                                        <a href="@sLec.SafeClientLink" target="_blank" rel="noopener noreferrer" class="tt-join-btn">
                                                                            <i class="fas fa-video"></i> دخول المحاضرة
                                                                        </a>
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="tt-no-link">رابط المحاضرة غير متوفر</span>
                                                                    }

                                                                    @if (sLec.HasDocument)
                                                                    {
                                                                        <a href="@sLec.SafeDocumentUrl" target="_blank" rel="noopener noreferrer" class="tt-doc-link" title="المرفق التعليمي">
                                                                            <i class="fas fa-paperclip"></i> المرفق
                                                                        </a>
                                                                    }
                                                                </div>
                                                            </article>
                                                        }
                                                    </div>
                                                }
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- العرض المخصص للهاتف المحمول -->
                    <div class="tt-mobile-timetable" id="ttMobileTimetableContainer">
                        <div class="tt-mobile-days-bar" id="ttMobileDaysBar">
                            <button type="button" class="tt-mobile-day-pill is-active" data-day-filter="all">
                                <span>كل الأسبوع</span>
                                <small>(@currentWeekLectures.Count)</small>
                            </button>
                            @for (int d = 0; d < 7; d++)
                            {
                                DateTime mDate = currentWeekStart.AddDays(d);
                                bool hasDayLec = currentWeekLectures.Any(x => x.DayColIndex == d);
                                <button type="button" class="tt-mobile-day-pill @(hasDayLec ? "has-lec" : "")" data-day-filter="@d">
                                    <span>@arabicWeekDayNames[d]</span>
                                    <small>@mDate.Day</small>
                                </button>
                            }
                        </div>

                        <div class="tt-mobile-cards-list" id="ttMobileCardsList">
                            @if (currentWeekLectures.Any())
                            {
                                foreach (var mLec in currentWeekLectures)
                                {
                                    string mStatusCls = mLec.StatusKey == "past" ? "tt-status-past" : (mLec.StatusKey == "ongoing" ? "tt-status-ongoing" : "tt-status-upcoming");
                                    <article class="tt-mobile-lec-card @mLec.ThemeClass" data-day-index="@mLec.DayColIndex">
                                        <div class="tt-card-top">
                                            <span class="tt-card-course">@mLec.CourseName</span>
                                            <span class="tt-status-badge @mStatusCls">@mLec.StatusLabel</span>
                                        </div>
                                        <h3 class="tt-side-lec-title">@mLec.LectureName</h3>
                                        <div class="tt-side-lec-meta">
                                            <span><i class="far fa-calendar"></i> @mLec.DayNameAr، @mLec.DateKey</span>
                                            <span style="direction: ltr;"><i class="far fa-clock"></i> @mLec.TimeText</span>
                                        </div>
                                        <div class="tt-card-footer">
                                            @if (mLec.IsValidHttpsLink)
                                            {
                                                <a href="@mLec.SafeClientLink" target="_blank" rel="noopener noreferrer" class="tt-join-btn">
                                                    <i class="fas fa-video"></i> دخول المحاضرة
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="tt-no-link">رابط المحاضرة غير متوفر</span>
                                            }

                                            @if (mLec.HasDocument)
                                            {
                                                <a href="@mLec.SafeDocumentUrl" target="_blank" rel="noopener noreferrer" class="tt-doc-link">
                                                    <i class="fas fa-paperclip"></i> المرفق التعليمي
                                                </a>
                                            }
                                        </div>
                                    </article>
                                }
                            }
                        </div>
                    </div>
                </section>

                <!-- قسم المحاضرات ذات الموعد غير المحدد (يظهر عند وجود محاضرة بدون تاريخ صالح) -->
                <section class="tt-card" id="ttUnscheduledSection" aria-label="محاضرات بموعد غير محدد" style="@(unscheduledLectures.Any() ? "" : "display:none;")">
                    <div class="tt-section-header">
                        <div class="tt-section-title-group">
                            <h2 class="tt-section-title">
                                <i class="fas fa-clock" style="color: #D97706;"></i>
                                <span>موعد غير محدد</span>
                            </h2>
                            <p class="tt-section-subtitle">محاضرات مسجلة لم يتم تحديد تاريخ أو وقت بدايتها بعد.</p>
                        </div>
                        <span class="tt-count-badge" id="ttUnscheduledCountBadge">@unscheduledLectures.Count</span>
                    </div>
                    <div class="tt-prev-list" id="ttUnscheduledList">
                        @foreach (var uLec in unscheduledLectures)
                        {
                            <article class="tt-prev-row" style="border-right-color: #F59E0B;" data-lecture-id="@uLec.ID">
                                <div class="tt-prev-main">
                                    <span class="tt-prev-course">@uLec.CourseName</span>
                                    <h3 class="tt-prev-title">@uLec.LectureName</h3>
                                    <div class="tt-prev-meta">
                                        <span class="tt-status-badge tt-status-unscheduled">موعد غير محدد</span>
                                    </div>
                                </div>
                                <div class="tt-prev-actions">
                                    @if (uLec.HasDocument)
                                    {
                                        <a href="@uLec.SafeDocumentUrl" target="_blank" rel="noopener noreferrer" class="tt-doc-link">
                                            <i class="fas fa-file-alt"></i> المرفق التعليمي
                                        </a>
                                    }
                                    @if (uLec.IsValidHttpsLink)
                                    {
                                        <a href="@uLec.SafeClientLink" target="_blank" rel="noopener noreferrer" class="tt-join-btn">
                                            <i class="fas fa-video"></i> دخول المحاضرة
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="tt-no-link">رابط المحاضرة غير متوفر</span>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                </section>

                <!-- 7. قسم الحصص السابقة -->
                <section class="tt-card" id="ttPreviousLecturesSection" aria-label="الحصص السابقة">
                    <div class="tt-section-header">
                        <div class="tt-section-title-group">
                            <h2 class="tt-section-title">
                                <i class="fas fa-history" style="color: #C5A052;"></i>
                                <span>الحصص السابقة</span>
                            </h2>
                            <p class="tt-section-subtitle">جميع المحاضرات المباشرة السابقة في دوراتك مرتبة من الأحدث إلى الأقدم.</p>
                        </div>
                        <span class="tt-count-badge">@previousLectures.Count حصة</span>
                    </div>

                    @if (previousLectures.Any())
                    {
                        int prevInitialLimit = 6;
                        int prevIdx = 0;
                        <div class="tt-prev-list" id="ttPreviousLecturesList">
                            @foreach (var pLec in previousLectures)
                            {
                                prevIdx++;
                                bool isExtra = prevIdx > prevInitialLimit;
                                <article class="tt-prev-row @(isExtra ? "tt-prev-hidden" : "")" data-prev-extra="@(isExtra ? "1" : "0")" data-lecture-id="@pLec.ID">
                                    <div class="tt-prev-main">
                                        <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                                            <span class="tt-prev-course">@pLec.CourseName</span>
                                            <span class="tt-status-badge tt-status-past">سابقة</span>
                                        </div>
                                        <h3 class="tt-prev-title">@pLec.LectureName</h3>
                                        <div class="tt-prev-meta">
                                            <span class="tt-prev-meta-item">
                                                <i class="far fa-calendar-check"></i>
                                                <span>التاريخ: @pLec.DayNameAr، @pLec.DateKey</span>
                                            </span>
                                            <span class="tt-prev-meta-item">
                                                <i class="far fa-clock"></i>
                                                <span>الساعة: <strong style="direction: ltr; display: inline-block;">@pLec.TimeText</strong></span>
                                            </span>
                                        </div>
                                    </div>

                                    <div class="tt-prev-actions">
                                        @if (pLec.HasDocument)
                                        {
                                            <a href="@pLec.SafeDocumentUrl" target="_blank" rel="noopener noreferrer" class="tt-doc-link">
                                                <i class="fas fa-file-download"></i> الملف المساعد (@pLec.DocumentFileName)
                                            </a>
                                        }

                                        @if (pLec.IsValidHttpsLink)
                                        {
                                            <a href="@pLec.SafeClientLink" target="_blank" rel="noopener noreferrer" class="tt-join-btn tt-join-btn-outline" title="فتح رابط الاجتماع المحفوظ">
                                                <i class="fas fa-external-link-alt"></i> فتح الرابط
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="tt-no-link">رابط المحاضرة غير متوفر</span>
                                        }
                                    </div>
                                </article>
                            }
                        </div>

                        if (previousLectures.Count > prevInitialLimit)
                        {
                            int remainingCount = previousLectures.Count - prevInitialLimit;
                            <div class="tt-show-more-wrap">
                                <button type="button" class="tt-show-more-btn" id="ttBtnTogglePrev" data-expanded="0" data-more-count="@remainingCount">
                                    <span>عرض المزيد من الحصص السابقة (@remainingCount)</span>
                                    <i class="fas fa-chevron-down"></i>
                                </button>
                            </div>
                        }
                    }
                    else
                    {
                        <div style="padding: 28px 22px; text-align: center; color: #64748B; font-weight: 600;">
                            لا توجد حصص سابقة مسجلة حتى الآن.
                        </div>
                    }
                </section>

            </main>
        </div>

        <!-- مخزن بيانات آمن للقراءة من JavaScript دون أي طلبات خادم إضافية -->
        <div id="ttLecturesDataset" style="display:none;" aria-hidden="true" data-today="@todayKey">
            @foreach (var entry in allEntries)
            {
                <div class="tt-data-row"
                     data-id="@entry.ID"
                     data-category-id="@entry.CategoryId"
                     data-name="@entry.LectureName"
                     data-course="@entry.CourseName"
                     data-raw-datetime="@entry.RawDayAndTime"
                     data-valid-date="@(entry.HasValidDate ? "1" : "0")"
                     data-date-key="@entry.DateKey"
                     data-time-text="@entry.TimeText"
                     data-year="@entry.Year"
                     data-month="@entry.Month"
                     data-day="@entry.Day"
                     data-hour="@entry.Hour"
                     data-minute="@entry.Minute"
                     data-day-col="@entry.DayColIndex"
                     data-day-name="@entry.DayNameAr"
                     data-status-key="@entry.StatusKey"
                     data-status-label="@entry.StatusLabel"
                     data-valid-link="@(entry.IsValidHttpsLink ? "1" : "0")"
                     data-link="@entry.SafeClientLink"
                     data-has-doc="@(entry.HasDocument ? "1" : "0")"
                     data-doc-name="@entry.DocumentFileName"
                     data-doc-url="@entry.SafeDocumentUrl"
                     data-theme="@entry.ThemeClass"></div>
            }
        </div>

    </div>
</div>

<script>
    var isLoading = false;
    $(document).ready(function () {
        $(".menu_top").addClass("fixed");
    });

    function assingLectureInfo(ID, LectureLink_Client, LectureAssingment, LectureMinTime, Others, DocumenFile, MediaLink) {
        $("#Video_ID").attr("src", LectureLink_Client);
        $("#assingm_ID").val(LectureAssingment);
        $("#Lecture_ID").val(ID);
        $("#Lec_mini_Time").val(LectureMinTime);
        if (typeof btnStartLecture === "function") {
            btnStartLecture();
        }
    }

    (function () {
        "use strict";

        var ARABIC_DAYS = ["السبت", "الأحد", "الاثنين", "الثلاثاء", "الأربعاء", "الخميس", "الجمعة"];
        var ARABIC_MONTHS = ["", "يناير", "فبراير", "مارس", "أبريل", "مايو", "يونيو", "يوليو", "أغسطس", "سبتمبر", "أكتوبر", "نوفمبر", "ديسمبر"];

        function pad2(n) {
            return n < 10 ? "0" + n : "" + n;
        }

        function formatDateKey(dateObj) {
            return dateObj.getFullYear() + "-" + pad2(dateObj.getMonth() + 1) + "-" + pad2(dateObj.getDate());
        }

        function getArabicDayIndexFromJsDay(jsDay) {
            // JS: 0=Sun, 1=Mon, ..., 6=Sat -> Arabic week: 0=Sat, 1=Sun, ..., 6=Fri
            return (jsDay + 1) % 7;
        }

        function getWeekStartSaturday(dateObj) {
            var d = new Date(dateObj.getFullYear(), dateObj.getMonth(), dateObj.getDate(), 0, 0, 0, 0);
            var offset = getArabicDayIndexFromJsDay(d.getDay());
            d.setDate(d.getDate() - offset);
            return d;
        }

        function addDays(dateObj, days) {
            return new Date(dateObj.getFullYear(), dateObj.getMonth(), dateObj.getDate() + days, 0, 0, 0, 0);
        }

        function formatArabicWeekRange(startObj, endObj) {
            var sY = startObj.getFullYear(), sM = startObj.getMonth() + 1, sD = startObj.getDate();
            var eY = endObj.getFullYear(), eM = endObj.getMonth() + 1, eD = endObj.getDate();
            if (sY === eY && sM === eM) {
                return sD + " – " + eD + " " + ARABIC_MONTHS[sM] + " " + sY;
            }
            if (sY === eY) {
                return sD + " " + ARABIC_MONTHS[sM] + " – " + eD + " " + ARABIC_MONTHS[eM] + " " + sY;
            }
            return sD + " " + ARABIC_MONTHS[sM] + " " + sY + " – " + eD + " " + ARABIC_MONTHS[eM] + " " + eY;
        }

        function isSafeHttpsUrl(urlStr) {
            if (!urlStr || typeof urlStr !== "string") return false;
            var trimmed = urlStr.trim();
            if (!/^https:\/\/[^\s/$.?#].[^\s]*$/i.test(trimmed)) return false;
            try {
                var u = new URL(trimmed);
                return u.protocol === "https:";
            } catch (e) {
                return /^https:\/\//i.test(trimmed);
            }
        }

        function parseStrictDateKey(dateKeyStr) {
            if (!dateKeyStr || typeof dateKeyStr !== "string") return null;
            var m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(dateKeyStr.trim());
            if (!m) return null;
            var y = parseInt(m[1], 10);
            var mo = parseInt(m[2], 10);
            var d = parseInt(m[3], 10);
            if (y < 1900 || y > 2100 || mo < 1 || mo > 12 || d < 1 || d > 31) return null;
            var dt = new Date(y, mo - 1, d, 0, 0, 0, 0);
            if (dt.getFullYear() !== y || (dt.getMonth() + 1) !== mo || dt.getDate() !== d) return null;
            return dt;
        }

        function parseLectureDateTimeStrict(rawStr) {
            if (!rawStr || typeof rawStr !== "string") return null;
            var trimmed = rawStr.trim();
            if (!trimmed || trimmed === "موعد غير محدد") return null;

            var m = /^(\d{4})-(\d{2})-(\d{2})(?:[T\s](\d{2}):(\d{2})(?::(\d{2}))?)?$/.exec(trimmed);
            if (!m) return null;

            var y = parseInt(m[1], 10);
            var mo = parseInt(m[2], 10);
            var d = parseInt(m[3], 10);
            var hr = m[4] !== undefined ? parseInt(m[4], 10) : 0;
            var mi = m[5] !== undefined ? parseInt(m[5], 10) : 0;
            var sc = m[6] !== undefined ? parseInt(m[6], 10) : 0;

            if (y < 1900 || y > 2100 || mo < 1 || mo > 12 || d < 1 || d > 31) return null;
            if (hr < 0 || hr > 23 || mi < 0 || mi > 59 || sc < 0 || sc > 59) return null;

            var dt = new Date(y, mo - 1, d, hr, mi, 0, 0);
            if (dt.getFullYear() !== y || (dt.getMonth() + 1) !== mo || dt.getDate() !== d) return null;

            var dayCol = getArabicDayIndexFromJsDay(dt.getDay());
            return {
                dateObj: dt,
                year: y,
                month: mo,
                day: d,
                hour: hr,
                minute: mi,
                dateKey: y + "-" + pad2(mo) + "-" + pad2(d),
                timeText: pad2(hr) + ":" + pad2(mi),
                dayCol: dayCol,
                dayName: ARABIC_DAYS[dayCol]
            };
        }

        function initStudentTimetable() {
            var root = document.getElementById("studentTimetable");
            var datasetEl = document.getElementById("ttLecturesDataset");
            if (!root || !datasetEl) return;

            var serverTodayStr = datasetEl.getAttribute("data-today") || "";
            var todayDate = parseStrictDateKey(serverTodayStr) || new Date(new Date().getFullYear(), new Date().getMonth(), new Date().getDate(), 0, 0, 0, 0);
            var todayKey = formatDateKey(todayDate);
            var currentWeekStart = getWeekStartSaturday(todayDate);

            var dataNodes = datasetEl.querySelectorAll(".tt-data-row");
            var lectures = [];
            var lectureDateSet = {};

            for (var i = 0; i < dataNodes.length; i++) {
                var node = dataNodes[i];
                var rawDt = node.getAttribute("data-raw-datetime") || "";
                var parsed = parseLectureDateTimeStrict(rawDt);
                var serverValid = node.getAttribute("data-valid-date") === "1";

                var isDateValid = false;
                var dateObj = null;
                var dateKey = "";
                var timeText = "";
                var hour = 0;
                var minute = 0;
                var dayCol = -1;
                var dayName = "";

                if (parsed) {
                    isDateValid = true;
                    dateObj = parsed.dateObj;
                    dateKey = parsed.dateKey;
                    timeText = parsed.timeText;
                    hour = parsed.hour;
                    minute = parsed.minute;
                    dayCol = parsed.dayCol;
                    dayName = parsed.dayName;
                    lectureDateSet[dateKey] = true;
                } else if (serverValid) {
                    var sYear = parseInt(node.getAttribute("data-year") || "0", 10);
                    var sMonth = parseInt(node.getAttribute("data-month") || "0", 10);
                    var sDay = parseInt(node.getAttribute("data-day") || "0", 10);
                    var sHour = parseInt(node.getAttribute("data-hour") || "0", 10);
                    var sMin = parseInt(node.getAttribute("data-minute") || "0", 10);
                    var candidate = new Date(sYear, sMonth - 1, sDay, sHour, sMin, 0, 0);
                    if (sYear >= 1900 && sYear <= 2100 && candidate.getFullYear() === sYear && (candidate.getMonth() + 1) === sMonth && candidate.getDate() === sDay && sHour >= 0 && sHour <= 23 && sMin >= 0 && sMin <= 59) {
                        isDateValid = true;
                        dateObj = candidate;
                        dateKey = node.getAttribute("data-date-key") || formatDateKey(candidate);
                        timeText = node.getAttribute("data-time-text") || (pad2(sHour) + ":" + pad2(sMin));
                        hour = sHour;
                        minute = sMin;
                        dayCol = getArabicDayIndexFromJsDay(candidate.getDay());
                        dayName = ARABIC_DAYS[dayCol];
                        lectureDateSet[dateKey] = true;
                    }
                }

                var rawLink = node.getAttribute("data-link") || "";
                var validLink = node.getAttribute("data-valid-link") === "1" && isSafeHttpsUrl(rawLink);

                lectures.push({
                    id: node.getAttribute("data-id") || "",
                    name: node.getAttribute("data-name") || "",
                    course: node.getAttribute("data-course") || "",
                    validDate: isDateValid,
                    dateObj: dateObj,
                    dateKey: dateKey,
                    timeText: timeText,
                    hour: hour,
                    minute: minute,
                    dayCol: dayCol,
                    dayName: dayName,
                    statusKey: isDateValid ? (node.getAttribute("data-status-key") || "upcoming") : "unscheduled",
                    statusLabel: isDateValid ? (node.getAttribute("data-status-label") || "قادمة") : "موعد غير محدد",
                    validLink: validLink,
                    link: validLink ? rawLink : "",
                    hasDoc: node.getAttribute("data-has-doc") === "1",
                    docName: node.getAttribute("data-doc-name") || "",
                    docUrl: node.getAttribute("data-doc-url") || "",
                    theme: node.getAttribute("data-theme") || "tt-theme-blue"
                });
            }

            var state = {
                activeWeekStart: new Date(currentWeekStart.getTime()),
                selectedDateKey: null,
                calYear: todayDate.getFullYear(),
                calMonth: todayDate.getMonth() + 1,
                mobileDayFilter: "all"
            };

            var elWeekRange = document.getElementById("ttWeekRangeDisplay");
            var elEmptyBanner = document.getElementById("ttWeekEmptyBanner");
            var elHeaderRow = document.getElementById("ttDesktopHeaderRow");
            var elGridBody = document.getElementById("ttDesktopGridBody");
            var elMobileDaysBar = document.getElementById("ttMobileDaysBar");
            var elMobileCardsList = document.getElementById("ttMobileCardsList");
            var elCalMonthYear = document.getElementById("ttCalMonthYear");
            var elMiniCalGrid = document.getElementById("ttMiniCalGrid");

            function getStatusBadgeClass(statusKey) {
                if (statusKey === "past") return "tt-status-badge tt-status-past";
                if (statusKey === "ongoing") return "tt-status-badge tt-status-ongoing";
                if (statusKey === "upcoming") return "tt-status-badge tt-status-upcoming";
                return "tt-status-badge tt-status-unscheduled";
            }

            function buildActionFooter(lec) {
                var footer = document.createElement("div");
                footer.className = "tt-card-footer";

                if (lec.validLink && isSafeHttpsUrl(lec.link)) {
                    var joinLink = document.createElement("a");
                    joinLink.href = lec.link;
                    joinLink.target = "_blank";
                    joinLink.rel = "noopener noreferrer";
                    joinLink.className = "tt-join-btn";

                    var icon = document.createElement("i");
                    icon.className = "fas fa-video";
                    joinLink.appendChild(icon);
                    joinLink.appendChild(document.createTextNode(" دخول المحاضرة"));
                    footer.appendChild(joinLink);
                } else {
                    var noLink = document.createElement("span");
                    noLink.className = "tt-no-link";
                    noLink.textContent = "رابط المحاضرة غير متوفر";
                    footer.appendChild(noLink);
                }

                if (lec.hasDoc && lec.docUrl) {
                    var docLink = document.createElement("a");
                    docLink.href = lec.docUrl;
                    docLink.target = "_blank";
                    docLink.rel = "noopener noreferrer";
                    docLink.className = "tt-doc-link";
                    docLink.title = "المرفق التعليمي";

                    var clipIcon = document.createElement("i");
                    clipIcon.className = "fas fa-paperclip";
                    docLink.appendChild(clipIcon);
                    docLink.appendChild(document.createTextNode(" المرفق"));
                    footer.appendChild(docLink);
                }

                return footer;
            }

            function renderDesktopAndMobileWeek() {
                var weekStart = state.activeWeekStart;
                var weekEnd = addDays(weekStart, 6);
                var weekStartKey = formatDateKey(weekStart);
                var weekEndKey = formatDateKey(weekEnd);

                if (elWeekRange) {
                    elWeekRange.textContent = formatArabicWeekRange(weekStart, weekEnd);
                }

                var weekLectures = [];
                for (var i = 0; i < lectures.length; i++) {
                    var l = lectures[i];
                    if (l.validDate && l.dateKey >= weekStartKey && l.dateKey <= weekEndKey) {
                        weekLectures.push(l);
                    }
                }

                weekLectures.sort(function (a, b) {
                    return a.dateObj.getTime() - b.dateObj.getTime();
                });

                if (elEmptyBanner) {
                    elEmptyBanner.style.display = weekLectures.length === 0 ? "" : "none";
                }

                // تحديث ترويسة الأيام السبعة
                if (elHeaderRow) {
                    while (elHeaderRow.firstChild) {
                        elHeaderRow.removeChild(elHeaderRow.firstChild);
                    }

                    var timeTh = document.createElement("th");
                    timeTh.className = "tt-time-col-header";
                    timeTh.scope = "col";
                    timeTh.title = "الساعة";
                    var clockIcon = document.createElement("i");
                    clockIcon.className = "far fa-clock";
                    timeTh.appendChild(clockIcon);
                    elHeaderRow.appendChild(timeTh);

                    for (var d = 0; d < 7; d++) {
                        var colDate = addDays(weekStart, d);
                        var colKey = formatDateKey(colDate);
                        var th = document.createElement("th");
                        var thClass = "tt-day-col-header";
                        if (colKey === todayKey) thClass += " is-today";
                        if (state.selectedDateKey && colKey === state.selectedDateKey) thClass += " is-selected";
                        th.className = thClass;
                        th.scope = "col";
                        th.setAttribute("data-date", colKey);
                        th.setAttribute("data-day-index", String(d));

                        var spanName = document.createElement("span");
                        spanName.className = "tt-day-header-name";
                        spanName.textContent = ARABIC_DAYS[d];

                        var spanNum = document.createElement("span");
                        spanNum.className = "tt-day-header-num";
                        spanNum.textContent = String(colDate.getDate());

                        th.appendChild(spanName);
                        th.appendChild(spanNum);

                        (function (capturedKey, capturedDayIdx) {
                            th.addEventListener("click", function () {
                                state.selectedDateKey = capturedKey;
                                state.mobileDayFilter = String(capturedDayIdx);
                                renderDesktopAndMobileWeek();
                                renderMiniCalendar();
                            });
                        })(colKey, d);

                        elHeaderRow.appendChild(th);
                    }
                }

                // حساب النطاق الزمني
                var minHour = 9;
                var maxHour = 17;
                if (weekLectures.length > 0) {
                    var minH = 23;
                    var maxH = 0;
                    for (var j = 0; j < weekLectures.length; j++) {
                        if (weekLectures[j].hour < minH) minH = weekLectures[j].hour;
                        if (weekLectures[j].hour > maxH) maxH = weekLectures[j].hour;
                    }
                    minHour = Math.max(0, minH - 1);
                    maxHour = Math.min(23, maxH + 1);
                    if (maxHour - minHour < 5) {
                        minHour = Math.max(0, minHour - 1);
                        maxHour = Math.min(23, Math.max(maxHour + 2, minHour + 5));
                    }
                }

                // بناء صفوف الساعات لسطح المكتب
                if (elGridBody) {
                    while (elGridBody.firstChild) {
                        elGridBody.removeChild(elGridBody.firstChild);
                    }

                    for (var hr = minHour; hr <= maxHour; hr++) {
                        var tr = document.createElement("tr");

                        var tdTime = document.createElement("td");
                        tdTime.className = "tt-time-cell";
                        tdTime.textContent = pad2(hr) + ":00";
                        tr.appendChild(tdTime);

                        for (var dayIdx = 0; dayIdx < 7; dayIdx++) {
                            var sDate = addDays(weekStart, dayIdx);
                            var sKey = formatDateKey(sDate);
                            var tdSlot = document.createElement("td");
                            var slotCls = "tt-slot-cell";
                            if (sKey === todayKey) slotCls += " is-today-col";
                            if (state.selectedDateKey && sKey === state.selectedDateKey) slotCls += " is-selected-col";
                            tdSlot.className = slotCls;

                            var matching = [];
                            for (var k = 0; k < weekLectures.length; k++) {
                                if (weekLectures[k].dayCol === dayIdx && weekLectures[k].hour === hr) {
                                    matching.push(weekLectures[k]);
                                }
                            }

                            if (matching.length > 0) {
                                var stack = document.createElement("div");
                                stack.className = "tt-slot-stack";

                                for (var m = 0; m < matching.length; m++) {
                                    var item = matching[m];
                                    var card = document.createElement("article");
                                    card.className = "tt-lecture-card " + item.theme;
                                    card.setAttribute("data-lecture-id", item.id);

                                    var topDiv = document.createElement("div");
                                    topDiv.className = "tt-card-top";

                                    var timeSpan = document.createElement("span");
                                    timeSpan.className = "tt-card-time";
                                    var cIcon = document.createElement("i");
                                    cIcon.className = "far fa-clock";
                                    timeSpan.appendChild(cIcon);
                                    timeSpan.appendChild(document.createTextNode(" " + item.timeText));

                                    var badgeSpan = document.createElement("span");
                                    badgeSpan.className = getStatusBadgeClass(item.statusKey);
                                    badgeSpan.textContent = item.statusLabel;

                                    topDiv.appendChild(timeSpan);
                                    topDiv.appendChild(badgeSpan);

                                    var courseDiv = document.createElement("div");
                                    courseDiv.className = "tt-card-course";
                                    courseDiv.textContent = item.course;

                                    var titleH3 = document.createElement("h3");
                                    titleH3.className = "tt-card-title";
                                    titleH3.title = item.name;
                                    titleH3.textContent = item.name;

                                    card.appendChild(topDiv);
                                    card.appendChild(courseDiv);
                                    card.appendChild(titleH3);
                                    card.appendChild(buildActionFooter(item));

                                    stack.appendChild(card);
                                }
                                tdSlot.appendChild(stack);
                            }

                            tr.appendChild(tdSlot);
                        }

                        elGridBody.appendChild(tr);
                    }
                }

                // بناء واجهة الهاتف
                if (elMobileDaysBar && elMobileCardsList) {
                    while (elMobileDaysBar.firstChild) {
                        elMobileDaysBar.removeChild(elMobileDaysBar.firstChild);
                    }
                    while (elMobileCardsList.firstChild) {
                        elMobileCardsList.removeChild(elMobileCardsList.firstChild);
                    }

                    var allBtn = document.createElement("button");
                    allBtn.type = "button";
                    allBtn.className = "tt-mobile-day-pill" + (state.mobileDayFilter === "all" ? " is-active" : "");
                    var allSpan = document.createElement("span");
                    allSpan.textContent = "كل الأسبوع";
                    var allSmall = document.createElement("small");
                    allSmall.textContent = "(" + weekLectures.length + ")";
                    allBtn.appendChild(allSpan);
                    allBtn.appendChild(allSmall);
                    allBtn.addEventListener("click", function () {
                        state.mobileDayFilter = "all";
                        renderDesktopAndMobileWeek();
                    });
                    elMobileDaysBar.appendChild(allBtn);

                    for (var md = 0; md < 7; md++) {
                        var mDate = addDays(weekStart, md);
                        var hasDayLec = false;
                        for (var wl = 0; wl < weekLectures.length; wl++) {
                            if (weekLectures[wl].dayCol === md) {
                                hasDayLec = true;
                                break;
                            }
                        }
                        var dayBtn = document.createElement("button");
                        dayBtn.type = "button";
                        var dayBtnCls = "tt-mobile-day-pill";
                        if (state.mobileDayFilter === String(md)) dayBtnCls += " is-active";
                        if (hasDayLec) dayBtnCls += " has-lec";
                        dayBtn.className = dayBtnCls;

                        var dSpan = document.createElement("span");
                        dSpan.textContent = ARABIC_DAYS[md];
                        var dSmall = document.createElement("small");
                        dSmall.textContent = String(mDate.getDate());
                        dayBtn.appendChild(dSpan);
                        dayBtn.appendChild(dSmall);

                        (function (capturedMd, capturedDateKey) {
                            dayBtn.addEventListener("click", function () {
                                state.mobileDayFilter = String(capturedMd);
                                state.selectedDateKey = capturedDateKey;
                                renderDesktopAndMobileWeek();
                                renderMiniCalendar();
                            });
                        })(md, formatDateKey(mDate));

                        elMobileDaysBar.appendChild(dayBtn);
                    }

                    var filteredMobile = [];
                    for (var fl = 0; fl < weekLectures.length; fl++) {
                        if (state.mobileDayFilter === "all" || String(weekLectures[fl].dayCol) === state.mobileDayFilter) {
                            filteredMobile.push(weekLectures[fl]);
                        }
                    }

                    if (filteredMobile.length === 0 && weekLectures.length > 0) {
                        var emptyDayDiv = document.createElement("div");
                        emptyDayDiv.className = "tt-side-empty";
                        emptyDayDiv.textContent = "لا توجد حصص مجدولة في هذا اليوم.";
                        elMobileCardsList.appendChild(emptyDayDiv);
                    } else {
                        for (var mc = 0; mc < filteredMobile.length; mc++) {
                            var mItem = filteredMobile[mc];
                            var mCard = document.createElement("article");
                            mCard.className = "tt-mobile-lec-card " + mItem.theme;

                            var mTop = document.createElement("div");
                            mTop.className = "tt-card-top";
                            var mCourse = document.createElement("span");
                            mCourse.className = "tt-card-course";
                            mCourse.textContent = mItem.course;
                            var mBadge = document.createElement("span");
                            mBadge.className = getStatusBadgeClass(mItem.statusKey);
                            mBadge.textContent = mItem.statusLabel;
                            mTop.appendChild(mCourse);
                            mTop.appendChild(mBadge);

                            var mTitle = document.createElement("h3");
                            mTitle.className = "tt-side-lec-title";
                            mTitle.textContent = mItem.name;

                            var mMeta = document.createElement("div");
                            mMeta.className = "tt-side-lec-meta";
                            var mDateSpan = document.createElement("span");
                            mDateSpan.textContent = mItem.dayName + "، " + mItem.dateKey;
                            var mTimeSpan = document.createElement("span");
                            mTimeSpan.style.direction = "ltr";
                            mTimeSpan.textContent = mItem.timeText;
                            mMeta.appendChild(mDateSpan);
                            mMeta.appendChild(mTimeSpan);

                            mCard.appendChild(mTop);
                            mCard.appendChild(mTitle);
                            mCard.appendChild(mMeta);
                            mCard.appendChild(buildActionFooter(mItem));

                            elMobileCardsList.appendChild(mCard);
                        }
                    }
                }
            }

            function renderMiniCalendar() {
                if (!elMiniCalGrid || !elCalMonthYear) return;

                elCalMonthYear.textContent = ARABIC_MONTHS[state.calMonth] + " " + state.calYear;

                while (elMiniCalGrid.firstChild) {
                    elMiniCalGrid.removeChild(elMiniCalGrid.firstChild);
                }

                var firstOfMonth = new Date(state.calYear, state.calMonth - 1, 1, 0, 0, 0, 0);
                var startOffset = getArabicDayIndexFromJsDay(firstOfMonth.getDay());
                var gridStart = addDays(firstOfMonth, -startOffset);

                var weekStartKey = formatDateKey(state.activeWeekStart);
                var weekEndKey = formatDateKey(addDays(state.activeWeekStart, 6));

                for (var i = 0; i < 42; i++) {
                    var cellDate = addDays(gridStart, i);
                    var cellKey = formatDateKey(cellDate);
                    var isOtherMonth = (cellDate.getMonth() + 1) !== state.calMonth;
                    var isToday = cellKey === todayKey;
                    var hasLec = !!lectureDateSet[cellKey];
                    var inActiveWeek = cellKey >= weekStartKey && cellKey <= weekEndKey;
                    var isSelected = state.selectedDateKey === cellKey;

                    var btn = document.createElement("button");
                    btn.type = "button";
                    var cls = "tt-cal-day";
                    if (isOtherMonth) cls += " is-other-month";
                    if (inActiveWeek) cls += " is-in-week";
                    if (hasLec) cls += " has-lecture";
                    if (isToday) cls += " is-today";
                    if (isSelected) cls += " is-selected";
                    btn.className = cls;
                    btn.setAttribute("data-date", cellKey);
                    btn.title = hasLec ? (cellKey + " (يوجد محاضرة)") : cellKey;
                    btn.textContent = String(cellDate.getDate());

                    (function (capturedDate, capturedKey) {
                        btn.addEventListener("click", function () {
                            state.selectedDateKey = capturedKey;
                            state.activeWeekStart = getWeekStartSaturday(capturedDate);
                            state.calYear = capturedDate.getFullYear();
                            state.calMonth = capturedDate.getMonth() + 1;
                            state.mobileDayFilter = String(getArabicDayIndexFromJsDay(capturedDate.getDay()));
                            renderDesktopAndMobileWeek();
                            renderMiniCalendar();
                        });
                    })(cellDate, cellKey);

                    elMiniCalGrid.appendChild(btn);
                }
            }

            // أزرار التنقل بين الأسابيع
            var btnPrevWeek = document.getElementById("ttBtnPrevWeek");
            var btnNextWeek = document.getElementById("ttBtnNextWeek");
            var btnCurrWeek = document.getElementById("ttBtnCurrentWeek");

            if (btnPrevWeek) {
                btnPrevWeek.addEventListener("click", function () {
                    state.activeWeekStart = addDays(state.activeWeekStart, -7);
                    state.selectedDateKey = null;
                    state.mobileDayFilter = "all";
                    state.calYear = state.activeWeekStart.getFullYear();
                    state.calMonth = state.activeWeekStart.getMonth() + 1;
                    renderDesktopAndMobileWeek();
                    renderMiniCalendar();
                });
            }

            if (btnNextWeek) {
                btnNextWeek.addEventListener("click", function () {
                    state.activeWeekStart = addDays(state.activeWeekStart, 7);
                    state.selectedDateKey = null;
                    state.mobileDayFilter = "all";
                    state.calYear = state.activeWeekStart.getFullYear();
                    state.calMonth = state.activeWeekStart.getMonth() + 1;
                    renderDesktopAndMobileWeek();
                    renderMiniCalendar();
                });
            }

            if (btnCurrWeek) {
                btnCurrWeek.addEventListener("click", function () {
                    state.activeWeekStart = new Date(currentWeekStart.getTime());
                    state.selectedDateKey = todayKey;
                    state.mobileDayFilter = "all";
                    state.calYear = todayDate.getFullYear();
                    state.calMonth = todayDate.getMonth() + 1;
                    renderDesktopAndMobileWeek();
                    renderMiniCalendar();
                });
            }

            // أزرار التنقل بين الأشهر في التقويم المصغر
            var btnPrevMonth = document.getElementById("ttBtnPrevMonth");
            var btnNextMonth = document.getElementById("ttBtnNextMonth");

            if (btnPrevMonth) {
                btnPrevMonth.addEventListener("click", function () {
                    state.calMonth -= 1;
                    if (state.calMonth < 1) {
                        state.calMonth = 12;
                        state.calYear -= 1;
                    }
                    renderMiniCalendar();
                });
            }

            if (btnNextMonth) {
                btnNextMonth.addEventListener("click", function () {
                    state.calMonth += 1;
                    if (state.calMonth > 12) {
                        state.calMonth = 1;
                        state.calYear += 1;
                    }
                    renderMiniCalendar();
                });
            }

            // زر عرض المزيد في قسم الحصص السابقة
            var btnTogglePrev = document.getElementById("ttBtnTogglePrev");
            if (btnTogglePrev) {
                btnTogglePrev.addEventListener("click", function () {
                    var expanded = btnTogglePrev.getAttribute("data-expanded") === "1";
                    var moreCount = btnTogglePrev.getAttribute("data-more-count") || "";
                    var extraRows = root.querySelectorAll('#ttPreviousLecturesList [data-prev-extra="1"]');
                    for (var r = 0; r < extraRows.length; r++) {
                        if (expanded) {
                            extraRows[r].classList.add("tt-prev-hidden");
                        } else {
                            extraRows[r].classList.remove("tt-prev-hidden");
                        }
                    }
                    btnTogglePrev.setAttribute("data-expanded", expanded ? "0" : "1");
                    btnTogglePrev.textContent = "";
                    var labelSpan = document.createElement("span");
                    labelSpan.textContent = expanded
                        ? ("عرض المزيد من الحصص السابقة (" + moreCount + ")")
                        : "عرض عدد أقل";
                    var chevron = document.createElement("i");
                    chevron.className = expanded ? "fas fa-chevron-down" : "fas fa-chevron-up";
                    btnTogglePrev.appendChild(labelSpan);
                    btnTogglePrev.appendChild(chevron);
                });
            }

            renderDesktopAndMobileWeek();
            renderMiniCalendar();
            renderUnscheduledLectures();

            function renderUnscheduledLectures() {
                var unsec = document.getElementById("ttUnscheduledSection");
                var unlist = document.getElementById("ttUnscheduledList");
                var unbadge = document.getElementById("ttUnscheduledCountBadge");
                if (!unsec || !unlist) return;

                var unscheduled = [];
                for (var u = 0; u < lectures.length; u++) {
                    if (!lectures[u].validDate || lectures[u].statusKey === "unscheduled") {
                        unscheduled.push(lectures[u]);
                    }
                }

                if (unscheduled.length === 0) {
                    unsec.style.display = "none";
                    return;
                }

                unsec.style.display = "";
                if (unbadge) unbadge.textContent = String(unscheduled.length);

                while (unlist.firstChild) {
                    unlist.removeChild(unlist.firstChild);
                }

                for (var idx = 0; idx < unscheduled.length; idx++) {
                    var item = unscheduled[idx];
                    var row = document.createElement("article");
                    row.className = "tt-prev-row";
                    row.style.borderRightColor = "#F59E0B";
                    row.setAttribute("data-lecture-id", item.id);

                    var mainDiv = document.createElement("div");
                    mainDiv.className = "tt-prev-main";

                    var courseSpan = document.createElement("span");
                    courseSpan.className = "tt-prev-course";
                    courseSpan.textContent = item.course;

                    var titleH3 = document.createElement("h3");
                    titleH3.className = "tt-prev-title";
                    titleH3.textContent = item.name;

                    var metaDiv = document.createElement("div");
                    metaDiv.className = "tt-prev-meta";
                    var stBadge = document.createElement("span");
                    stBadge.className = "tt-status-badge tt-status-unscheduled";
                    stBadge.textContent = "موعد غير محدد";
                    metaDiv.appendChild(stBadge);

                    mainDiv.appendChild(courseSpan);
                    mainDiv.appendChild(titleH3);
                    mainDiv.appendChild(metaDiv);

                    var actionsDiv = document.createElement("div");
                    actionsDiv.className = "tt-prev-actions";
                    actionsDiv.appendChild(buildActionFooter(item));

                    row.appendChild(mainDiv);
                    row.appendChild(actionsDiv);
                    unlist.appendChild(row);
                }
            }
        }

        window.refreshStudentTimetable = initStudentTimetable;

        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", initStudentTimetable);
        } else {
            initStudentTimetable();
        }
    })();
</script>