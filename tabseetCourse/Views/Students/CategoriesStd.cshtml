@model IEnumerable<tabseetCourse.Models.Std_Reg_CategoryModel>
@using System.Globalization

@{
    ViewBag.Title = "برامجي التعليمية";
    Layout = "~/Views/Shared/_LayoutStudent.cshtml";

    var courses = Model != null ? Model.ToList() : new List<tabseetCourse.Models.Std_Reg_CategoryModel>();
    int totalCoursesCount = courses.Count;
    int totalLecturesCount = courses.Sum(c => c.lectureCount);
    int totalFinishedCount = courses.Sum(c => c.lectureFinishCount);

    // حالة الاشتراك تأتي محسوبة من الخادم (CourseAccessService): المفعّلة فقط تُعرض محاضراتها وروابطها
    var activeCourses = courses.Where(c => c.IsSubscriptionActive).ToList();
    int pendingCoursesCount = courses.Count(c => c.IsSubscriptionPending);
    string firstActiveCategoryId = activeCourses.Count > 0 ? activeCourses[0].Category_ID.ToString() : "";
    string uploadsBaseUrl = Url.Content("~/Uploade/Images/");
    string subscriptionMessage = TempData["SubscriptionMessage"] as string;
    string subscriptionMessageType = (TempData["SubscriptionMessageType"] as string) ?? "info";
}

@functions {
    public static bool IsSafeHttpsUrl(string url)
    {
        if (string.IsNullOrWhiteSpace(url)) return false;
        string trimmed = url.Trim();
        if (!trimmed.StartsWith("https://", StringComparison.OrdinalIgnoreCase)) return false;
        Uri parsed;
        if (!Uri.TryCreate(trimmed, UriKind.Absolute, out parsed)) return false;
        if (parsed.Scheme != Uri.UriSchemeHttps) return false;
        string host = parsed.Host.ToLowerInvariant();
        if (host == "localhost" || host == "127.0.0.1" || host == "::1") return false;
        if (host.StartsWith("10.") || host.StartsWith("192.168.")) return false;
        if (host.StartsWith("172."))
        {
            string[] parts = host.Split('.');
            if (parts.Length == 4)
            {
                int second;
                if (int.TryParse(parts[1], out second) && second >= 16 && second <= 31)
                    return false;
            }
        }
        return true;
    }
}

