            <div class="sub-header-badges">
                <div class="sub-stat-pill">
                    <i class="fas fa-book-reader"></i>
                    <div>
                        <div class="sub-stat-num">@totalCoursesCount</div>
                        <span class="sub-stat-label">الدورات المسجلة</span>
                    </div>
                </div>
                <div class="sub-stat-pill">
                    <i class="fas fa-play-circle"></i>
                    <div>
                        <div class="sub-stat-num">@totalLecturesCount</div>
                        <span class="sub-stat-label">إجمالي المحاضرات</span>
                    </div>
                </div>
                <div class="sub-stat-pill">
                    <i class="fas fa-check-double"></i>
                    <div>
                        <div class="sub-stat-num">@totalFinishedCount</div>
                        <span class="sub-stat-label">المحاضرات المكتملة</span>
                    </div>
                </div>
            </div>
        </header>

        @if (courses.Count == 0)
        {
            <!-- حالة خلو البرامج المسجلة -->
            <div class="sub-empty-box">
                <i class="fas fa-folder-open"></i>
                <h3>لا توجد برامج أو دورات مسجلة حاليًا</h3>
                <p>لم يتم تسجيلك في أي دورات تدريبية حتى الآن. عند التسجيل في أي دورة ستظهر هنا مباشرة مع كافة تفاصيلها ومحاضراتها.</p>
            </div>
        }
        else
        {
            <!-- 3. شبكة بطاقات الدورات والبرامج التعليمية -->
            <div class="sub-section-title-wrap">
                <h2 class="sub-section-title">
                    <i class="fas fa-shapes"></i>
                    <span>الدورات والبرامج المسجلة</span>
                </h2>
                <p class="sub-section-hint">اضغط على بطاقة أي دورة لعرض محاضراتها أدناه، أو استخدم أزرار الإجراءات السريعة للمتابعة.</p>
            </div>

            <div class="sub-courses-grid" id="subCoursesGrid" role="tablist" aria-label="قائمة البرامج التعليمية">
                @for (int i = 0; i < courses.Count; i++)
                {
                    var item = courses[i];
                    bool isFirst = i == 0;
                    bool isPaid = (item.std_category_Ispayed == 0 && item.category_Ispayed == 0) || (item.std_category_Ispayed == 1 && item.category_Ispayed == 1);
                    int progressPercentage = item.lectureCount > 0 ? Math.Min(100, (int)Math.Round((double)item.lectureFinishCount * 100 / item.lectureCount)) : 0;

                    <div class="sub-course-card @(isFirst ? "is-active" : "")"
                         data-category-id="@item.Category_ID"
                         tabindex="0"
                         role="tab"
                         aria-selected="@(isFirst ? "true" : "false")"
                         aria-controls="subLecturesPanel">

                        <div>
                            <div class="sub-card-top">
                                <div class="sub-course-icon-badge">
                                    @if (!string.IsNullOrWhiteSpace(item.Icon))
                                    {
                                        <img src="~/Uploade/Images/@item.Icon" alt="@item.CategoryName" />
                                    }
                                    else
                                    {
                                        <i class="fas fa-book-open"></i>
                                    }
                                </div>
                                <div class="sub-badges-group">
                                    @if (!isPaid)
                                    {
                                        <span class="sub-status-badge badge-unpaid">
                                            <i class="fas fa-exclamation-circle"></i> بانتظار السداد
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="sub-status-badge badge-active">
                                            <i class="fas fa-check-circle"></i> @(string.IsNullOrWhiteSpace(item.categoryType_Nmae) ? "دورة تدريبية" : item.categoryType_Nmae)
                                        </span>
                                    }
                                    <span class="sub-lectures-badge">
                                        <i class="fas fa-play"></i> @item.lectureCount محاضرة
                                    </span>
                                </div>
                            </div>

                            <h3 class="sub-course-name">@item.CategoryName</h3>

                            <div class="sub-course-teacher">
                                <i class="fas fa-chalkboard-teacher"></i>
                                <span>@(string.IsNullOrWhiteSpace(item.TeacherName) ? "أكاديمية تبسيط" : item.TeacherName)</span>
                            </div>

                            @if (item.lectureCount > 0)
                            {
                                <div class="sub-progress-wrap">
                                    <div class="sub-progress-text">
                                        <span>المحاضرات المكتملة</span>
                                        <span>@item.lectureFinishCount / @item.lectureCount (@progressPercentage%)</span>
                                    </div>
                                    <div class="sub-progress-bar">
                                        <div class="sub-progress-fill" style="width: @progressPercentage%;"></div>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- أزرار الإجراءات السريعة للدورة -->
                        <div class="sub-card-actions">
                            @if (!isPaid)
                            {
                                <button type="button" class="sub-card-btn sub-btn-pay" onclick="event.stopPropagation(); assingInfo(@item.categoryPrice, @item.Category_ID)" data-toggle="modal" data-target="#modal-lg">
                                    <i class="fas fa-credit-card"></i>
                                    <span>سداد الرسوم (@item.categoryPrice)</span>
                                </button>
                            }
                            else
                            {
                                <div class="sub-card-actions-row">
                                    @if (item.lectureCount > 0 && item.Std_Reg_CategoryType == 1)
                                    {
                                        <a href="@Url.Action("Courses", "Students", new { Deplom_ID = item.Category_ID, LectureName = item.CategoryName })" class="sub-card-btn sub-btn-primary" onclick="event.stopPropagation();" title="عرض الدورات والبرامج الفرعية">
                                            <i class="fas fa-folder-open"></i>
                                            <span>الدورات</span>
                                        </a>
                                    }
                                    @if (item.lectureCount > 0 && item.Std_Reg_CategoryType == 2)
                                    {
                                        <a href="@Url.Action("LecturesStd", "Students", new { cat_ID = item.Category_ID, LectureName = item.CategoryName })" class="sub-card-btn sub-btn-primary" onclick="event.stopPropagation();" title="فتح صفحة المحاضرات">
                                            <i class="fas fa-play-circle"></i>
                                            <span>المحاضرات</span>
                                        </a>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(item.DocumentBook))
                                    {
                                        <a href="~/Uploade/Images/@item.DocumentBook" target="_blank" rel="noopener noreferrer" class="sub-card-btn sub-btn-book" onclick="event.stopPropagation();" title="تحميل الكتاب">
                                            <i class="fas fa-book"></i>
                                            <span>الكتاب</span>
                                        </a>
                                    }

                                    @if (item.Exam_ID != 0 && item.std_exam_isFinish == 0)
                                    {
                                        <button type="button" class="sub-card-btn sub-btn-exam" onclick="event.stopPropagation(); getExam(@item.Exam_ID, @item.Category_ID);" title="بدء الاختبار">
                                            <i class="fas fa-file-alt"></i>
                                            <span>امتحان</span>
                                        </button>
                                    }

                                    @if (item.std_exam_isFinish == 1)
                                    {
                                        <button type="button" class="sub-card-btn sub-btn-cert" onclick="event.stopPropagation(); GetDocmntation(@item.Category_ID);" title="عرض الشهادة">
                                            <i class="fas fa-award"></i>
                                            <span>شهادة</span>
                                        </button>
                                    }
                                </div>
                            }

                            <button type="button" class="sub-card-btn sub-btn-lectures" data-category-id="@item.Category_ID" aria-label="عرض المحاضرات في هذه الصفحة">
                                <i class="fas fa-list-ul"></i>
                                <span>استعراض المحاضرات</span>
                            </button>
                        </div>
                    </div>
                }
            </div>

            <!-- 4. لوحة عرض محاضرات المادة المحددة -->
            <section class="sub-lectures-panel" id="subLecturesPanel" role="tabpanel" aria-live="polite">
                <div class="sub-panel-head">
                    <div>
                        <h2 class="sub-panel-title">
                            <i class="fas fa-layer-group"></i>
                            <span>محاضرات: </span>
                            <span id="subSelectedCourseTitle" style="color: #C5A052;">@courses[0].CategoryName</span>
                        </h2>
                        <p class="sub-panel-subtitle">جميع المحاضرات المباشرة والمسجلة الخاصة بهذه الدورة.</p>
                    </div>

                    <div class="sub-filter-pills" id="subFilterPills">
                        <button type="button" class="sub-filter-pill is-active" data-filter="all">الكل</button>
                        <button type="button" class="sub-filter-pill" data-filter="live">المباشرة</button>
                        <button type="button" class="sub-filter-pill" data-filter="recorded">المسجلة</button>
                    </div>
                </div>

                <div class="sub-lectures-list" id="subLecturesList">
                    <!-- يتم البناء بواسطة JavaScript ديناميكيًا -->
                </div>

                <div class="sub-empty-box" id="subLecturesEmpty" style="display:none;">
                    <i class="far fa-calendar-times"></i>
                    <h3>لا توجد محاضرات في هذه الدورة حاليًا</h3>
                    <p>لم يتم تسجيل محاضرات لهذه الدورة حتى الآن.</p>
                </div>
            </section>
        }

        <!-- 5. نافذة منبثقة لتفاصيل المحاضرة -->
        <div id="subLectureModal" class="sub-modal" role="dialog" aria-modal="true" aria-labelledby="subModalTitle" hidden>
            <div class="sub-modal-shade" data-sub-modal-close="1"></div>
            <div class="sub-modal-panel" id="subModalPanel" tabindex="-1">
                <button type="button" id="subModalClose" class="sub-modal-close" aria-label="إغلاق التفاصيل" data-sub-modal-close="1">×</button>
                <div id="subModalSubject" class="sub-modal-course"></div>
                <h3 id="subModalTitle" class="sub-modal-title"></h3>
                <div class="sub-modal-meta">
                    <div><strong>نوع المحاضرة:</strong> <span id="subModalType"></span></div>
                    <div><strong>الموعد:</strong> <span id="subModalTime"></span></div>
                </div>
                <div id="subModalActions" class="sub-modal-actions"></div>
            </div>
        </div>

        <!-- 6. نافذة الدفع وطرق السداد (Modal المحافظ عليه بالكامل من الصفحة الأصلية) -->
        <div class="modal fade" id="modal-lg" tabindex="-1" role="dialog" aria-labelledby="modalPayTitle" aria-hidden="true">
            <div class="modal-dialog modal-lg" role="document">
                <div class="modal-content" style="direction: rtl; text-align: right; border-radius: 16px; overflow: hidden;">
                    <div class="modal-header bg-primary text-white" style="background-color: #113464 !important;">
                        <h4 class="modal-title" id="modalPayTitle" style="color: #FFFFFF; font-weight: 800;">طريقة الدفع وسداد الرسوم</h4>
                        <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close" style="color: #FFFFFF !important; opacity: 1;">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <div class="modal-body" style="padding: 24px;">
                        <table style="width:100%" class="table table-borderless">
                            <tr>
                                <td>
                                    <div class="form-group text-center">
                                        <label style="font-weight: 700;">الدفع عن طريق وكيل</label><br />
                                        <input type="radio" id="PaymnetbyClient" name="paymnet" value="DirectPank" onchange="RadioChange()" />
                                    </div>
                                </td>
                                <td>
                                    <div class="form-group text-center">
                                        <label style="font-weight: 700;">بطاقة ائتمان</label><br />
                                        <input type="radio" id="PaymnetCridetCard" name="paymnet" value="DirectPank" onchange="RadioChange()" />
                                    </div>
                                </td>
                                <td>
                                    <div class="form-group text-center">
                                        <label style="font-weight: 700;">حوالة بنكية</label><br />
                                        <input type="radio" id="PayMentInPank" name="paymnet" value="PanckTransfer" onchange="RadioChange()" />
                                    </div>
                                </td>
                                <td>
                                    <div class="form-group text-center">
                                        <label style="font-weight: 700;">سودان كاش</label><br />
                                        <input type="radio" id="Paymnetleater" name="paymnet" value="kachsodan" onchange="RadioChange()" />
                                    </div>
                                </td>
                                <td>
                                    <div class="form-group text-center">
                                        <label style="font-weight: 700;">بنكك</label><br />
                                        <input type="radio" id="PaymnetBankak" name="paymnet" value="bankak" onchange="RadioChange()" />
                                    </div>
                                </td>
                                <td>
                                    <div class="form-group text-center">
                                        <label style="font-weight: 700;">طلب منحة</label><br />
                                        <input type="radio" id="PaymnetCode" name="paymnet" value="Code" onchange="RadioChange()" />
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="6">
                                    <div class="row" id="kachsodan" style="display:none;">
                                        <div class="col-sm-12">
                                            <label>أرجو إرفاق إشعار الدفع عبر سودان كاش <span class="text-danger">*</span></label>
                                            <div class="form-group">
                                                <input type="file" class="form-control" id="UploadFileKash" onchange="Validation()">
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row" id="bankak" style="display:none;">
                                        <div class="col-sm-12">
                                            <label>أرجو إرفاق إشعار التحويل عبر تطبيق بنكك <span class="text-danger">*</span></label>
                                            <div class="form-group">
                                                <input type="file" class="form-control" id="UploadFileBankak" onchange="Validation()">
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row" id="PayMentInPank_Div" style="display:none;">
                                        <div class="col-sm-12">
                                            <label>تحويل المبلغ إلى الحساب البنكي</label>
                                            <div class="form-group alert alert-info">
                                                <strong>رقم الحساب: </strong> 999999<br />
                                                <strong>اسم الحساب: </strong> Zakarias
                                            </div>
                                        </div>
                                        <div class="col-sm-12">
                                            <label>أرجو إرفاق إشعار التحويل البنكي <span class="text-danger">*</span></label>
                                            <div class="form-group">
                                                <input type="file" class="form-control" id="UploadFile" onchange="Validation()">
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row" id="PaymnetCridetCard_Div" style="display:none;">
                                        <div class="col-sm-6">
                                            <label>الاسم على البطاقة <span class="text-danger">*</span></label>
                                            <input type="text" class="form-control" id="Card_Name" onkeyup="Validation()">
                                        </div>
                                        <div class="col-sm-6">
                                            <label>رقم البطاقة <span class="text-danger">*</span></label>
                                            <input type="text" class="form-control" id="cr_no" onkeyup="Validation()">
                                        </div>
                                        <div class="col-sm-6" style="margin-top: 10px;">
                                            <label>تاريخ الانتهاء (MM/YY) <span class="text-danger">*</span></label>
                                            <input type="text" class="form-control" id="exp" onkeyup="Validation()">
                                        </div>
                                        <div class="col-sm-6" style="margin-top: 10px;">
                                            <label>رمز الأمان (CVC) <span class="text-danger">*</span></label>
                                            <input type="text" class="form-control" id="CVC" onkeyup="Validation()">
                                        </div>
                                    </div>
                                    <div class="row" id="PaymnetCode_Div" style="display:none;">
                                        <div class="col-sm-12">
                                            <label>كود المنحة التعليمية <span class="text-danger">*</span></label>
                                            <div class="form-group">
                                                <input type="text" class="form-control" id="Code" onkeyup="Validation()">
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        </table>
                    </div>
                    <div class="modal-footer justify-content-between" style="background: #F8FAFC; padding: 16px 24px;">
                        <div>
                            <strong>المبلغ المستحق: </strong>
                            <span id="PaymentValue_ID" style="font-size: 18px; font-weight: 800; color: #113464;">0.00</span>
                        </div>
                        <input type="button" class="btn btn-success" id="btn_Pay" value="تأكيد وسداد الرسوم" onclick="MackPayMent()" style="padding: 8px 24px; font-weight: 700;" />
                    </div>
                </div>
            </div>
        </div>

        <!-- 7. نافذة معلومات الامتحان (Modal المحافظ عليه بالكامل من الصفحة الأصلية) -->
        <div class="modal fade" id="Exams_ID" tabindex="-1" role="dialog" aria-labelledby="modalExamTitle" aria-hidden="true">
            <div class="modal-dialog modal-lg" role="document">
                <div class="modal-content" style="direction: rtl; text-align: right; border-radius: 16px; overflow: hidden;">
                    <div class="modal-header text-white" style="background-color: #113464 !important;">
                        <h4 class="modal-title" id="modalExamTitle" style="color: #FFFFFF; font-weight: 800;">معلومات وتفاصيل الامتحان</h4>
                        <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close" style="color: #FFFFFF !important; opacity: 1;">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <div class="modal-body" style="padding: 24px;">
                        <table style="width:100%" class="table table-bordered">
                            <tr>
                                <td style="width: 25%; font-weight: 700; background: #F8FAFC;">اسم الامتحان</td>
                                <td style="width: 25%;"><p id="Exam_Name" class="mb-0 font-weight-bold text-primary"></p></td>
                                <td style="width: 25%; font-weight: 700; background: #F8FAFC; color: darkred;">مدة الامتحان</td>
                                <td style="width: 25%;"><p id="ExamDuration_ID" class="mb-0 font-weight-bold text-danger"></p></td>
                            </tr>
                            <tr>
                                <td style="font-weight: 700; background: #F8FAFC;">درجة الامتحان الكلية</td>
                                <td><p id="ExamsDegry_ID" class="mb-0 font-weight-bold"></p></td>
                                <td style="font-weight: 700; background: #F8FAFC; color: darkred;">درجة النجاح</td>
                                <td><p id="ExamWinDegry_ID" class="mb-0 font-weight-bold text-success"></p></td>
                            </tr>
                            <tr>
                                <td style="font-weight: 700; background: #F8FAFC;">ملاحظات وتعليمات</td>
                                <td colspan="3"><p id="examDescription" class="mb-0 text-muted"></p></td>
                            </tr>
                        </table>
                    </div>
                    <div class="modal-footer justify-content-between" style="background: #F8FAFC; padding: 16px 24px;">
                        <button type="button" class="btn btn-secondary" data-dismiss="modal">إلغاء</button>
                        <button type="button" class="btn btn-primary" onclick="btnStartExam()" style="background-color: #113464; border-color: #113464; padding: 8px 28px; font-weight: 700;">
                            <i class="fas fa-play"></i> بدء الامتحان
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- 8. مخزن البيانات الآمن لجميع الدورات ومحاضراتها للقراءة محليًا في المتصفح -->
        <div id="subCoursesDataset" style="display:none;" aria-hidden="true">
            @foreach (var course in courses)
            {
                <div class="sub-data-course"
                     data-id="@course.Category_ID"
                     data-name="@course.CategoryName"
                     data-teacher="@course.TeacherName"
                     data-count="@course.lectureCount">
                    @foreach (var lec in course.Lectures)
                    {
                        bool validClient = IsSafeHttpsUrl(lec.LectureLink_Client);
                        bool validMedia = IsSafeHttpsUrl(lec.MediaLink);
                        bool hasDoc = !string.IsNullOrWhiteSpace(lec.DocumenFile);
                        string docUrl = hasDoc ? ("https://tbsetaca.com/Uploade/Images/" + Uri.EscapeUriString(lec.DocumenFile.Trim())) : "";

                        <div class="sub-data-lecture"
                             data-id="@lec.ID"
                             data-category-id="@lec.Category_ID"
                             data-course="@course.CategoryName"
                             data-name="@lec.Lecture_Name"
                             data-type="@lec.LectureTypeOnOff"
                             data-datetime="@lec.DayandTime"
                             data-is-end="@(lec.Is_Lecture_End ? "1" : "0")"
                             data-is-finish="@lec.Is_Std_Finish_Lecture"
                             data-valid-client="@(validClient ? "1" : "0")"
                             data-client-url="@(validClient ? lec.LectureLink_Client.Trim() : "")"
                             data-valid-media="@(validMedia ? "1" : "0")"
                             data-media-url="@(validMedia ? lec.MediaLink.Trim() : "")"
                             data-has-doc="@(hasDoc ? "1" : "0")"
                             data-doc-name="@(hasDoc ? lec.DocumenFile.Trim() : "")"
                             data-doc-url="@docUrl"></div>
                    }
                </div>
            }
        </div>

    </div>
</div>

<script>
    /* ==========================================================================
       الوظائف البرمجية المحافظ عليها من الصفحة الأصلية:
       (الامتحانات، الشهادات، والدفع بكافة طرقه)
       ========================================================================== */

    // 1. وظائف الامتحانات
    function getExam(examID, categoryID) {
        $.ajax({
            async: true,
            type: 'POST',
            data: { Exam_ID: examID, category_ID: categoryID },
            url: '@Url.Action("StdExams", "Students")',
            success: function (result) {
                if (result.CanStartExam == 1) {
                    $("#examID").val(result.ID);
                    $("#examDescription").html(result.Description);
                    var examDuration = (result.Duration * 60).toFixed(0);
                    $("#ExamDuration_ID").html(examDuration + " دقيقة");
                    $("#Exam_Name").html(result.Name);
                    $("#ExamsDegry_ID").html(result.Exam_Degry);
                    $("#ExamWinDegry_ID").html(result.Exam_win_Degry);
                    $("#Exams_ID").modal('show');
                } else {
                    Swal.fire({
                        title: 'تنبيه',
                        text: "لا يمكن البدء بالامتحاناتِ قبلَ الانتهاء من كافة المحاضرات والواجبات المطلوبة.",
                        icon: 'warning',
                        confirmButtonText: 'حسناً',
                        confirmButtonColor: '#113464'
                    });
                }
            },
            error: function () {
                Swal.fire({
                    title: 'خطأ',
                    text: 'حدث خطأ أثناء فحص متطلبات الامتحان، يرجى المحاولة لاحقاً.',
                    icon: 'error',
                    confirmButtonText: 'حسناً',
                    confirmButtonColor: '#113464'
                });
            }
        });
    }

    function btnStartExam() {
        var id = $("#examID").val();
        if (id) {
            window.location.href = "/Students/Exams?examID=" + id;
        }
    }

    // 2. وظائف الشهادات
    function GetDocmntation(categoryID) {
        window.location.href = "/Students/Certfications";
    }

    // 3. وظائف الدفع
    function assingInfo(Price, category_ID) {
        $('#PaymentValue_ID').html(Price);
        $("#Categories_ID").val(category_ID);
        $("#PaymentValue").val(Price);
    }

    function getSelectedRadioValue(name) {
        var radios = document.getElementsByName(name);
        for (var i = 0; i < radios.length; i++) {
            if (radios[i].checked) {
                return radios[i].value;
            }
        }
        return "";
    }

    function RadioChange() {
        Validation();
        $('#PaymnetCridetCard_Div').hide();
        $('#PayMentInPank_Div').hide();
        $('#PaymnetCode_Div').hide();
        $('#kachsodan').hide();
        $('#bankak').hide();

        var value = getSelectedRadioValue('paymnet');
        if (value === 'DirectPank') {
            $('#PaymnetCridetCard_Div').show();
        } else if (value === 'PanckTransfer') {
            $('#PayMentInPank_Div').show();
        } else if (value === 'Code') {
            $('#PaymnetCode_Div').show();
        } else if (value === 'kachsodan') {
            $('#kachsodan').show();
        } else if (value === 'bankak') {
            $('#bankak').show();
        }
    }

    function Validation() {
        var value = getSelectedRadioValue('paymnet');
        var btn = document.getElementById("btn_Pay");
        if (!btn) return;

        if (value === 'DirectPank') {
            var Card_Name = $('#Card_Name').val() || "";
            var Card_Number = $('#cr_no').val() || "";
            var Expiry_Date = $('#exp').val() || "";
            var CVC = $('#CVC').val() || "";
            btn.disabled = !(Card_Name.trim() && Card_Number.trim() && Expiry_Date.trim() && CVC.trim());
        } else if (value === 'PanckTransfer') {
            var f = $('#UploadFile')[0];
            btn.disabled = !(f && f.files && f.files.length > 0);
        } else if (value === 'kachsodan') {
            var fk = $('#UploadFileKash')[0];
            btn.disabled = !(fk && fk.files && fk.files.length > 0);
        } else if (value === 'bankak') {
            var fb = $('#UploadFileBankak')[0];
            btn.disabled = !(fb && fb.files && fb.files.length > 0);
        } else if (value === 'Code') {
            var Code = $('#Code').val() || "";
            btn.disabled = (Code.trim() === "");
        } else {
            btn.disabled = true;
        }
    }

    function MackPayMent() {
        var value = getSelectedRadioValue('paymnet');
        if (value === 'DirectPank') {
            $("#PayMent_Method").val(1);
        } else if (value === 'PanckTransfer') {
            $("#PayMent_Method").val(2);
        } else if (value === 'kachsodan' || value === 'bankak') {
            $("#PayMent_Method").val(2);
        } else if (value === 'Code') {
            $("#PayMent_Method").val(4);
        }

        var fd = new FormData();
        var PayMent_Method = $("#PayMent_Method").val();
        var Categories_ID = $("#Categories_ID").val();
        var PayMent_Value = $("#PaymentValue").val();
        var Code = $("#Code").val();

        var UploadFile = null;
        if (value === 'PanckTransfer') {
            var f1 = $('#UploadFile')[0];
            if (f1 && f1.files) UploadFile = f1.files[0];
        } else if (value === 'kachsodan') {
            var f2 = $('#UploadFileKash')[0];
            if (f2 && f2.files) UploadFile = f2.files[0];
        } else if (value === 'bankak') {
            var f3 = $('#UploadFileBankak')[0];
            if (f3 && f3.files) UploadFile = f3.files[0];
        }

        fd.append("PayMent_Value", PayMent_Value);
        fd.append("PayMent_Method", PayMent_Method);
        fd.append("Category_ID", Categories_ID);
        if (UploadFile) {
            fd.append("FileUpload", UploadFile);
        }
        fd.append("Code", Code);

        $.ajax({
            async: true,
            type: 'POST',
            data: fd,
            contentType: false,
            processData: false,
            url: '@Url.Action("payforcategory", "Students")',
            success: function () {
                window.location.reload();
            },
            error: function (response) {
                alert("حدث خطأ أثناء معالجة عملية الدفع: " + (response.responseText || ""));
            }
        });
    }

    /* ==========================================================================
       وظائف التصميم الجديد:
       (لوحة استعراض المحاضرات، الفلاتر، ونافذة التفاصيل)
       ========================================================================== */
    (function () {
        "use strict";

        $(document).ready(function () {
            var btnPay = document.getElementById("btn_Pay");
            if (btnPay) btnPay.disabled = true;
        });

        function isSafeHttps(url) {
            if (!url || typeof url !== "string") return false;
            var trimmed = url.trim();
            if (!/^https:\/\/[^\s/$.?#].[^\s]*$/i.test(trimmed)) return false;
            try {
                var u = new URL(trimmed);
                return u.protocol === "https:";
            } catch (e) {
                return /^https:\/\//i.test(trimmed);
            }
        }

        function initStudentProgramsPage() {
            var datasetRoot = document.getElementById("subCoursesDataset");
            var coursesGrid = document.getElementById("subCoursesGrid");
            var lecturesList = document.getElementById("subLecturesList");
            var lecturesEmpty = document.getElementById("subLecturesEmpty");
            var selectedCourseTitle = document.getElementById("subSelectedCourseTitle");
            var filterPills = document.getElementById("subFilterPills");

            var modal = document.getElementById("subLectureModal");
            var modalPanel = document.getElementById("subModalPanel");
            var modalSubject = document.getElementById("subModalSubject");
            var modalTitle = document.getElementById("subModalTitle");
            var modalType = document.getElementById("subModalType");
            var modalTime = document.getElementById("subModalTime");
            var modalActions = document.getElementById("subModalActions");

            if (!datasetRoot) return;

            var courseNodes = datasetRoot.querySelectorAll(".sub-data-course");
            var coursesData = [];
            var allLecturesMap = {};

            for (var c = 0; c < courseNodes.length; c++) {
                var cNode = courseNodes[c];
                var cId = cNode.getAttribute("data-id") || "";
                var cName = cNode.getAttribute("data-name") || "دورة تعليمية";
                var cTeacher = cNode.getAttribute("data-teacher") || "";
                var cCount = parseInt(cNode.getAttribute("data-count") || "0", 10);

                var lecs = [];
                var lecNodes = cNode.querySelectorAll(".sub-data-lecture");
                for (var l = 0; l < lecNodes.length; l++) {
                    var lNode = lecNodes[l];
                    var item = {
                        id: lNode.getAttribute("data-id") || "",
                        categoryId: cId,
                        courseName: cName,
                        name: lNode.getAttribute("data-name") || "محاضرة بدون عنوان",
                        type: lNode.getAttribute("data-type") || "1",
                        dateTime: lNode.getAttribute("data-datetime") || "موعد غير محدد",
                        isEnd: lNode.getAttribute("data-is-end") === "1",
                        isFinish: lNode.getAttribute("data-is-finish") === "1",
                        validClient: lNode.getAttribute("data-valid-client") === "1",
                        clientUrl: lNode.getAttribute("data-client-url") || "",
                        validMedia: lNode.getAttribute("data-valid-media") === "1",
                        mediaUrl: lNode.getAttribute("data-media-url") || "",
                        hasDoc: lNode.getAttribute("data-has-doc") === "1",
                        docName: lNode.getAttribute("data-doc-name") || "",
                        docUrl: lNode.getAttribute("data-doc-url") || ""
                    };
                    lecs.push(item);
                    allLecturesMap[item.id] = item;
                }

                coursesData.push({
                    id: cId,
                    name: cName,
                    teacher: cTeacher,
                    count: cCount,
                    lectures: lecs
                });
            }

            var currentCategoryId = coursesData.length > 0 ? coursesData[0].id : null;
            var currentFilter = "all";
            var oldFocus = null;

            function renderLectures() {
                if (!lecturesList) return;

                while (lecturesList.firstChild) {
                    lecturesList.removeChild(lecturesList.firstChild);
                }

                var currentCourse = null;
                for (var i = 0; i < coursesData.length; i++) {
                    if (coursesData[i].id === currentCategoryId) {
                        currentCourse = coursesData[i];
                        break;
                    }
                }

                if (!currentCourse) {
                    if (lecturesEmpty) lecturesEmpty.style.display = "";
                    return;
                }

                if (selectedCourseTitle) {
                    selectedCourseTitle.textContent = currentCourse.name;
                }

                var filtered = [];
                for (var j = 0; j < currentCourse.lectures.length; j++) {
                    var lec = currentCourse.lectures[j];
                    if (currentFilter === "live" && lec.type !== "1") continue;
                    if (currentFilter === "recorded" && lec.type !== "0") continue;
                    filtered.push(lec);
                }

                if (filtered.length === 0) {
                    if (lecturesEmpty) lecturesEmpty.style.display = "";
                    return;
                }

                if (lecturesEmpty) lecturesEmpty.style.display = "none";

                for (var k = 0; k < filtered.length; k++) {
                    var lItem = filtered[k];

                    var row = document.createElement("article");
                    row.className = "sub-lec-row";
                    row.setAttribute("data-lecture-id", lItem.id);

                    var mainDiv = document.createElement("div");
                    mainDiv.className = "sub-lec-main";

                    var topDiv = document.createElement("div");
                    topDiv.className = "sub-lec-top";

                    var typeBadge = document.createElement("span");
                    if (lItem.type === "1") {
                        typeBadge.className = "sub-badge sub-badge-live";
                        typeBadge.innerHTML = '<i class="fas fa-broadcast-tower"></i> محاضرة مباشرة';
                    } else {
                        typeBadge.className = "sub-badge sub-badge-rec";
                        typeBadge.innerHTML = '<i class="fas fa-play-circle"></i> محاضرة مسجلة';
                    }
                    topDiv.appendChild(typeBadge);

                    if (lItem.isFinish) {
                        var finBadge = document.createElement("span");
                        finBadge.className = "sub-badge sub-badge-finished";
                        finBadge.innerHTML = '<i class="fas fa-check"></i> مكتملة';
                        topDiv.appendChild(finBadge);
                    }

                    mainDiv.appendChild(topDiv);

                    var h4 = document.createElement("h4");
                    h4.className = "sub-lec-title";
                    h4.textContent = lItem.name;
                    mainDiv.appendChild(h4);

                    var metaDiv = document.createElement("div");
                    metaDiv.className = "sub-lec-meta";

                    var timeSpan = document.createElement("span");
                    timeSpan.innerHTML = '<i class="far fa-clock"></i> ' + (lItem.dateTime || "موعد غير محدد");
                    metaDiv.appendChild(timeSpan);

                    if (lItem.hasDoc) {
                        var docSpan = document.createElement("span");
                        docSpan.innerHTML = '<i class="fas fa-paperclip"></i> يوجد مرفق تعليمي';
                        metaDiv.appendChild(docSpan);
                    }

                    mainDiv.appendChild(metaDiv);
                    row.appendChild(mainDiv);

                    var actionsDiv = document.createElement("div");
                    actionsDiv.className = "sub-lec-actions";

                    if (lItem.type === "1" && lItem.validClient && isSafeHttps(lItem.clientUrl)) {
                        var joinBtn = document.createElement("a");
                        joinBtn.href = lItem.clientUrl;
                        joinBtn.target = "_blank";
                        joinBtn.rel = "noopener noreferrer";
                        joinBtn.className = "sub-btn sub-btn-join";
                        joinBtn.innerHTML = '<i class="fas fa-video"></i> دخول المحاضرة';
                        actionsDiv.appendChild(joinBtn);
                    }

                    if (lItem.validMedia && isSafeHttps(lItem.mediaUrl)) {
                        var videoBtn = document.createElement("a");
                        videoBtn.href = lItem.mediaUrl;
                        videoBtn.target = "_blank";
                        videoBtn.rel = "noopener noreferrer";
                        videoBtn.className = "sub-btn sub-btn-video";
                        videoBtn.innerHTML = '<i class="fas fa-play"></i> مشاهدة الفيديو';
                        actionsDiv.appendChild(videoBtn);
                    }

                    if (lItem.hasDoc && lItem.docUrl && isSafeHttps(lItem.docUrl)) {
                        var docBtn = document.createElement("a");
                        docBtn.href = lItem.docUrl;
                        docBtn.target = "_blank";
                        docBtn.rel = "noopener noreferrer";
                        docBtn.className = "sub-btn sub-btn-doc";
                        docBtn.innerHTML = '<i class="fas fa-paperclip"></i> المرفق';
                        actionsDiv.appendChild(docBtn);
                    }

                    var detailsBtn = document.createElement("button");
                    detailsBtn.type = "button";
                    detailsBtn.className = "sub-btn sub-btn-details";
                    detailsBtn.setAttribute("data-lecture-id", lItem.id);
                    detailsBtn.innerHTML = '<i class="fas fa-info-circle"></i> التفاصيل';
                    actionsDiv.appendChild(detailsBtn);

                    row.appendChild(actionsDiv);
                    lecturesList.appendChild(row);
                }
            }

            function selectCourse(catId, scrollIntoView) {
                currentCategoryId = String(catId);
                var cards = coursesGrid ? coursesGrid.querySelectorAll(".sub-course-card") : [];
                for (var i = 0; i < cards.length; i++) {
                    var card = cards[i];
                    var isSelected = card.getAttribute("data-category-id") === currentCategoryId;
                    if (isSelected) {
                        card.classList.add("is-active");
                        card.setAttribute("aria-selected", "true");
                    } else {
                        card.classList.remove("is-active");
                        card.setAttribute("aria-selected", "false");
                    }
                }
                renderLectures();

                if (scrollIntoView) {
                    var panel = document.getElementById("subLecturesPanel");
                    if (panel) {
                        panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    }
                }
            }

            if (coursesGrid) {
                coursesGrid.addEventListener("click", function (e) {
                    var btnLec = e.target.closest(".sub-btn-lectures");
                    if (btnLec) {
                        e.stopPropagation();
                        var catIdLec = btnLec.getAttribute("data-category-id");
                        if (catIdLec) selectCourse(catIdLec, true);
                        return;
                    }

                    var card = e.target.closest(".sub-course-card");
                    if (card && !e.target.closest("a, button")) {
                        var catId = card.getAttribute("data-category-id");
                        if (catId) selectCourse(catId, false);
                    }
                });

                coursesGrid.addEventListener("keydown", function (e) {
                    if (e.key === "Enter" || e.key === " ") {
                        var card = e.target.closest(".sub-course-card");
                        if (card && !e.target.closest("a, button")) {
                            e.preventDefault();
                            var catId = card.getAttribute("data-category-id");
                            if (catId) selectCourse(catId, false);
                        }
                    }
                });
            }

            if (filterPills) {
                filterPills.addEventListener("click", function (e) {
                    var btn = e.target.closest(".sub-filter-pill");
                    if (btn) {
                        var filterVal = btn.getAttribute("data-filter") || "all";
                        var allPills = filterPills.querySelectorAll(".sub-filter-pill");
                        for (var p = 0; p < allPills.length; p++) {
                            allPills[p].classList.remove("is-active");
                        }
                        btn.classList.add("is-active");
                        currentFilter = filterVal;
                        renderLectures();
                    }
                });
            }

            function openLectureModal(lec) {
                if (!lec || !modal || !modalPanel) return;
                oldFocus = document.activeElement;

                if (modalSubject) modalSubject.textContent = lec.courseName;
                if (modalTitle) modalTitle.textContent = lec.name;
                if (modalType) modalType.textContent = lec.type === "1" ? "محاضرة مباشرة" : "محاضرة مسجلة";
                if (modalTime) modalTime.textContent = lec.dateTime;

                if (modalActions) {
                    while (modalActions.firstChild) {
                        modalActions.removeChild(modalActions.firstChild);
                    }

                    if (lec.type === "1" && lec.validClient && isSafeHttps(lec.clientUrl)) {
                        var aJoin = document.createElement("a");
                        aJoin.href = lec.clientUrl;
                        aJoin.target = "_blank";
                        aJoin.rel = "noopener noreferrer";
                        aJoin.className = "sub-btn sub-btn-join";
                        aJoin.innerHTML = '<i class="fas fa-video"></i> دخول المحاضرة المباشرة';
                        modalActions.appendChild(aJoin);
                    }

                    if (lec.validMedia && isSafeHttps(lec.mediaUrl)) {
                        var aVideo = document.createElement("a");
                        aVideo.href = lec.mediaUrl;
                        aVideo.target = "_blank";
                        aVideo.rel = "noopener noreferrer";
                        aVideo.className = "sub-btn sub-btn-video";
                        aVideo.innerHTML = '<i class="fas fa-play"></i> مشاهدة الفيديو المسجل';
                        modalActions.appendChild(aVideo);
                    }

                    if (lec.hasDoc && lec.docUrl && isSafeHttps(lec.docUrl)) {
                        var aDoc = document.createElement("a");
                        aDoc.href = lec.docUrl;
                        aDoc.target = "_blank";
                        aDoc.rel = "noopener noreferrer";
                        aDoc.className = "sub-btn sub-btn-doc";
                        aDoc.innerHTML = '<i class="fas fa-paperclip"></i> فتح المرفق التعليمي';
                        modalActions.appendChild(aDoc);
                    }
                }

                modal.hidden = false;
                modalPanel.focus();
            }

            function closeLectureModal() {
                if (!modal || modal.hidden) return;
                modal.hidden = true;
                if (oldFocus && document.contains(oldFocus) && typeof oldFocus.focus === "function") {
                    oldFocus.focus();
                }
                oldFocus = null;
            }

            document.addEventListener("click", function (e) {
                var closeTarget = e.target.closest("[data-sub-modal-close]");
                if (closeTarget && modal && modal.contains(closeTarget)) {
                    closeLectureModal();
                    return;
                }

                var detailsTarget = e.target.closest(".sub-btn-details, .sub-lec-row");
                if (detailsTarget && !e.target.closest("a")) {
                    var lecId = detailsTarget.getAttribute("data-lecture-id");
                    if (lecId && allLecturesMap[lecId]) {
                        openLectureModal(allLecturesMap[lecId]);
                    }
                }
            });

            document.addEventListener("keydown", function (e) {
                if (e.key === "Escape" && modal && !modal.hidden) {
                    e.preventDefault();
                    closeLectureModal();
                }
            });

            renderLectures();
        }

        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", initStudentProgramsPage);
        } else {
            initStudentProgramsPage();
        }
    })();
</script>
