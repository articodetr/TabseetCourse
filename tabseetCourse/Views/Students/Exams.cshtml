                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <label>درجة الامتحان</label><br />
                <a id="Exam_Windegry"></a><br />

                <label>درجة الطالب</label>
                <a id="Exam_degry"></a><br />
            </div>
            <div class="modal-footer justify-content-between">
                <button type="button" class="btn btn-outline-light" onclick="btnOkAssingment()" data-dismiss="modal">OK</button>
            </div>
        </div>
        <!-- /.modal-content -->
    </div>
    <!-- /.modal-dialog -->
</div>
<div class="modal fade" id="modal-danger" style="text-align:right" dir="rtl">
    <div class="modal-dialog">
        <div class="modal-content bg-danger">
            <div class="modal-header">
                <h4 class="modal-title">نتيجة الامتحان</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <label>نرجو إعادة  الامتحان</label><br />
                <label>درجة الامتحان</label><br />
                <a id="SExam_degry"></a><br />
                <label>درجة الطالب</label><br />
                <a id="SExam_Windegry"></a>
            </div>
            <div class="modal-footer justify-content-between">
                <button type="button" class="btn btn-outline-light" onclick="btnOkAssingment()" data-dismiss="modal">OK</button>
                @*<button type="button" class="btn btn-outline-light">Save changes</button>*@
            </div>
        </div>
        <!-- /.modal-content -->
    </div>
    <!-- /.modal-dialog -->
</div>
<script src="~/Content/plugins/jquery-ui/jquery-ui.min.js"></script>
<script src="~/Scripts/CustomJavascript.js"></script>
<script>

    var isLoading = false;

    $(document).ready(function () {

        $(".menu_top").addClass("fixed");


        $(function () {
            $('.tabs-nav a').click(function () {

                // Check for active
                $('.tabs-nav li').removeClass('active');
                $(this).parent().addClass('active');

                // Display active tab
                var currentTab = $(this).attr('href');
                $('.tabs-content div.tab_cont').hide();
                $(currentTab).show();

                return false;
            });
        });

    });


</script>
<script>

    const FULL_DASH_ARRAY = 283;
    let timePassed = 0;
    let TIME_LIMIT = 0;
    let timeLeft = TIME_LIMIT;
    let timerInterval = null;
    const ALERT_THRESHOLD = 5;
    const WARNING_THRESHOLD = 10;
    const COLOR_CODES = {
        info: {
            color: "green"
        },
        warning: {
            color: "orange",
            threshold: WARNING_THRESHOLD
        },
        alert: {
            color: "red",
            threshold: ALERT_THRESHOLD
        }
    };

    let remainingPathColor = COLOR_CODES.info.color;
    $(document).ready(function () {

        var exID = $('#Exam_ID').val();

        $.ajax(
            {
                async: true,
                type: 'POST',
                data: { Exam_ID: exID},
                url: '@Url.Action("GetExamQuestion", "Students")',
                success: function (data) {
                    $("#Submet_ID").val(data.length);
                    var s = '';
                    for (var i = 0; i < data.length; i++) {
                        s += '<div class="border" id="Div_ID_'+i+'">' +
                            '<div class="question bg-white p-3 border-bottom" style="background-color:#113464;/* float: left; */text-align: start;direction: rtl;">' +
                            '<div class="d-flex flex-row justify-content-between align-items-center mcq">' +
                            '<input type="text" id="Q_ID_' + i +'" hidden="hidden"/>'+
                            '<h4>' + data[i].Q_Name + '</h4><span style="direction:ltr;">(' + (i + 1) + ' of ' + data.length + ')</span>' +
                            '</div>' +
                            '</div>' +
                            '<div class="question bg-white p-3 border-bottom">' +
                            '<div class="d-flex flex-row align-items-center question-title" style="direction:rtl;">' +
                            '<h3 class="text-danger"></h3>' +
                            '<h5 class="mt-1 ml-2">' + data[i].Q_Text + '</h5>' +
                            '</div>';
                        if (data[i].Type == 3) {
                            s += '<div class="ans ml-2" style="direction:rtl;display:flex;">' +
                                '<table>';
                            for (var j = 0; j < data[i].Q_MatchingChoise.length; j++) {
                                s += '<tr><td>' +
                                    '<input type="hidden" name="CorrectAnswer" id="CorrectAnswer_' + data[i].Q_MatchingChoise[j].ID + '" />' +
                                    '<input type="hidden" id="degryMart_' + data[i].Q_MatchingChoise[j].ID + '" value="' + data[i].Q_MatchingChoise[j].Degry + '" />' +
                                    '<input type="text" value="' + data[i].Q_MatchingChoise[j].ChoiceText + '" disabled id="ChoiceText_' + data[i].Q_MatchingChoise[j].ID + '" class="form-control" />' +
                                    '</td>' +
                                    '<td>' +
                                    '<select id="ChoiseTrueAnswer_' + data[i].Q_MatchingChoise[j].ID + '" onchange="CheackIfAnswerTrue(this.value,' + data[i].Q_MatchingChoise[j].ID + ')"  class="form-control">';
                                s += '<option value="-1">اختر الجواب الصحيح</option>';
                                var rand = createArrayOfNumbers(0, data[i].Q_MatchingChoise.length - 1);

                                for (var k = 0; k < data[i].Q_MatchingChoise.length; k++) {
                                    var number = GenerateRundomNumberBetweenRange(rand);

                                    s += '<option value="' + data[i].Q_MatchingChoise[number].ID + '">' + data[i].Q_MatchingChoise[number].ChoiseTrueAnswer + '</option>';
                                }


                                s += '</select>' +
                                    '</td>' +
                                    '</tr>';

                            }
                            s += '</table>';


                            s += '</div>';
                        }
                        if (data[i].Type == 2) {
                            for (var j = 0; j < data[i].Q_MultiChoice.length; j++) {
                                s += '<div class="ans ml-2" style="direction:rtl;display:flex;">' +
                                    '<label class="radio">' +
                                    '<input type="radio" name="QA_' + i + '" value="' + data[i].Q_MultiChoice[j].Degry + '"> <span>' + data[i].Q_MultiChoice[j].Choose + '</span>' +
                                    '</label>' +
                                    '</div>';
                            }
                        }
                        if (data[i].Type==1)
                        {
                            if (data[i].Q_TrueOrFalse.TrueValue == 1) {
                                s += '<div class="ans ml-2" style="direction:rtl;display:flex;">' +
                                    '<label class="radio">' +
                                    '<input type="radio" name="QA_' + i + '" value="' + data[i].Q_TrueOrFalse.Degry + '"> <span>صح</span>' +
                                    '</label>' +
                                    '</div>' +
                                    '<div class="ans ml-2" style="direction:rtl;display:flex;">' +
                                    '<label class="radio">' +
                                    '<input type="radio" name="QA_' + i + '" value="0"> <span>خطأ</span>' +
                                    '</label>' +
                                    '</div>';
                            }
                            else {
                                s += '<div class="ans ml-2" style="direction:rtl;display:flex;">' +
                                    '<label class="radio">' +
                                    '<input type="radio" name="QA_' + i + '" value="' + data[i].Q_TrueOrFalse.Degry + '"> <span>خطأ</span>' +
                                    '</label>' +
                                    '</div>' +
                                    '<div class="ans ml-2" style="direction:rtl;display:flex;">' +
                                    '<label class="radio">' +
                                    '<input type="radio" name="QA_' + i + '" value="0"> <span>صح</span>' +
                                    '</label>' +
                                    '</div>';
                            }
                        }


                        s += '</div>' +
                            '<div class="d-flex flex-row justify-content-between align-items-center p-3 bg-white" style="direction:rtl">';
                        if (i == 0) {
                            s += '<button class="btn btn-primary d-flex align-items-center btn-danger" disabled="disabled" id="Btnback" onclick="Back_Question(' + (i - 1) + ')" type="button">' +
                                '<i class="fa fa-angle-right mt-1 mr-1"></i>&nbsp;&nbsp;السابق&nbsp;&nbsp;</button>';
                        } else {
                            s += '<button class="btn btn-primary d-flex align-items-center btn-danger" id="Btnback" onclick="Back_Question(' + (i - 1) + ')" type="button">' +
                                '<i class="fa fa-angle-right mt-1 mr-1"></i>&nbsp;&nbsp;السابق&nbsp;&nbsp;</button>';
                        }
                        if (i == data.length - 1) {
                            s +=  `<input type="button" value="انهاء" onclick="EndAssingnment()" class="btn btn-success float-right">`;
                        } else {
                            s += '<button class="btn btn-primary border-success align-items-center btn-success" id="BtnNext" onclick="Next_Question(' + (i + 1) +')" type="button">&nbsp;&nbsp;التالي&nbsp;&nbsp; <i class="fa fa-angle-left ml-2"></i>' +
                                '</button>'
                        }
                            s += '</div></div>';
                    }
                    $("#QuestionBody_ID").html(s);

                    $("#Btnback").attr("disabled", true);
                    $("#Div_ID_0").show();
                    for (var i = 1; i < data.length; i++) {
                        $("#Div_ID_" + i).hide();

                    }


                    var inttime = $("#Exam_Duration").val();;
                    TIME_LIMIT = inttime * 60 * 60;
                    document.getElementById("app").innerHTML = `
<div class="base-timer">
  <svg class="base-timer__svg" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
    <g class="base-timer__circle">
      <circle class="base-timer__path-elapsed" cx="50" cy="50" r="45"></circle>
      <path
        id="base-timer-path-remaining"
        stroke-dasharray="283"
        class="base-timer__path-remaining ${remainingPathColor}"
        d="
          M 50, 50
          m -45, 0
          a 45,45 0 1,0 90,0
          a 45,45 0 1,0 -90,0
        "
      ></path>
    </g>
  </svg>
  <span id="base-timer-label" class="base-timer__label">${formatTime(
                        timeLeft
                    )}</span>
</div>
`;
                    startTimer();
                },
                error: function (response) {
                    alert("the problem is " + response.responseText);
                },
                complete: function (response) {

                }
            });
    });
    function onTimesUp() {
        clearInterval(timerInterval);
        ForeceEndAssingnment();
    }

    function startTimer() {
        timerInterval = setInterval(() => {
            timePassed = timePassed += 1;
            timeLeft = TIME_LIMIT - timePassed;
            document.getElementById("base-timer-label").innerHTML = formatTime(
                timeLeft
            );
            setCircleDasharray();
            setRemainingPathColor(timeLeft);

            if (timeLeft === 0) {
                onTimesUp();
            }
        }, 1000);
    }

    function formatTime(time) {
        const minutes = Math.floor(time / 60);
        let seconds = time % 60;

        if (seconds < 10) {
            seconds = `0${seconds}`;
        }

        return `${minutes}:${seconds}`;
    }

    function setRemainingPathColor(timeLeft) {
        const { alert, warning, info } = COLOR_CODES;
        if (timeLeft <= alert.threshold) {
            document
                .getElementById("base-timer-path-remaining")
                .classList.remove(warning.color);
            document
                .getElementById("base-timer-path-remaining")
                .classList.add(alert.color);
        } else if (timeLeft <= warning.threshold) {
            document
                .getElementById("base-timer-path-remaining")
                .classList.remove(info.color);
            document
                .getElementById("base-timer-path-remaining")
                .classList.add(warning.color);
        }
    }

    function calculateTimeFraction() {
        const rawTimeFraction = timeLeft / TIME_LIMIT;
        return rawTimeFraction - (1 / TIME_LIMIT) * (1 - rawTimeFraction);
    }
    function CheackIfAnswerTrue(selectedvalue, id) {
        console.log(selectedvalue);
        console.log(id);
        if (selectedvalue == id) {
            var degry = $("#degryMart_" + id).val();
            $("#CorrectAnswer_" + id).val(degry);

        } else
            $("#CorrectAnswer_" + id).val(0);
    }
    function setCircleDasharray() {
        const circleDasharray = `${(
            calculateTimeFraction() * FULL_DASH_ARRAY
        ).toFixed(0)} 283`;
        document
            .getElementById("base-timer-path-remaining")
            .setAttribute("stroke-dasharray", circleDasharray);
    }
    function Next_Question(index) {
        $("#Div_ID_" + index).show();
        $("#Div_ID_" + (index - 1)).hide();
    }

    function Back_Question(index) {
        $("#Div_ID_" + (index+1)).hide();
        $("#Div_ID_" + index).show();
    }

    function ForeceEndAssingnment()
    {

            var Exam_ID = $('#Exam_ID').val();
            var Length = $("#Submet_ID").val();

            var selectedGender = new Array();

            for (var i = 0; i < Length; i++) {
                var genders = document.getElementsByName('QA_' + i);
                for (var j = 0; j < genders.length; j++) {
                    if (genders[j].checked) {
                        selectedGender.push(genders[j].value);
                    }
                }

            }
        var correctmatching = document.getElementsByName('CorrectAnswer');
        for (var i = 0; i < correctmatching.length; i++) {

            selectedGender.push(correctmatching[i].value);

        }

            $.ajax({
                    async: true,
                    type: 'POST',
                data: { L_Degry: selectedGender, Exam_ID: Exam_ID },
                    url: '@Url.Action("SubmetExamQuestion", "Students")',
                success: function (result) {
                    //$("#Exam_degry").html(result.Assdegry);
                    //$("#Exam_Windegry").html(result.WinDegry)
                    //$("#modal-success").modal()

                    if (result.success == true) {
                        console.log("true");
                        $("#Exam_degry").html(result.Assdegry);
                        $("#Exam_Windegry").html(result.stdDegry)

                        $("#modal-success").modal()
                    } else {
                        console.log("true");
                        $("#SExam_degry").html(result.Assdegry);
                        $("#SExam_Windegry").html(result.stdDegry)
                        $("#modal-danger").modal();
                    }
                },
                error: function (response) {
                },
                complete: function (response) {
                }
            });

    }

      function EndAssingnment()
      {
          const swalWithBootstrapButtons = Swal.mixin({
              customClass: {
                  confirmButton: 'btn btn-success',
                  cancelButton: 'btn btn-danger'
              },
              buttonsStyling: false
          });

          swalWithBootstrapButtons.fire({
              title: 'تحذير؟',
              text: "هل أنت متأكد من الإنهاء ؟",
              icon: 'warning',
              showCancelButton: true,
              confirmButtonText: 'نعم',
              cancelButtonText: 'إلغاء',
              reverseButtons: true
          }).then((result) => {
              if (result.isConfirmed) {

                  var Exam_ID = $('#Exam_ID').val();
                  var Length = $("#Submet_ID").val();

                  var selectedGender = new Array();

                  for (var i = 0; i < Length; i++) {
                      var genders = document.getElementsByName('QA_' + i);
                      for (var j = 0; j < genders.length; j++) {
                          if (genders[j].checked) {
                              selectedGender.push(genders[j].value);
                          }
                      }

                  }
                  var correctmatching = document.getElementsByName('CorrectAnswer');
                  for (var i = 0; i < correctmatching.length; i++) {

                      selectedGender.push(correctmatching[i].value);

                  }
                  $.ajax({
                      async: true,
                      type: 'POST',
                      data: { L_Degry: selectedGender, Exam_ID: Exam_ID },
                      url: '@Url.Action("SubmetExamQuestion", "Students")',
                      success: function (result) {
                          if (result.success == true) {
                              console.log("true");
                              $("#Exam_Windegry").html(result.Assdegry);
                              $("#Exam_degry").html(result.WinDegry);

                              $("#modal-success").modal();
                          } else {
                              console.log("false");
                              console.log(result.Assdegry);
                              console.log(result.WinDegry);
                              $("#SExam_degry").html(result.Assdegry);
                              $("#SExam_Windegry").html(result.WinDegry);
                              $("#modal-danger").modal();

                          }
                      },
                      error: function (response) {
                      },
                      complete: function (response) {
                      }
                  });
              }
          });
    }
    function btnOkAssingment() {
        window.location.href = "@Url.Action("Certfications", "Students")";
    }

</script>
