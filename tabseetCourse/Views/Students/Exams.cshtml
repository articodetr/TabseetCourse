
@{
    ViewBag.Title = "Exams";
    Layout = "~/Views/Shared/_LayoutStudent.cshtml";
}

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.2.1/jquery.min.js"></script>
<script src="~/Content2/bootstrap4/bootstrap.min.js" type="text/javascript"></script>
<script src="//cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<style>


    .base-timer {
        position: relative;
        width: 70px;
        height: 70px;
    }

    .base-timer__svg {
        transform: scaleX(-1);
    }

    .base-timer__circle {
        fill: none;
        stroke: none;
    }

    .base-timer__path-elapsed {
        stroke-width: 7px;
        stroke: grey;
    }

    .base-timer__path-remaining {
        stroke-width: 7px;
        stroke-linecap: round;
        transform: rotate(90deg);
        transform-origin: center;
        transition: 1s linear all;
        fill-rule: nonzero;
        stroke: currentColor;
    }

        .base-timer__path-remaining.green {
            color: rgb(65, 184, 131);
        }

        .base-timer__path-remaining.orange {
            color: orange;
        }

        .base-timer__path-remaining.red {
            color: red;
        }

    .base-timer__label {
        position: absolute;
        width: 70px;
        height: 70px;
        top: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
    }
</style>

<div class="sec_content padding_menu cours_details" style="direction:rtl">
    <div class="container">


        <div class="col-md-12 float-left">
            <section class="content-header">
                <div class="container-fluid">
                    <div class="row mb-2">

                        <div class="col-sm-6">
                            <table width="100%">
                                <tr>
                                    <td width="50%"><h1> أسئلة الامتحان</h1></td>

                                    <td><label>الوقت المتبقي</label></td>
                                    <td width="35%">
                                        <div id="app"></div>
                                    </td>
                                </tr>
                            </table>

                        </div>
                        <div class="col-sm-6">

                        </div>
                    </div>
                </div><!-- /.container-fluid -->
            </section>

        </div>

    </div>
</div>

<div class="card">
    <input type="text" value="@ViewBag.examID" hidden="hidden" id="Exam_ID" />
    <input type="text" value="@ViewBag.examTime" hidden="hidden" id="Exam_Duration" />

    <div class="card-header" style="background-color:#113464">

        <input type="text" hidden="hidden" id="Submet_ID" />

    </div>
    <!-- /.card-header -->

    <div class="container mt-5">
        <div class="d-flex justify-content-center row">
            <div class="col-md-10 col-lg-10" id="QuestionBody_ID">

            </div>
        </div>
    </div>


    <!-- /.card-body -->
</div>
<!-- Modal -->
