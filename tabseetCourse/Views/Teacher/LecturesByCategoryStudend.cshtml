        if (LictureLink_ID === "") {
            if (LectureType_ID === "0" && fileCheck.hasFile && fileCheck.isPdf) {
                $("#ElectureLinkError").text("ملف PDF المرفق مخصص للمرفقات التعليمية الإضافية فقط ولا يُعتبر بديلًا عن رابط فيديو المحاضرة المسجلة (HTTPS).").show();
            } else {
                $("#ElectureLinkError").text("").hide();
            }
        } else if (!linkCheck.valid) {
            if (linkCheck.reason === "pdf_link") {
                $("#ElectureLinkError").text("ملف PDF لا يُعتبر مصدرًا للمحاضرة؛ يرجى إدخال رابط محاضرة أو فيديو صالح بصيغة HTTPS.").show();
            } else if (linkCheck.reason === "youtube") {
                $("#ElectureLinkError").text("رابط YouTube غير صالح: " + linkCheck.message).show();
            } else {
                $("#ElectureLinkError").text("يرجى إدخال رابط HTTPS صالح ومكتمل (مثال: https://...).").show();
            }
        } else {
            $("#ElectureLinkError").text("").hide();
        }

        var isValid = false;
        if (LectureType_ID === "1") {
            isValid = (LectureName_ID !== "" && DateTime_ID !== "" && linkCheck.valid && fileCheck.validAttachment);
        } else {
            isValid = (LectureName_ID !== "" && (linkCheck.valid || hasSupportedVideoFile) && fileCheck.validAttachment);
        }

        document.getElementById("btnUpdate").disabled = !isValid;
    }
