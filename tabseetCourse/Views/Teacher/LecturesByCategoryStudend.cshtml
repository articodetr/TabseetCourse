                                    <div class="form-group">
                                        <label>نوع </label>
                                        <select id="ELectureType_ID" class="form-control" onchange="TypeChangeEdit(this.value)" required>
                                            <option value="1">مباشر</option>
                                            <option value="0">مسجلة</option>
