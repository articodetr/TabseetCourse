                                data.response || 'فشل حذف المحاضرة.',
                                'error'
                            );
                        }
                    },
                    error: function (response) {
                        var msg = (response.responseJSON && (response.responseJSON.response || response.responseJSON.responseText)) || response.responseText || 'حدث خطأ أثناء الحذف';
                        swalWithBootstrapButtons.fire(
                            'فشل',
                            msg,
