<!-- Page specific script -->
<script>

    $(document).ready(function () {
        document.getElementById("btnSave").disabled = true;
        document.getElementById("btnUpdate").disabled = true;
        TypeChange($("#LectureType_ID").val());
        GetLecture();
    });

    function GetLecture() {
        $("#LectureDIV_ID").show();
        $("#DivTime_ID").show();
        $("#UploadFileDiv_ID").show();
        $("#LinkDIV_ID").hide();
        $("#ELectureDIV_ID").show();
        $("#EUploadFileDiv_ID").show();
        $("#ELinkDIV_ID").hide();
        $("#LectureDivMiniTime_ID").hide();
        $("#ELectureDivMiniTime_ID").hide();

        var cat_ID = $("#CategoryID").val();
        $.ajax(
            {
                async: true,
                type: 'POST',
                data: { Cat_ID: cat_ID },
                url: '@Url.Action("LectureByCategorysStd", "Teacher")',
                success: function (data) {
                    var s = '';
                    for (var i = 0; i < data.length; i++) {
                        s += '<tr>' +
                            '<td>' + data[i].ID + '</td>' +
                            '<td>' + data[i].Lecture_Name + '</td>' +
                            '<td>' + data[i].NameAr + '</td>';
                        if (data[i].LectureTypeOnOff == 1) {
                            if (data[i].LectureLink_Host) {
                                s += '<td>مباشر</td>' +
                                    '<td><a href="' + data[i].LectureLink_Host + '" target="_blank"> للمحاضر  </a>/<a href="' + data[i].LectureLink_Client + '" target="_blank">  للطالب </a></td>';
                            } else {
                                s += '<td>مباشر</td>' +
                                    '<td><a href="' + data[i].LectureLink_Client + '" target="_blank"> رابط المحاضرة المباشرة </a></td>';
                            }
                        } else {
                            s += '<td>مسجلة</td>' +
                                '<td><a href="' + (data[i].LectureLink_Client || '#') + '" target="_blank"> رابط المحاضرة المسجلة </a></td>';
                        }

                                                // Status badge column
                        var statusBadge = '';
                        if (data[i].Status === 'Completed') {
                            statusBadge = '<span class="badge badge-success p-2" title="' + (data[i].ActualCompletionDateFormatted || '') + '"><i class="fas fa-check-circle ml-1"></i> مكتملة</span>';
                        } else if (data[i].Status === 'Postponed') {
                            statusBadge = '<span class="badge badge-warning p-2" title="' + (data[i].PostponeReason || '') + '"><i class="fas fa-clock ml-1"></i> مؤجلة</span>';
                        } else {
                            statusBadge = '<span class="badge badge-secondary p-2"><i class="fas fa-calendar-alt ml-1"></i> مجدولة</span>';
                        }
                        s += '<td>' + statusBadge + '</td>';

                        var safeLecName = (data[i].Lecture_Name || '').replace(/'/g, "\\'").replace(/"/g, '&quot;');
                        var statusBtns = '';
                        if (data[i].Status !== 'Completed') {
                            statusBtns = '<button class="btn btn-success" title="تأكيد إكمال الدرس" onclick="openCompleteLessonModal(' + data[i].ID + ', \'' + safeLecName + '\')">' +
                                '<i class="fas fa-check ml-1"></i> تم إكمال الدرس' +
                                '</button>' +
                                '<button class="btn btn-warning" title="تأجيل المحاضرة" onclick="openPostponeLessonModal(' + data[i].ID + ', \'' + safeLecName + '\')">' +
                                '<i class="fas fa-pause ml-1"></i> تأجيل' +
                                '</button>';
                        } else {
                            statusBtns = '<button class="btn btn-outline-secondary" title="إعادة فتح وتصحيح الحالة" onclick="openReopenLessonModal(' + data[i].ID + ', \'' + safeLecName + '\')">' +
                                '<i class="fas fa-undo ml-1"></i> تصحيح الحالة' +
                                '</button>';
                        }

                        var attendanceBtn = '<button class="btn btn-secondary" title="حضور الطلاب في هذه المحاضرة" onclick="openAttendanceModal(' + data[i].ID + ', \'' + safeLecName + '\')">' +
                            '<i class="fas fa-user-check ml-1"></i> الحضور' +
                            '</button>';

                        s += '<td>' +
                            '<div class="btn-group">' +
                            attendanceBtn +
                            statusBtns +
                            '<button class="btn btn-info" onclick="GetLectureByID(' + data[i].ID + ')" data-toggle="modal" data-target="#EditModal">' +
                            '<i class="fas fa-edit">' +
                            '</i>' +
                            'تعديل' +
                            '</button>' +
                            '<button class="btn btn-danger" onclick = "btnDelete(' + data[i].ID + ')" >' +
                            '<i class="fas fa-trash">' +
                            '</i>' +
                            'حذف' +
                            '</button>';
                        // الوظيفة (الاختبار) متاحة للمحاضرات المسجلة والمباشرة معاً؛ في المباشرة تُتاح للطالب بعد تسجيل دخوله إليها
                        if (data[i].Count > 0) {
                            s += '<button class="btn btn-primary" onclick="ViewAssingment(' + data[i].ID + ')">' +
                                '<i class="nav-icon fas fa-book">' +
                                '</i>' +
                                'عرض الوظيفة' +
                                '</button>';
                        } else {
                            s += '<button class="btn btn-default" onclick="addassignment(' + data[i].ID + ')">' +
                                '<i class="nav-icon fas fa-book">' +
                                '</i>' +
                                'اضافة وظيفة' +
                                '</button>';
                        }
                        s += '</div>' +
                             '</td>' +
                             '</tr>';
                    }
                    $("#tableContent_ID").html(s);
                },
                error: function (response) {
                    var msg = (response.responseJSON && (response.responseJSON.response || response.responseJSON.responseText)) || response.responseText || 'حدث خطأ في جلب المحاضرات';
                    Swal.fire({
                        title: 'خطأ',
                        text: msg,
                        icon: 'error'
                    });
                },
                complete: function (response) {
                    if ($.fn.DataTable.isDataTable('#example1')) {
                        $('#example1').DataTable().destroy();
                    }
                    $('#example1').DataTable({
                        "paging": true,
                        "lengthChange": true,
                        "searching": true,
                        "ordering": true,
                        "info": true,
                        "autoWidth": true,
                        "responsive": true,
                        "buttons": ["copy", "excel", "pdf", "print", "colvis"]
                    }).buttons().container().appendTo('#example1_wrapper .col-md-6:eq(0)');
                }
            });
    }

    function extractLectureUrl(rawInput, lectureType) {
        var url = (rawInput || "").trim();
        if (String(lectureType) === "0" && url.toLowerCase().indexOf("<iframe") !== -1 && url.toLowerCase().indexOf("src=") !== -1) {
            var match = url.match(/src\s*=\s*["']([^"']+)["']/i);
            if (match && match[1]) {
                url = match[1].trim();
            }
        }
        // المحاضرة المسجلة: أي رابط YouTube مدعوم (watch / youtu.be / shorts / live / embed / الجوال) يُحوَّل إلى رابط مشاهدة موحد
        if (String(lectureType) === "0" && window.TabseetYouTube) {
            var yt = TabseetYouTube.parse(url);
            if (yt.isYouTube && yt.valid) {
                url = yt.watchUrl;
            }
        }
        return url;
    }

    // حماية من الإرسال المزدوج (تجنب تكرار المحاضرة عند الضغط أكثر من مرة)
    function acquireBusy(btnId) {
        var btn = document.getElementById(btnId);
        if (!btn || btn.getAttribute("data-busy") === "1") return false;
        btn.setAttribute("data-busy", "1");
        btn.disabled = true;
        return true;
    }

    function releaseBusy(btnId) {
        var btn = document.getElementById(btnId);
        if (!btn) return;
        btn.removeAttribute("data-busy");
        btn.disabled = false;
    }

    function isValidHttpsLectureUrl(rawInput, lectureType) {
        var url = extractLectureUrl(rawInput, lectureType);
        if (!url) {
            return { valid: false, reason: "empty", url: "" };
        }
        if (String(lectureType) === "0" && window.TabseetYouTube) {
            var ytCheck = TabseetYouTube.parse(url);
            if (ytCheck.isYouTube && !ytCheck.valid) {
                return { valid: false, reason: "youtube", url: url, message: ytCheck.error };
            }
        }
        try {
            var parsed = new URL(url);
            if (parsed.protocol !== "https:") {
                return { valid: false, reason: "protocol", url: url };
            }
            var host = (parsed.hostname || "").toLowerCase();
            if (!host || host === "localhost" || host.endsWith(".localhost") || host.indexOf(".") === -1 || host.startsWith(".") || host.endsWith(".")) {
                return { valid: false, reason: "host", url: url };
            }
            if (/^(127\.|10\.|192\.168\.|169\.254\.|172\.(1[6-9]|2[0-9]|3[0-1])\.)/.test(host) || host === "0.0.0.0" || host === "[::1]") {
                return { valid: false, reason: "private_ip", url: url };
            }
            if ((parsed.pathname || "").toLowerCase().endsWith(".pdf")) {
                return { valid: false, reason: "pdf_link", url: url };
            }
            return { valid: true, reason: "ok", url: parsed.href };
        } catch (e) {
            return { valid: false, reason: "invalid_url", url: url };
        }
    }

    function checkAttachmentFile(fileInputSelector) {
        var inputEl = $(fileInputSelector)[0];
        if (!inputEl || !inputEl.files || inputEl.files.length === 0) {
            return { hasFile: false, isPdf: false, isVideo: false, validAttachment: true, error: "" };
        }
        var file = inputEl.files[0];
        var fileName = (file.name || "").toLowerCase();
        var mimeType = (file.type || "").toLowerCase();
        var videoExts = [".mp4", ".mov", ".avi", ".mkv", ".webm", ".wmv", ".flv", ".m4v", ".mpeg", ".mpg", ".3gp"];
        var isVideoExt = videoExts.some(function (ext) { return fileName.endsWith(ext); });

        if (mimeType.indexOf("video/") === 0 || isVideoExt) {
            return {
                hasFile: true,
                isPdf: false,
                isVideo: true,
                validAttachment: false,
                error: "رفع ملفات الفيديو غير مدعوم حاليًا. هذا الحقل مخصص لملفات PDF التعليمية المرفقة فقط، ويجب إدخال رابط فيديو HTTPS للمحاضرة."
            };
        }

        var isPdfExt = fileName.endsWith(".pdf");
        var isPdfMime = (!mimeType || mimeType === "application/pdf" || mimeType === "application/x-pdf" || mimeType === "application/octet-stream");
        if (!isPdfExt || !isPdfMime) {
            return {
                hasFile: true,
                isPdf: false,
                isVideo: false,
                validAttachment: false,
                error: "يُسمح فقط برفع ملفات PDF (.pdf) كمرفقات تعليمية إضافية."
            };
        }

        return { hasFile: true, isPdf: true, isVideo: false, validAttachment: true, error: "" };
    }

