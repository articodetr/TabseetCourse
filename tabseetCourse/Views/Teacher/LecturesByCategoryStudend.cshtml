                            <div class="row">
                                <div class="col-sm-12" id="ELectureDivMiniTime_ID">
                                    <div class="form-group">
                                        <label> الوقت الاصغري للحضور بلدقيقة</label>
                                        <input type="number" id="ELictureMiniTime_ID" class="form-control" min="0" max="90" value="0" oninput="validationEdit()" onchange="validationEdit()" style="width:100%" placeholder="Mini Time" />
