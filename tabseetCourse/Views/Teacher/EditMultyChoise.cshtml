
@{
    ViewBag.Title = "EditMultyChoise";
    Layout = "~/Views/Shared/_TeacherLayout.cshtml";
}

<link rel="stylesheet" href="~/Content/plugins/summernote/summernote-bs4.css" />
<script src="//cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>إضافة سؤال من نمط إختيار من متعدد</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                </ol>
            </div>
        </div>
    </div><!-- /.container-fluid -->
</section>
<div class="card">

    <div class="card-body">
        <input type="text" value="@ViewBag.question_ID" id="Quesion_ID" class="form-control" hidden="hidden" />



        <div class="form-horizontal">

            <hr />
            <div class="form-group">
                <label class="control-label col-md-2">إسم السؤال</label>
                <div class="col-md-10">
                    <input type="text" class="form-control" id="Q_Name" style="width:60%" />

                </div>
                <br />
                <div class="col-md-12">
                    <label class="control-label ">الفئة</label>
                </div>
                <div class="col-md-12">
                    <select class="form-control select2" id="Category_ID" style="width:50%;height:50%">
                    </select>
                </div>
            </div>

            <div class="form-group">
                <label class="control-label col-md-2">صيغة السؤال</label>
                <div class="col-md-10">
                    <div id="Summner_Q_Text" class="summernote">

                    </div>
                    <input type="text" class="form-control" id="Q_Text" hidden="hidden" />
                    @*@Html.ValidationMessageFor(model => model.Q_Text, "", new { @class = "text-danger" })*@
                </div>
            </div>

            <!--<div class="form-group">
            <label class="control-label col-md-2">شرح عن السؤال</label>

            <div class="col-md-10">

                <div id="Description" class="summernote">

                </div>
                <input type="text" class="form-control" id="Q_Description_Hiden_ID" hidden="hidden" />-->
            @*@Html.ValidationMessageFor(model => model.Q_Description, "", new { @class = "text-danger" })*@
            <!--</div>
            </div>-->


            <div class="form-group">

                @*@Html.LabelFor(model => model.L_Q_TrueOrFalse.TrueValue, htmlAttributes: new { @class = "control-label col-md-2" })*@
                <div class="col-md-10">
                    <table>
                        <tr>
                            <td style="padding:10px">
                            </td>
                            <td style="padding:10px">
                            </td>
                        </tr>
                    </table>



                </div>
            </div>

            <div class="form-group">
                <div class="form-group">
                    <div class="col-md-offset-2 col-md-10">
                        <button type="button" class="btn btn-info" data-toggle="modal" data-target="#myModal">إضافة خيارات</button>
                    </div>
                </div>

            </div>
            <div class="form-group">
                @*<label class="control-label col-md-2">الخيارات</label>*@
                @*@Html.LabelFor(model => model.Supject_ID, htmlAttributes: new { @class = "control-label col-md-2" })*@
                <div class="table-responsive">
                    <table class="table table-striped table-bordered" id="Table_Options">

                        <tr>
                            <td>الإختيارات</td>
                            <td>الدرجة</td>
                            <td></td>
                        </tr>

                    </table>

                </div>

            </div>



            <div class="form-group">

                <div class="col-md-offset-2 col-md-10">
                    <button type="button" onclick="Btn_Save()" value="Create" class="btn btn-primary">حفظ</button>
                    @*<button type="button" value="Create" class="btn btn-primary" onclick="ClickedSub()">Save</button>*@
                </div>
            </div>
