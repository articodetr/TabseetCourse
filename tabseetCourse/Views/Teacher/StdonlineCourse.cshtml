<script src="~/Content/dist/js/adminlte.min.js"></script>
<!-- AdminLTE for demo purposes -->
<script src="~/Content/dist/js/demo.js"></script>

<script>

    $(document).ready(function () {
        $('#example1').DataTable({
            "paging": true,
            "lengthChange": true,
            "searching": true,
            "ordering": true,
            "order": [],
            "info": true,
            "autoWidth": true,
            "responsive": true,
            "buttons": ["copy", /*"csv",*/ "excel", /*"pdf",*/ "print", "colvis"]
        }).buttons().container().appendTo('#example1_wrapper .col-md-6:eq(0)');
        $("#LectureDIV_ID").hide();
        $("#UploadFileDiv_ID").show();
        $("#LinkDIV_ID").hide();

        $("#ELectureDIV_ID").hide();
        $("#EUploadFileDiv_ID").show();
        $("#ELinkDIV_ID").hide();
        //GetLecture();
    });

    function GetLecture() {



        $.ajax(
            {
                async: true,
                type: 'POST',
                //dataType: 'JSON',
                //contentType: 'application/json; charset=utf=8',
                data: { byCategorieType:1},
                url: '@Url.Action("AllLectures", "Controlpanel")',
                success: function (data) {
                    var s = '';
                    for (var i = 0; i < data.length; i++) {
                        s += '<tr>' +
                            '<td>' + data[i].ID + '</td>' +
                            '<td>' + data[i].Lecture_Name + '</td>' +
                            '<td>' + data[i].NameAr + '</td>';
                        if (data[i].LectureTypeOnOff == 1) {
                            var links = '';
                            if (data[i].LectureLink_Host) {
                                links += '<a href="' + data[i].LectureLink_Host + '" target="_blank"> للمحاضر  </a> / ';
                            }
                            if (data[i].LectureLink_Client) {
                                links += '<a href="' + data[i].LectureLink_Client + '" target="_blank">  رابط المحاضرة </a>';
                            }
                            s += '<td>مباشر</td><td>' + links + '</td>';
                        } else {
                            s += '<td>مسجلة</td>' +
                                '<td><a href="' + (data[i].LectureLink_Client || '#') + '" target="_blank"> رابط المحاضرة  </a></td>';
                        }

                        s +=
                            '<td>' +
                            '<div class="btn-group">' +
                            '<button class="btn btn-info" onclick="GetLectureByID(' + data[i].ID + ')" data-toggle="modal" data-target="#EditModal">' +
                            '<i class="fas fa-edit">' +
                            '</i>' +
                            'تعديل' +
                            '</button>' +
                            '<button class="btn btn-danger" onclick = "btnDelete(' + data[i].ID + ')" >' +
                            '<i class="fas fa-trash">' +
                            '</i>' +
                            'حذف' +
                            '</button>';
                        if (data[i].LectureTypeOnOff == 0) {
                            if (data[i].Name != null) {
                                s += '<button class="btn btn-primary" onclick="ViewAssingment(' + data[i].ID + ')">' +
                                    '<i class="nav-icon fas fa-book">' +
                                    '</i>' +
                                    'عرض الوظيفة' +
                                    '</button>';
                            } else {
                                s += '<button class="btn btn-default" onclick="addassignment(' + data[i].ID + ')">' +
                                    '<i class="nav-icon fas fa-book">' +
                                    '</i>' +
                                    'اضافة وظيفة' +
                                    '</button>';
                            }
                        }
                        s += '</div>' +
                             '</td>' +
                             '</tr>';
                    }
                    $("#tableContent_ID").html(s);

                },
                error: function (response) {
                    alert("the problem is " + response.responseText);
                },
                complete: function (response) {
                    $('#example1').DataTable({
                        "paging": true,
                        "lengthChange": true,
                        "searching": true,
                        "ordering": true,
                        "order": [],
                        "info": true,
                        "autoWidth": true,
                        "responsive": true,
                        "buttons": ["copy", /*"csv",*/ "excel", /*"pdf",*/ "print", "colvis"]
                    }).buttons().container().appendTo('#example1_wrapper .col-md-6:eq(0)');
                }
            });
    }



    $('#btnSave').click(function () {
        validationSaveForm();
        var fd = new FormData();

        var Lecture_Name = $("#LectureName_ID").val();
        var Category_ID = $("#CategoryID").val();
        var LectureTypeOnOff = $("#LectureType_ID").val();
        var LectureLink = $("#LictureLink_ID").val();
        var MediaLink = $("#otherLink_ID").val();
        var Description = $("#Description_ID").val();

        var DayandTime = null;
        if (LectureTypeOnOff == 1) {
            DayandTime = $("#DateTime_ID").val();
        }
        var PC_File = $('#UploadFile_ID')[0].files[0];

        fd.append('Lecture_Name', Lecture_Name);
        fd.append('Category_ID', Category_ID);
        fd.append('DayandTime', DayandTime);
        fd.append('LectureLink', LectureLink);
        fd.append('LectureTypeOnOff', LectureTypeOnOff);
        fd.append('MediaLink', MediaLink);
        fd.append('Others', Description);
        fd.append('DocumentFileUpload', PC_File);
        var token = $('input[name="__RequestVerificationToken"]').val();
        if (token) {
            fd.append('__RequestVerificationToken', token);
        }
        //var dataJson = JSON.stringify(fd);
        $.ajax(
            {
                async: true,
                type: 'POST',
                data: fd,
                contentType: false,
                processData: false,

                url: '@Url.Action("CreateLectuer", "Controlpanel")',
                success: function (data) {
                    window.location.reload();
                },
                error: function (response) {
                    alert("the problem is " + response.responseText);
                },
                complete: function (response) {
                    //alert("finish call jasion " + response);
                }
            });
    });
    $('#btnUpdate').click(function () {
        validationSaveForm();
        var fd = new FormData();

        var EditID = $("#EditID").val();
        var ENameAR_ID = $("#ENameAR_ID").val();
        var ENameEN_ID = $("#ENameEN_ID").val();
        var EType_ID = $("#EType_ID").val();
        var ECategories_ID = $("#ECategories_ID").val();
        var EIsPayed_ID = $("#EIsPayed_ID").val();
        var EPayedValue_ID = $("#EPayedValue_ID").val();
        fd.ID = EditID;
        fd.NameAR = ENameAR_ID;
        fd.NameEN = ENameEN_ID;
        fd.CategoryType_ID = EType_ID;
        fd.IsPayed = EIsPayed_ID;
        fd.PayedValue = EPayedValue_ID;
        fd.ParentCateogry_ID = ECategories_ID;
        var dataJson = JSON.stringify(fd);
        $.ajax(
            {
                async: true,
                type: 'POST',
                dataType: 'JSON',
                contentType: 'application/json; charset=utf=8',
                data: dataJson,
                url: '@Url.Action("EditeCategories", "Controlpanel")',
                success: function (data) {
                    GetLecture();
                },
                error: function (response) {
                    alert("the problem is " + response.responseText);
                },
                complete: function (response) {
                    //alert("finish call jasion " + response);
                }
            });
    });

    function GetLectureByID(Lecture_ID) {

        $.ajax(
            {
                async: true,
                type: 'POST',
                //dataType: 'JSON',
                //contentType: 'application/json; charset=utf=8',
                data: { id: Lecture_ID },
                url: '@Url.Action("EditLecture", "Controlpanel")',
                success: function (data) {
                    TypeChangeEdit(data.LectureTypeOnOff);

                    $("#EditID").val(data.ID);
                    $("#CategoryID").val(data.Category_ID);
                    $("#EDateTime_ID").val(data.DayandTime);
                    $("#ELictureLink_ID").val(data.LectureLink);
                    $("#ELectureName_ID").val(data.Lecture_Name);
                    $("#EotherLink_ID").val(data.MediaLink);
                    $("#EDescription_ID").val(data.Others);
                },
                error: function (response) {
