@model IEnumerable<tabseetCourse.Models.LectureModel>

@{
    ViewBag.Title = "StdonlineCourse";
    Layout = "~/Views/Shared/_TeacherLayout.cshtml";
}

@Html.AntiForgeryToken()


<link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700&display=fallback">
<!-- Font Awesome -->
<link rel="stylesheet" href="~/Content/plugins/fontawesome-free/css/all.min.css">
<!-- DataTables -->
<link rel="stylesheet" href="~/Content/plugins/datatables-bs4/css/dataTables.bootstrap4.min.css">
<link rel="stylesheet" href="~/Content/plugins/datatables-responsive/css/responsive.bootstrap4.min.css">
<link rel="stylesheet" href="~/Content/plugins/datatables-buttons/css/buttons.bootstrap4.min.css">
<!-- Theme style -->
<link rel="stylesheet" href="~/Content/dist/css/adminlte.min.css">
<script src="//cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>المحاضرات لمادة @ViewBag.Name</h1>
                <input type="hidden" value="@ViewBag.Name" id="lectureName_ID" />
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                </ol>
            </div>
        </div>
    </div><!-- /.container-fluid -->
</section>

<div class="card">
    <div class="card-header">
        @* <input type="button" value="اضافة محاضرة جديد" id="addNew" data-toggle="modal" data-target="#modal-lg" class="btn btn-success float-left">*@
    </div>
    <!-- /.card-header -->
    <div class="card-body">
        <input type="text" value="@ViewBag.CategoryID" hidden="hidden" id="CategoryID" />
        <table id="example1" class="table table-bordered table-hover">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>الاسم المحاضرة</th>

                    <th>الفئة</th>
                    <th>رابط المحاضرة</th>
                    <th>وقت المحاضرة</th>



                    <th> </th>

                </tr>
            </thead>
            <tbody id="tableContent_ID">
                @foreach (var item in Model)
                {
                    if (item.Is_Lecture_End == true)
                    {
                        <tr>
                            <td>@item.ID </td>
                            <td>@item.Lecture_Name </td>
                            <td>@item.CategoresName </td>

                            <td> </td>
                            <td>@item.DayandTime </td>
                            <td>
                                @*<div class="btn-group">

                                    <button class="btn btn-info" onclick="GetLectureByID(@item.ID)" data-toggle="modal" data-target="#EditModal">
                                        <i class="fas fa-edit">

                                        </i>
                                        تعديل

                                    </button>
                                    <button class="btn btn-danger" onclick="btnDelete(@item.ID)">

                                        <i class="fas fa-trash">

                                        </i>
                                        حذف

                                    </button>*@


                                @*</div>*@
                            </td>

                        </tr>
                    }
                    else
                    {
                        <tr>

                            <td>@item.ID </td>
                            <td>@item.Lecture_Name </td>
                            <td>@item.CategoresName </td>

                            <td>
                                @if (!string.IsNullOrEmpty(item.LectureLink_Host))
                                {
                                    <a href="@item.LectureLink_Host" target="_blank"> للمحاضر  </a><span>/</span>
                                }
                                @if (!string.IsNullOrEmpty(item.LectureLink_Client))
                                {
                                    <a href="@item.LectureLink_Client" target="_blank">  رابط المحاضرة </a>
                                }
                            </td>
                            <td>@item.DayandTime </td>
                            <td>
                                <div class="btn-group">

                                    <button class="btn btn-info" onclick="GetLectureByID(@item.ID)" data-toggle="modal" data-target="#EditModal">
                                        <i class="fas fa-edit">

                                        </i>
                                        تعديل

                                    </button>
                                    <button class="btn btn-danger" onclick="btnDelete(@item.ID)">

                                        <i class="fas fa-trash">

                                        </i>
                                        حذف

                                    </button>


                                </div>
                            </td>

                        </tr>
                    }
                }
            </tbody>
            <tfoot>
                <tr>
                    <th>ID</th>
                    <th>الاسم المحاضرة</th>

                    <th>الفئة</th>
                    <th>رابط المحاضرة</th>
                    <th>وقت المحاضرة</th>

                    <th></th>
                </tr>
            </tfoot>

        </table>
    </div>
    <!-- /.card-body -->
</div>

<div class="modal fade" id="modal-lg">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">إضافة محاضرة</h4>
