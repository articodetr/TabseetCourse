                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td>

                            <div class="row">
                                <div class="col-sm-12">
                                    <!-- select -->
                                    <div class="form-group">
                                        <label>نوع الملف </label>
                                        <select id="DocType" class="form-control" onchange="FileType(this.value)" required>
                                            <option value="1">تحميل ملف</option>
                                            <option value="0">روابط</option>
                                        </select>

                                    </div>

                                </div>
                            </div>
                        </td>
                        <td colspan="2">
                            <div class="row">
                                <div class="col-sm-12" id="UploadFileDiv_ID">
                                    <!-- select -->
                                    <div class="form-group">
                                        <label>ملفات</label>
                                        <input type="file" id="UploadFile_ID" class="form-control" required accept=".doc,.docx,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document" />

                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-12">
                                    <!-- select -->
                                    <div class="form-group" id="LinkDIV_ID">
                                        <label>روابط اخرى</label>
                                        <input type="url" id="otherLink_ID" class="form-control" style="width:100%" required placeholder="URL LINK" />
                                        @*<span id="reqCategory_ID" style="color:red"></span>*@

                                    </div>
                                </div>
                            </div>
                        </td>

                    </tr>
                    <tr>
                        <td colspan="3">
                            <div class="row">
                                <div class="col-sm-12">
                                    <!-- select -->
                                    <div class="form-group">
                                        <label>وصف </label>
                                        <textarea name="Text1" id="Description_ID" cols="40" rows="3" class="form-control"></textarea>

                                        @*<span id="reqNameAR_ID" style="color:red"></span>*@
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>

                </table>
            </div>
            <div class="modal-footer justify-content-between">
                <button type="button" class="btn btn-default" data-dismiss="modal">الغاء</button>
                <button type="button" class="btn btn-primary" id="btnSave">حفظ</button>
            </div>
        </div>
        <!-- /.modal-content -->
    </div>
    <!-- /.modal-dialog -->
</div>

