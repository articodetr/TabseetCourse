<script src="~/Content/plugins/jquery/jquery.min.js"></script>
<script src="~/Content/plugins/summernote/summernote-bs4.min.js"></script>
<script>
    $(document).ready(function () {
        $('#Education_ID').summernote();
        $('#activity_ID').summernote();
        $('#Education_ID').on('summernote.change', function (we, e) {

            var summernote = $("#Education_ID").summernote('code');

            $('#Education_hidden').val(summernote);;
            //console.log(summernote);
        });
        $('#activity_ID').on('summernote.change', function (we, e) {

            var summernote = $("#activity_ID").summernote('code');

            $('#Activity_hidden').val(summernote);;
            //console.log(summernote);
        });
        var value = $('#Education_hidden').val();
        var value1 = $('#Activity_hidden').val();

        $("#Education_ID").summernote('code', value);
        $("#activity_ID").summernote('code', value1);
    });


    var loadFile = function (event) {
        var output = document.getElementById('output');
        output.src = URL.createObjectURL(event.target.files[0]);
        output.onload = function () {
            URL.revokeObjectURL(output.src) // free memory
        }
    };

     function BtnSaveInFo() {
         const swalWithBootstrapButtons = Swal.mixin({
             customClass: {
                 confirmButton: 'btn btn-success',
                 cancelButton: 'btn btn-danger'
             },
             buttonsStyling: false
         });
         var fd = new FormData();

         var STD_ID = $('#STD_ID').val();
        var Education = $('#Education_hidden').val();
        var Experience = $('#Activity_hidden').val();
        var RealName = $('#RealName').val();
        var Email = $('#Email').val();
        var PhoneNumber = $('#PhoneNumber').val();
        var Location = $('#Location').val();
        var Password = $('#Password_ID').val();
         var PCImage_IDEN = $('#UploadPhoto')[0].files[0];
         fd.append("ID", STD_ID);
         fd.append("Education", Education);
         fd.append("Experience", Experience);
         fd.append("RealName", RealName);
         fd.append("Email", Email);
         fd.append("PhoneNumber", PhoneNumber);
         fd.append("Location", Location);
         fd.append("Password", Password);
         fd.append("PersionImageFile", PCImage_IDEN);

        $.ajax({
            async: true,
            type: 'POST',
            data: fd,
            contentType: false,
            processData: false,

                url: '@Url.Action("SaveInfo", "Teacher")',


                success: function (result) {
                    swalWithBootstrapButtons.fire(
                        'تم الحفظ!',
                        'تم تعديل معلومات الطالب.',
                        'success'
                    ).then(function () {


                    });

                },
                error: function (response) {
                    swalWithBootstrapButtons.fire(
                        'Filed',
                        response.responseText + ' :)',
                        'error'
                    )
                },
                complete: function (response) {
                }
            });
    }
</script>

