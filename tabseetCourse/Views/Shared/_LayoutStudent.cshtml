        $(function () {
            // Owl Carousel
            var owl = $(".owl-carousel");
            owl.owlCarousel({
                items: 3,
                margin: 10,
                center: true,
                loop: true,
                nav: true,
                arrow: true,
                responsive: {
                    0: {
                        items: 1,
                        center: false,
                        arrow: false,
                        dots: true
                    },
                    600: {
                        items: 1,
                        center: false,
                        arrow: false,
                        dots: true
                    },
                    1024: {
                        items: 2
                    },
                    1366: {
                        items: 3
                    }
                }
            });
        });


            /* navbar fixed */

            $(window).scroll(function () {

                var startScroll = 50;
                var menuTop = $(".menu_top");
                var scrollTop = $(window).scrollTop();

                if (scrollTop >= startScroll ) {
                    $(menuTop).addClass("fixed");
                } else {
                    if (isLoading != false) {
                        $(menuTop).removeClass("fixed");
                    }

                }
            });


    </script>
