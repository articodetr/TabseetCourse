    <script>
        (function () {
            [].slice.call(document.querySelectorAll('select.cs-select')).forEach(function (el) {
                new SelectFx(el);
            });
        })();

        $(document).ready(function () {
            var value = localStorage.getItem('Lang_id1')
            console.log(value);
            $("#Lang_id1").val(value);
        });
        function SelectChange (value) {
            localStorage.setItem('Lang_id1', value);
              $.ajax(
                {
                    async: true,

                      type: 'POST',
                      data: { lang_ID: value },

                    url: '@Url.Action("SetLocalLang", "Controlpanel")',
                      success: function (data) {
                          window.location.reload(true);


                    },
                    error: function (response) {
                        alert("Can't change language");
                    },
                    complete: function (response) {
                        //alert("finish call jasion " + response);
                    }
                });


    };

    </script>
