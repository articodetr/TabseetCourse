    <script>
        $(document).ready(function () {
            //Initialize Select2 Elements
            $('.select2').select2()

            //Initialize Select2 Elements
            $('.select2bs4').select2({
                theme: 'bootstrap4'
            })
            $.ajax(
                {
                    async: true,
                    type: 'POST',
                    url: '@Url.Action("GetActivateCourseCounter", "ControlPanel")',
                    success: function (data) {

                        $("#ActiveCourse_ID").text(data.Count);
                    },
                    error: function (response) {
                    },
                    complete: function (response) {
                    }
                });

            // Admin Notifications Bell Poller
            function checkAdminNotifications() {
                $.ajax({
                    async: true,
                    type: 'GET',
                    url: '@Url.Action("GetLatest", "AdminNotifications")?count=5',
                    success: function (data) {
                        if (data && data.success) {
                            var count = data.unreadCount || 0;
                            var badge = $('#adminNotifBellCount');
                            var sidebarBadge = $('#AdminNotifCountBadge');
                            if (count > 0) {
                                badge.text(count).show();
                                if (sidebarBadge.length) sidebarBadge.text(count).show();
                                $('#adminNotifDropdownHeader').text(count + ' إشعار جديد');
                            } else {
                                badge.hide();
                                if (sidebarBadge.length) sidebarBadge.hide();
                                $('#adminNotifDropdownHeader').text('لا توجد إشعارات جديدة');
                            }

                            var listHtml = '';
                            if (data.items && data.items.length > 0) {
                                data.items.forEach(function (item) {
                                    var bgStyle = item.IsRead ? '' : 'background-color: #f1f8ff;';
                                    listHtml += '<a href="@Url.Action("Index", "AdminNotifications")" class="dropdown-item" style="' + bgStyle + ' white-space: normal; padding: 10px 15px;">' +
                                        '<div class="d-flex justify-content-between align-items-center mb-1">' +
                                        '<strong class="text-dark small" style="max-width: 200px; text-overflow: ellipsis; overflow: hidden; white-space: nowrap;">' + item.Title + '</strong>' +
                                        '<span class="badge ' + (item.ActionBadgeClass || 'badge-secondary') + ' mr-1" style="font-size: 0.7rem;">' + (item.ActionTypeArabic || '') + '</span>' +
                                        '</div>' +
                                        '<div class="text-muted small mb-1" style="font-size: 0.8rem; line-height: 1.2;">' + (item.Details || '') + '</div>' +
                                        '<div class="text-left text-secondary" style="font-size: 0.75rem;"><i class="far fa-clock ml-1"></i>' + (item.TimeAgo || '') + '</div>' +
                                        '</a><div class="dropdown-divider"></div>';
                                });
                            } else {
                                listHtml = '<div class="text-center py-3 text-muted small">لا توجد إشعارات حالياً</div>';
                            }
                            $('#adminNotifDropdownList').html(listHtml);
                        }
                    },
                    error: function () {
                    }
                });
            }

            checkAdminNotifications();
            setInterval(checkAdminNotifications, 30000);



