@model tabseetCourse.Models_UI.HomePageModel

@{
    ViewBag.Title = "HomePage";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}



<body onload="Loadelanguage()">
    <div class="main-content">
        <div class="page-title">
            <div class="sub-title"> Home Page</div>
        </div>
        @using (Html.BeginForm("HomePage", "UIUXadminPanel", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {

            @Html.AntiForgeryToken()

            <div class="form-horizontal">
                @*<h4 onchange="">HomePageModel</h4>*@
                <hr />
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                <div class="form-group hidden">
                    @Html.LabelFor(model => model.ID, htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.ID, new { htmlAttributes = new { @class = "form-control", @id = "HomePage_ID" } })
                        @Html.ValidationMessageFor(model => model.ID, "", new { @class = "text-danger" })
                    </div>
                </div>


                <div class="form-group">
                    @if (Session["Language"] != null && Session["Language"].ToString() == "1")
                    {
                        <label class="control-label col-md-2">Image</label>
                    }
                    else
                    {
                        <label class="control-label col-md-2">صورة الصفحة الرئيسية</label>
                    }
                    @*@Html.LabelFor(model => model.Video, htmlAttributes: new { @class = "control-label col-md-2" })*@
                    <div class="col-md-10">
                        <input type="file" id="_MainImage" name="_MainImage" />
                    </div>
                </div>


                <div class="form-group">
                    @if (Session["Language"] != null && Session["Language"].ToString() == "1")
                    {
                        <label class="control-label col-md-2">Video</label>
                    }
                    else
                    {
                        <label class="control-label col-md-2">فيديو تعريفي في الواجهة الرئيسية</label>
                    }
                    @*@Html.LabelFor(model => model.Video, htmlAttributes: new { @class = "control-label col-md-2" })*@
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.MainVideo, new { htmlAttributes = new { @class = "form-control", @id = "MainVideo" } })
                        @Html.ValidationMessageFor(model => model.MainVideo, "", new { @class = "text-danger" })

                    </div>
                </div>
                <div class="form-group">
                    @if (Session["Language"] != null && Session["Language"].ToString() == "1")
                    {
                        <label class="control-label col-md-2">Main Text</label>
                    }
                    else
                    {
                        <label class="control-label col-md-2">النص في الصفحة الرئيسية</label>
                    }
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.MainText, new { htmlAttributes = new { @class = "form-control", @id = "MainText" } })
                        @Html.ValidationMessageFor(model => model.MainText, "", new { @class = "text-danger" })

                    </div>
                </div>








                <div class="form-group">
                    @if (Session["Language"] != null && Session["Language"].ToString() == "1")
                    {
                        <label class="control-label col-md-2">Support phone number</label>
                    }
                    else
                    {
                        <label class="control-label col-md-2">رقم هاتف الدعم الفني </label>
                    }
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.phoneNumber, new { htmlAttributes = new { @class = "form-control", @id = "phoneNumber" } })
                        @Html.ValidationMessageFor(model => model.phoneNumber, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    @if (Session["Language"] != null && Session["Language"].ToString() == "1")
                    {
                        <label class="control-label col-md-2">Support Email</label>
                    }
                    else
                    {
                        <label class="control-label col-md-2">إيميل الدعم الفني </label>
                    }
                    @*@Html.LabelFor(model => model.email, htmlAttributes: new { @class = "control-label col-md-2" })*@
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.email, new { htmlAttributes = new { @class = "form-control", @id = "email" } })
                        @Html.ValidationMessageFor(model => model.email, "", new { @class = "text-danger" })

                    </div>
                </div>


                <div class="form-group">
                    <div class="col-md-offset-2 col-md-10">
                        @if (Session["Language"] != null && Session["Language"].ToString() == "1")
                        {
                            <input type="submit" value="Save" class="btn btn-primary" />
                        }
                        else
                        {
                            <input type="submit" value="حفظ" class="btn btn-primary" />
                        }

                    </div>
                </div>
            </div>

        }
        @if (ViewBag.Message != null)
        {
            <div class="alert alert-success">
                <h3>
                    @ViewBag.Message

                </h3>
            </div>
        }
        @if (ViewBag.error != null)
        {
            <div class="alert alert-danger">
                <h3>
                    @ViewBag.error

                </h3>
            </div>
        }
    </div>


</body>
<script type="text/javascript">
     function onchangeLang()
    {
            $.ajax(
                {
                    async: true,

                    type: 'POST',
                    //dataType: 'JSON',
                    //contentType: 'application/json; charset=utf=8',
                    data: { LangID: $("#Lang_id").val() },
                    url: '@Url.Action("GetHomePageByLang", "UIUXadminPanel")',
                    success: function (data) {
                        $('#HomePage_ID').val(data.ID);
                        $('#Title_ID').val(data.title);
                        $('#EmailWord_ID').val(data.email_word);
                        $('#RegisterWord_ID').val(data.register_word);
                        $('#LoginWord_ID').val(data.Login_word);
                        $('#CollegeWord_ID').val(data.College_word);
                        $('#NewsWord_ID').val(data.New_word);
                        $('#archiveword_ID').val(data.archive_word);
                        $('#readMore_ID').val(data.read_more_word);
                        $('#Pracktes_ID').val(data.Pracktes_word);
                        $('#Stay_ID').val(data.stay_Conect);
                        $('#phoneNumber_ID').val(data.phoneNumber);
                        $('#Email_ID').val(data.email);
                        $('#Video_ID').val(data.Video);

                    },
                    error: function (response) {

                        alert("There is a problem Can't Load Data" + response.error);
                    },
                    complete: function (response) {
                        //alert("finish call jasion " + response);
                    }
                });
    };

    function Loadelanguage() {

        $.ajax(
            {
                async: true,

                type: 'POST',
                //dataType: 'JSON',
                //contentType: 'application/json; charset=utf=8',
                //data: { id: Exam_id },

                url: '@Url.Action("GetAllLanguages", "UIUXadminPanel")',
                success: function (data) {

                    var s = '<option value="-1">Select Language</option>';
                    for (var i = 0; i < data.length; i++) {
                        s += '<option value="' + data[i].ID + '">' + data[i].Name + '</option>';
                    }
                    $("#Lang_id").html(s);
                },
                error: function (response) {
                    alert("there is a problem in supject " + response);
                },
                complete: function (response) {
                    //alert("finish call jasion " + response);
                }
            });
    }
</script>

