@model IEnumerable<tabseetCourse.Models.Std_Reg_CategoryModel>

@{
    ViewBag.Title = "إدارة طلبات الاشتراك";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var viewModel = (tabseetCourse.Models.UserModel)ViewBag._UsermodelModel;
    bool canApprove = viewModel != null && viewModel.L_role != null
        && viewModel.L_role.Any(r => r.RoleName == tabseetCourse.Services.CourseAccessService.AdminRole || r.RoleName == tabseetCourse.Services.CourseAccessService.ApproverRole);
    var requests = Model != null ? Model.ToList() : new List<tabseetCourse.Models.Std_Reg_CategoryModel>();
    string successMessage = TempData["SubscriptionMessage"] as string;
    string errorMessage = TempData["SubscriptionError"] as string;
}


<link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700&display=fallback">
<!-- Font Awesome -->
<link rel="stylesheet" href="~/Content/plugins/fontawesome-free/css/all.css">
<!-- DataTables -->
<link rel="stylesheet" href="~/Content/plugins/datatables-bs4/css/dataTables.bootstrap4.min.css">
<link rel="stylesheet" href="~/Content/plugins/datatables-responsive/css/responsive.bootstrap4.min.css">
<link rel="stylesheet" href="~/Content/plugins/datatables-buttons/css/buttons.bootstrap4.min.css">
<!-- Theme style -->
<link rel="stylesheet" href="~/Content/dist/css/adminlte.min.css">
<script src="//cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<!-- Select2 -->
<link rel="stylesheet" href="~/Content/plugins/select2/css/select2.min.css">
<link rel="stylesheet" href="~/Content/plugins/select2-bootstrap4-theme/select2-bootstrap4.min.css">
<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>إدارة طلبات الاشتراك</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                </ol>
            </div>
        </div>
    </div><!-- /.container-fluid -->
</section>

<div class="card">
    <div class="card-header" style="direction: rtl; text-align: right;">
        <p class="mb-1" style="font-weight: 700;">
            <i class="fas fa-info-circle text-primary"></i>
            طلبات الاشتراك في الدورات المدفوعة بانتظار تأكيد الإدارة. لا يوجد أي دفع داخل الموقع:
            بعد التأكد من استلام قيمة الدورة خارج الموقع اضغط «تأكيد الدفع وتفعيل الاشتراك» ليتمكن الطالب من دخول محتوى الدورة فوراً.
        </p>
        <p class="mb-0 text-muted" style="font-size: 13px;">
            الدورات المجانية تُفعَّل تلقائياً عند الاشتراك ولا تظهر هنا. عدد الطلبات المعلّقة حالياً: <strong>@requests.Count</strong>
        </p>
    </div>
    <!-- /.card-header -->
    <div class="card-body">
        <table id="example1" class="table table-bordered table-hover" style="direction: rtl; text-align: right;">
            <thead>
                <tr>
                    <th>#</th>
                    <th>اسم الطالب</th>
                    <th>اسم الدورة</th>
                    <th>تاريخ طلب الاشتراك</th>
                    <th>سعر الدورة</th>
                    <th>حالة الطلب</th>
                    <th>ملاحظات</th>
                    <th> </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in requests)
                {
                    <tr data-registration-id="@item.ID">
                        <td>@item.ID</td>
                        <td>
                            <strong>@item.Student_Name</strong>
                            @if (!string.IsNullOrWhiteSpace(item.Student_Email))
                            {
                                <br /><small class="text-muted" dir="ltr">@item.Student_Email</small>
                            }
                        </td>
                        <td>@item.CategoryName</td>
                        <td data-order="@(item.RequestedAt.HasValue ? item.RequestedAt.Value.ToString("yyyy-MM-dd HH:mm") : "")">
                            @if (item.RequestedAt.HasValue)
                            {
                                @item.RequestedAt.Value.ToString("yyyy-MM-dd HH:mm")
                            }
                            else
                            {
                                <span class="text-muted">غير مسجل (طلب قديم)</span>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(item.PayMent_Value))
                            {
                                @item.PayMent_Value
                            }
                            else
                            {
                                <span class="text-muted">غير محدد</span>
                            }
                        </td>
                        <td>
                            <span class="badge badge-warning" style="font-size: 13px; padding: 6px 10px;">
                                <i class="fas fa-hourglass-half"></i> بانتظار موافقة الإدارة
                            </span>
                        </td>
                        <td>
                            @* معلومات تاريخية من نظام الدفع القديم (للاطلاع فقط؛ لم تعد تُجمع من الطالب) *@
                            @if (item.PayMent_Method == 2)
                            {
                                <small>طلب قديم: حوالة بنكية</small>
                                if (!string.IsNullOrWhiteSpace(item.TransactionFile))
                                {
                                    <br /><a href="~/Uploade/Images/@item.TransactionFile" target="_blank" rel="noopener noreferrer"><small>إشعار الدفع المرفق سابقاً</small></a>
                                }
                            }
                            else if (item.PayMent_Method == 3)
                            {
                                <small>طلب قديم: الدفع لاحقاً</small>
                            }
                            else if (item.PayMent_Method == 4)
                            {
                                <small>طلب قديم: منحة (@item.Code)</small>
                            }
                            else if (item.PayMent_Method == 1 || item.PayMent_Method == 5)
                            {
                                <small>طلب قديم: @(item.PayMent_Method == 1 ? "بطاقة ائتمان" : "عن طريق وكيل")</small>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>
                            <div class="btn-group">
                                @if (canApprove)
                                {
                                    using (Html.BeginForm("ActiveStudenCourse", "Controlpanel", FormMethod.Post, new { @class = "js-approve-form", data_student = item.Student_Name, data_course = item.CategoryName }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="Reg_ID" value="@item.ID" />
                                        <input type="hidden" name="confirm" value="1" />
                                        <button type="submit" class="btn btn-success">
                                            <i class="fas fa-check-circle"></i>
                                            تأكيد الدفع وتفعيل الاشتراك
                                        </button>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted"><small>عرض فقط</small></span>
                                }
                            </div>
                        </td>
                    </tr>
                }

            </tbody>
            <tfoot>
                <tr>
                    <th>#</th>
                    <th>اسم الطالب</th>
                    <th>اسم الدورة</th>
                    <th>تاريخ طلب الاشتراك</th>
                    <th>سعر الدورة</th>
                    <th>حالة الطلب</th>
                    <th>ملاحظات</th>
                    <th> </th>
                </tr>
            </tfoot>
        </table>
    </div>
    <!-- /.card-body -->
</div>


<!-- /.card -->
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>

<script src="~/Content/plugins/jquery/jquery.min.js"></script>
<!-- Bootstrap 4 -->
<script src="~/Content/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
<script src="~/Content/plugins/select2/js/select2.full.min.js"></script>
<!-- DataTables  & Plugins -->
<script src="~/Content/plugins/datatables/jquery.dataTables.min.js"></script>

<script src="~/Content/plugins/datatables-bs4/js/dataTables.bootstrap4.min.js"></script>
<script src="~/Content/plugins/datatables-responsive/js/dataTables.responsive.min.js"></script>
<script src="~/Content/plugins/datatables-responsive/js/responsive.bootstrap4.min.js"></script>
<script src="~/Content/plugins/datatables-buttons/js/dataTables.buttons.min.js"></script>
<script src="~/Content/plugins/datatables-buttons/js/buttons.bootstrap4.min.js"></script>
<script src="~/Content/plugins/jszip/jszip.min.js"></script>
<script src="~/Content/plugins/pdfmake/pdfmake.min.js"></script>
<script src="~/Content/plugins/pdfmake/vfs_fonts.js"></script>
<script src="~/Content/plugins/datatables-buttons/js/buttons.html5.min.js"></script>
<script src="~/Content/plugins/datatables-buttons/js/buttons.print.min.js"></script>
<script src="~/Content/plugins/datatables-buttons/js/buttons.colVis.min.js"></script>
<script src="~/Content/plugins/bs-custom-file-input/bs-custom-file-input.min.js"></script>
<!-- AdminLTE App -->
<script src="~/Content/dist/js/adminlte.min.js"></script>
<!-- AdminLTE for demo purposes -->
<script src="~/Content/dist/js/demo.js"></script>

<!-- Page specific script -->
<script>
    $(function () {
        $('#example1').DataTable({
            "paging": true,
            "lengthChange": true,
            "searching": true,
            "ordering": true,
            "info": true,
            "autoWidth": true,
            "responsive": true,
            "buttons": ["copy", /*"csv",*/ "excel", /*"pdf",*/ "print", "colvis"]
        }).buttons().container().appendTo('#example1_wrapper .col-md-6:eq(0)');

        // تأكيد قبل الاعتماد (الحماية الفعلية على الخادم: POST + رمز مكافحة التزوير + صلاحية Identity)
        $(document).on('submit', '.js-approve-form', function (e) {
            var form = this;
            if (form.dataset.confirmed === '1') { return true; }
            e.preventDefault();
            var student = form.getAttribute('data-student') || '';
            var course = form.getAttribute('data-course') || '';
            Swal.fire({
                title: 'تأكيد الدفع وتفعيل الاشتراك',
                html: 'هل تؤكد استلام قيمة دورة <b>' + $('<div>').text(course).html() + '</b> من الطالب <b>' + $('<div>').text(student).html() + '</b>؟<br>سيتمكن الطالب من دخول محتوى الدورة فوراً.',
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'نعم، تفعيل الاشتراك',
                cancelButtonText: 'إلغاء',
                confirmButtonColor: '#28a745',
                reverseButtons: true
            }).then(function (result) {
                if (result.isConfirmed) {
                    form.dataset.confirmed = '1';
                    form.submit();
                }
            });
            return false;
        });

        @if (!string.IsNullOrWhiteSpace(successMessage))
        {
            <text>
        Swal.fire({ icon: 'success', title: 'تم', text: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(successMessage)), confirmButtonText: 'حسناً' });
            </text>
        }
        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <text>
        Swal.fire({ icon: 'error', title: 'تنبيه', text: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(errorMessage)), confirmButtonText: 'حسناً' });
            </text>
        }
    });
</script>
