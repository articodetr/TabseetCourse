<script>
    $(function () {

        $('.select2').select2();
        getCategores();
        getAllTeachers();

    });

    function getCategores() {
          $.ajax(
            {
                async: true,
                type: 'POST',
                url: '@Url.Action("GetAllCategories", "Controlpanel")',
                success: function (data) {
                    var s = '';
                    for (var i = 0; i < data.length; i++) {
                        s += '<option value=' + data[i].ID + '>' + data[i].NameAr + '</>';
                    }
                    $("#Categories_ID").html(s);
                    $("#ECategories_ID").html(s);

                },
                error: function (response) {
                    alert("the problem is " + response.responseText);
                },
                complete: function (response) {
                    //alert("finish call jasion " + response);
                }
            });
    }
    function getAllTeachers() {

        $.ajax(
            {
                async: true,
                type: 'POST',
                url: '@Url.Action("GetTeachers", "Controlpanel")',
                success: function (data) {
                    var s = '';
                    for (var i = 0; i < data.length; i++) {

                        s += '<div class="col-12 col-sm-6 col-md-4 d-flex align-items-stretch flex-column" style="text-align:right">' +
                            '<div class="card bg-light d-flex flex-fill" >' +
                            '<div class="card-header text-muted border-bottom-0"></div>' +
                            '<div class="card-body pt-0">' +
                            '<div class="row">' +
                            '<div class="col-7">' +
                            '<h2 class="lead"><b>' + data[i].FirstName + '</b></h2> ' +
                            '<p class="text-muted text-sm"><b>يدرس : </b> ' + data[i].Categories_ID + '</p>' +
                            '<ul class="ml-4 mb-0 fa-ul text-muted">' +
                            '<li class="small" dir="rtl">' + data[i].Email + ' <span class="fa-li" style = "text-align:right; float:right" dir = "rtl" ><i class="fas fa-envelope"></i></i></span></li >' +
                            '<li class="small" dir="rtl"> الهاتف :' + data[i].PhoneNumber + '<span class="fa-li" style="text-align:right; float:right" dir="rtl"><i class="fas fa-lg fa-phone" style="text-align:right; float:right" dir="rtl"></i></span></li>' +
                            '</ul>' +
                            '</div>' +
                            '<div class="col-5 text-center">';
                        if (data[i].PersionImage == null) {

                            s += '<img src="/Content/persion.png" alt="user-avatar" style="width:100px">';

                            } else {
                            s += '<img src="/Uploade/Images/' + data[i].PersionImage + '" alt="user-avatar" class="img-circle img-fluid">';
                                }
                        s += '</div>' +
                            '</div>' +
                            '</div>' +
                            '<div class="card-footer">' +
                            '<div class="text-right">' +
                            '<a href="#" onclick="SendEmail(' + "'" + data[i].Email +"'" +')" class="btn btn-sm bg-teal">' +
                            '<i class="fas fa-comments">إرسال بريد</i>' +
                            '</a>' +
                            '<a href="#" onclick="GetTeacherData(' + "'" + data[i].Id + "'" + ')" data-toggle="modal" data-target="#Editmodal-lg" class="btn btn-sm btn-primary">' +
                            '<i class="fas fa-user"></i> تعديل المعلومات </a>' +
                            '</div>' +
                            '</div>' +
                            '</div > ' +
                            '</div>';
                    }
                    $("#PersionInfo").html(s);

                },
                error: function (response) {

                },
                complete: function (response) {
                    //alert("finish call jasion " + response);
                }
            });
    }



    $('#btnSave').click(function () {
        const swalWithBootstrapButtons = Swal.mixin({});
        var fd = new FormData();

        var Fullname = $("#FullName_ID").val();
        var email = $("#Email_ID").val();
        var phoneNumver = $("#PhoneNumber_ID").val();
        var Password = $("#Password_ID").val();


        var Categories_ID = $('#Categories_ID').select2("data");
        var category = '';
        for (var i = 0; i < Categories_ID.length; i++) {
            category += Categories_ID[i].id + "/" + Categories_ID[i].text + ",";
        }
        //var PC_File = $('#customFile')[0].files[0];

        fd.append('FullName', Fullname);
        fd.append('Email', email);
        fd.append('PhoneNumber', phoneNumver);
        fd.append('Password', Password);
        fd.append('Categores_ID', category);
        //fd.append('Image_File', PC_File);

        //var dataJson = JSON.stringify(fd);
        $.ajax(
            {
                async: true,
                type: 'POST',
                data: fd,
                contentType: false,
                processData: false,

                url: '@Url.Action("SaveTeachers", "Controlpanel")',
                success: function (data) {
                    swalWithBootstrapButtons.fire(
                        'تم الحفظ!',
                        'تم اضافة المدرس بنجاح.',
                        'success'
                    ).then(function () {

                        window.location.reload();

                    });
                },
                error: function (response) {
                    swalWithBootstrapButtons.fire(
                        'Filed',
                        response.responseText + ' :)',
                        'error'
                    )
                },
                complete: function (response) {
                    //alert("finish call jasion " + response);
                }
            });
    });

    $('#btnUpdate').click(function () {
        const swalWithBootstrapButtons = Swal.mixin({});

        var fd = new FormData();
        var ID = $("#EID").val();
        var Fullname = $("#EFullName_ID").val();
        var email = $("#EEmail_ID").val();
        var phoneNumver = $("#EPhoneNumber_ID").val();
        var Password = $("#EPassword_ID").val();


        var Categories_ID = $('#ECategories_ID').select2("data");
        var category = '';
        for (var i = 0; i < Categories_ID.length; i++) {
            category += Categories_ID[i].id + "/" + Categories_ID[i].text + ",";
        }
        //var PC_File = $('#EcustomFile')[0].files[0];
        fd.append("ID", ID);
        fd.append('FullName', Fullname);
        fd.append('Email', email);
        fd.append('PhoneNumber', phoneNumver);
        fd.append('Password', Password);
        fd.append('Categores_ID', category);
        //fd.append('Image_File', PC_File);

        $.ajax(
            {
                async: true,
                type: 'POST',
                data: fd,
                contentType: false,
                processData: false,
                url: '@Url.Action("UpdateTeachers", "Controlpanel")',
                success: function (data) {
                    swalWithBootstrapButtons.fire(
                        'تم الحفظ!',
                        'تم اضافة المدرس بنجاح.',
                        'success'
                    ).then(function () {

                        window.location.reload();

                    });
                },
                error: function (response) {
                    swalWithBootstrapButtons.fire(
                        'Filed',
                        response.responseText + ' :)',
                        'error'
                    )
                },
                complete: function (response) {
                    //alert("finish call jasion " + response);
                }
            });
    });

    function GetTeacherData(ID) {
        $.ajax(
            {
                async: true,
                type: 'POST',
                data: { Teacher_ID: ID },
                url: '@Url.Action("GetTeacherByID", "Controlpanel")',
                success: function (data) {

                    $("#EID").val(data.Id);
                    $("#EFullName_ID").val(data.FirstName);
                    $("#EPhoneNumber_ID").val(data.PhoneNumber);

                    $("#EEmail_ID").val(data.Email);
                    $("#EPassword_ID").val(data.Password);
                    var category = data.Categories_ID;
                    const myArr = category.split(",");;
                    var L_MuCh = new Array();
                    for (var i = 0; i < myArr.length; i++) {
                        const categories = myArr[i];
                        L_MuCh.push(categories[0]);
                    }

                    $("#ECategories_ID").val(L_MuCh).change();

                },
                error: function (response) {
                    alert("the problem is " + response.responseText);
                },
                complete: function (response) {
                    //alert("finish call jasion " + response);
                }
            });
    }
    function btnDelete(ID) {
            const swalWithBootstrapButtons = Swal.mixin({
                customClass: {
                    confirmButton: 'btn btn-success',
                    cancelButton: 'btn btn-danger'
                },
                buttonsStyling: false
            });

        swalWithBootstrapButtons.fire({
            title: 'Are you sure?',
            text: "You won't be able to delete this!",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Delete it!',
            cancelButtonText: 'Cancel!',
            reverseButtons: true
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax(
                    {
                        async: true,
                        type: 'POST',
                        //dataType: 'JSON',
                        //contentType: 'application/json; charset=utf=8',
                        data: { Q_ID: ID },
                        url: '@Url.Action("DeletQuestion", "Controlpanel")',
                        success: function (data) {
                            swalWithBootstrapButtons.fire(
                                'Deleted!',
                                'Your file has been deleted.',
                                'success'
                            ).then(function () { GetQuesiont(); })

                        },
                        error: function (response) {
                            swalWithBootstrapButtons.fire(
                                'Filed',
                                response.responseText+' :)',
                                'error'
                            )
                        },
                        complete: function (response) {
                            //alert("finish call jasion " + response);
                        }
                    });

            } else if (
                /* Read more about handling dismissals below */
                result.dismiss === Swal.DismissReason.cancel
            ) {
                swalWithBootstrapButtons.fire(
                    'Cancelled',
                    'Your  file is safe :)',
                    'error'
                )
            }
        })

    }


