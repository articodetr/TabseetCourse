<!-- Page specific script -->
<script>

    $(document).ready(function () {
        document.getElementById("btnSave").disabled = true;
        document.getElementById("btnUpdate").disabled = true;
        GetLecture();
    });
    function validationAdd() {
        var LectureName_ID = $("#LectureName_ID").val();
        var DateTime_ID = $("#DateTime_ID").val();
        var LictureLink_ID = $("#LictureLink_ID").val();
        var LectureType_ID = $("#LectureType_ID").val();


        if (LectureName_ID != "" && LectureType_ID == 0 && LictureLink_ID != "") {

            document.getElementById("btnSave").disabled = false;
        } else if (LectureName_ID != "" && LectureType_ID == 1 && DateTime_ID != "") {
            document.getElementById("btnSave").disabled = false;
        } else {
            document.getElementById("btnSave").disabled = true;
        }
    }
    function validationEdit() {
        console.log()
        var LectureName_ID = $("#ELectureName_ID").val();
        var DateTime_ID = $("#EDateTime_ID").val();
        var LictureLink_ID = $("#ELictureLink_ID").val();
        var LectureType_ID = $("#ELectureType_ID").val();


        if (LectureName_ID != "" && LectureType_ID == 0 && LictureLink_ID != "") {

            document.getElementById("btnUpdate").disabled = false;
        } else if (LectureName_ID != "" && LectureType_ID == 1 && DateTime_ID != "") {
            document.getElementById("btnUpdate").disabled = false;
        } else {
            document.getElementById("btnUpdate").disabled = true;
        }
    }

    function GetLecture() {

        $("#LectureDIV_ID").hide();
        $("#LectureDivMiniTime_ID").hide();
        $("#ELectureDivMiniTime_ID").hide();
        $("#UploadFileDiv_ID").show();
        $("#LinkDIV_ID").hide();

        $("#ELectureDIV_ID").hide();
        $("#EUploadFileDiv_ID").show();
        $("#ELinkDIV_ID").hide();
        var cat_ID = $("#CategoryID").val();
        $.ajax(
            {
                async: true,
                type: 'POST',
                //dataType: 'JSON',
                //contentType: 'application/json; charset=utf=8',
                data: { byCategorieType:0, byCategorie:cat_ID},
                url: '@Url.Action("AllLectures", "Controlpanel")',
                success: function (data) {
                    var s = '';
                    for (var i = 0; i < data.length; i++) {
                        s += '<tr>' +
                            '<td>' + data[i].ID + '</td>' +
                            '<td>' + data[i].Lecture_Name + '</td>' +
                            '<td>' + data[i].NameAr + '</td>';
                        if (data[i].LectureTypeOnOff == 1) {
                            s += '<td>مباشر</td>' +
                                '<td><a href="' + data[i].LectureLink_Host + '" target="_blank"> للمحاضر  </a>/<a href="' + data[i].LectureLink_Client + '"target="_blank">  للطالب </a></td>';
                        } else {
                            s += '<td>مسجلة</td>' +
                                '<td><a href="' + data[i].LectureLink_Client + '" target="_blank"> رابط المحاضرة  </a></td>';
                        }

                        s += '<td>' +
                            '<div class="btn-group">';
                        var LectureEdit = $("#LectureEdit").val();
                        if (LectureEdit != null) {
                            s += '<button class="btn btn-info" onclick="GetLectureByID(' + data[i].ID + ')" data-toggle="modal" data-target="#EditModal">' +
                                '<i class="fas fa-edit">' +
                                '</i>' +
                                'تعديل' +
                                '</button>';
                        }
                        var LectureDelete = $("#LectureDelete").val();
                        if (LectureDelete != null) {

                            s +=   '<button class="btn btn-danger" onclick = "btnDelete(' + data[i].ID + ')" >' +
                                '<i class="fas fa-trash">' +
                                '</i>' +
                                'حذف' +
                                '</button>';
                        }
                        if (data[i].LectureTypeOnOff == 0) {
                            if (data[i].Count > 0) {
                                var AssingmentEdit = $("#AssingmentEdit").val();
                                if (AssingmentEdit != null) {

                                    s += '<button class="btn btn-primary" onclick="ViewAssingment(' + data[i].ID + ')">' +
                                        '<i class="nav-icon fas fa-book">' +
                                        '</i>' +
                                        'عرض الوظيفة' +
                                        '</button>';
                                }
                            } else {
                                var AssingmentView = $("#AssingmentView").val();
                                if (AssingmentView != null) {
                                    s += '<button class="btn btn-default" onclick="addassignment(' + data[i].ID + ')">' +
                                        '<i class="nav-icon fas fa-book">' +
                                        '</i>' +
                                        'اضافة وظيفة' +
                                        '</button>';
                                }
                            }
                        }
                        s += '</div>' +
                             '</td>' +
                             '</tr>';
                    }
                    $("#tableContent_ID").html(s);

                },
                error: function (response) {
                    alert("the problem is " + response.responseText);
                },
                complete: function (response) {
                    $('#example1').DataTable({
                        "paging": true,
                        "lengthChange": true,
                        "searching": true,
                        "ordering": true,
                        "info": true,
                        "autoWidth": true,
                        "responsive": true,
                        "buttons": ["copy", /*"csv",*/ "excel", /*"pdf",*/ "print", "colvis"]
                    }).buttons().container().appendTo('#example1_wrapper .col-md-6:eq(0)');
                }
            });
    }



    $('#btnSave').click(function () {

        var fd = new FormData();

        var Lecture_Name = $("#LectureName_ID").val();
        var Category_ID = $("#CategoryID").val();
        var LectureTypeOnOff = $("#LectureType_ID").val();
      //  var LectureLink = $("#LictureLink_ID").val();
        //var LictureLink_ID = $("#LictureLink_ID").val();
        var check = $("#LictureLink_ID").val();
        var LectureLink = "";


        var MediaLink = $("#otherLink_ID").val();
        var Description = $("#Description_ID").val();
        var LictureMiniTime_ID = $("#LictureMiniTime_ID").val();

        var DayandTime = null;
        if (LectureTypeOnOff == 1) {
            DayandTime = $("#DateTime_ID").val();
        } else {
            let result = check.includes("iframe");
            if (result) {
                var $test = $($("#LictureLink_ID").val());
                LectureLink = $test.filter(':first').prop('src');
            } else {
                alert("رابط الفيديو غير صالح");

                return false;
            }
        }
        var PC_File = $('#UploadFile_ID')[0].files[0];
        fd.append('LectureMinTime', LictureMiniTime_ID);
        fd.append('Lecture_Name', Lecture_Name);
        fd.append('Category_ID', Category_ID);
        fd.append('DayandTime', DayandTime);
        fd.append('LectureLink_Client', LectureLink);
        fd.append('LectureTypeOnOff', LectureTypeOnOff);
        fd.append('MediaLink', MediaLink);
        fd.append('Others', Description);
        fd.append('DocumentFileUpload', PC_File);
        $("div.spanner").addClass("show");
        $("div.overlay").addClass("show");
        $.ajax(
            {
                async: true,
                type: 'POST',
                data: fd,
                contentType: false,
                processData: false,

                url: '@Url.Action("CreateLectuer", "Controlpanel")',
                success: function (data) {
                    $("div.spanner").addClass("hide");
                    $("div.overlay").addClass("hide");
                    if (data.success == true) {
                        window.location.reload();
                    } else {
                        //console.log(data.responseText);
                        alert(data.responseText);
                    }
                },
                error: function (response) {
                    //console.log(response.responseText);
                    alert(response.responseText);
                },
                complete: function (response) {
                    $("div.spanner").addClass("hide");
                    $("div.overlay").addClass("hide");
                }
            });
    });

    $('#btnUpdate').click(function () {
        $("div.spanner").addClass("show");
        $("div.overlay").addClass("show");
        var fd = new FormData();
        var EditID = $("#EditID").val();
        var Lecture_Name = $("#ELectureName_ID").val();
        var Category_ID = $("#CategoryID").val();
       var ELectureType_ID = $("#ELectureType_ID").val();





        var check = $("#ELictureLink_ID").val();
        var LectureLink = "";
        let result = check.includes("iframe");
        if (result) {
            var $test1 = $($("#ELictureLink_ID").val());

            var LectureLink = $test1.filter(':first').prop('src');
        } else {
            LectureLink = check;
        }

        var EDateTime_ID = $("#EDateTime_ID").val();

        var MediaLink = $("#EotherLink_ID").val();
        var Description = $("#EDescription_ID").val();
        var LictureMiniTime_ID = $("#ELictureMiniTime_ID").val();


        var PC_File = $('#EUploadFile_ID')[0].files[0];

        fd.append('ID', EditID);
        fd.append('Lecture_Name', Lecture_Name);
        fd.append('Category_ID', Category_ID);
        fd.append('DayandTime', EDateTime_ID);
        fd.append('LectureMinTime', LictureMiniTime_ID);
        fd.append('LectureLink_Client', LectureLink);
        fd.append('LectureTypeOnOff', ELectureType_ID);
        fd.append('MediaLink', MediaLink);
        fd.append('Others', Description);
        fd.append('DocumentFileUpload', PC_File);
        $.ajax(
            {
                async: true,
                type: 'POST',
                data: fd,
                contentType: false,
                processData: false,
                url: '@Url.Action("EditLectuer", "Controlpanel")',
                success: function (data) {
                    $("div.spanner").addClass("hide");
                    $("div.overlay").addClass("hide");
                    if (data.success) {
                        window.location.reload();
                    } else {
                        alert(data.responseText);
                    }

                },
                error: function (response) {
                    alert(response.responseText);
                },
                complete: function (response) {
                    $("div.spanner").addClass("hide");
                    $("div.overlay").addClass("hide");
                }
            });
    });

    function GetLectureByID(Lecture_ID) {
        document.getElementById("btnUpdate").disabled = true;
        $.ajax(
            {
                async: true,
                type: 'POST',
                data: { id: Lecture_ID },
                url: '@Url.Action("EditLecture", "Controlpanel")',
                success: function (data) {
                    TypeChangeEdit(data.LectureTypeOnOff);

                    $("#EditID").val(data.ID);
                    $("#CategoryID").val(data.Category_ID);
                    $("#EDateTime_ID").val(data.DayandTime);
                    $("#ELictureMiniTime_ID").val(data.LectureMinTime);

                    $("#ELictureLink_ID").val(data.LectureLink_Client);
                    $("#ELectureName_ID").val(data.Lecture_Name);
                    $("#EotherLink_ID").val(data.MediaLink);
                    $("#EDescription_ID").val(data.Others);
                    $("#ELectureType_ID").val(data.LectureTypeOnOff);

                },
                error: function (response) {
                    alert("the problem is " + response.responseText);
                },
                complete: function (response) {
                    //alert("finish call jasion " + response);
                }
            });
    }
    function btnDelete(ID) {
            const swalWithBootstrapButtons = Swal.mixin({
                customClass: {
                    confirmButton: 'btn btn-success',
                    cancelButton: 'btn btn-danger'
                },
                buttonsStyling: false
            });

        swalWithBootstrapButtons.fire({
            title: 'Are you sure?',
            text: "You won't be able to delete this!",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Delete it!',
            cancelButtonText: 'Cancel!',
            reverseButtons: true
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax(
                    {
                        async: true,
                        type: 'POST',
                        //dataType: 'JSON',
                        //contentType: 'application/json; charset=utf=8',
                        data: { ID: ID },
                        url: '@Url.Action("DeleteLecture", "Controlpanel")',
                        success: function (data) {
                            swalWithBootstrapButtons.fire(
                                'Deleted!',
                                'Your file has been deleted.',
                                'success'
                            ).then(function () { window.location.reload(); })

                        },
                        error: function (response) {
                            swalWithBootstrapButtons.fire(
                                'Filed',
                                response.responseText+' :)',
                                'error'
                            )
                        },
                        complete: function (response) {
                            //alert("finish call jasion " + response);
                        }
                    });

            } else if (
                /* Read more about handling dismissals below */
                result.dismiss === Swal.DismissReason.cancel
            ) {
                swalWithBootstrapButtons.fire(
                    'Cancelled',
                    'Your  file is safe :)',
                    'error'
                )
            }
        })

    }
    function TypeChange(Type_ID) {
        validationAdd();
        if (Type_ID == 1) {
            $("#DivTime_ID").show();
            //$("#DivGenerate_ID").show();
            $("#LectureDIV_ID").hide();
            $("#LectureDivMiniTime_ID").hide();
        }
        else {
            $("#DivTime_ID").hide();
            //$("#DivGenerate_ID").hide();
            $("#LectureDIV_ID").show();
            $("#LectureDivMiniTime_ID").show();
        }
    }
    function TypeChangeEdit(Type_ID) {
        if (Type_ID == 1) {
            $("#EDivTime_ID").show();
            $("#ELectureDivMiniTime_ID").hide();

            //$("#EDivGenerate_ID").show();
            $("#ELectureDIV_ID").hide();
        }
        else {
            $("#EDivTime_ID").hide();
            $("#ELectureDivMiniTime_ID").show();
            //$("#EDivGenerate_ID").hide();
            $("#ELectureDIV_ID").show();
        }
    }
    function FileType(FileType) {
        validationAdd();
        if (FileType == 1) {
            //$("#Categories_ID").disabled = true;

            $("#UploadFileDiv_ID").show();
            $("#LinkDIV_ID").hide();

            $("#EUploadFileDiv_ID").show();
            $("#ELinkDIV_ID").hide();

        }
        else {
            $("#UploadFileDiv_ID").hide();
            $("#LinkDIV_ID").show();
            $("#EUploadFileDiv_ID").hide();
            $("#ELinkDIV_ID").show();
        }
    }

