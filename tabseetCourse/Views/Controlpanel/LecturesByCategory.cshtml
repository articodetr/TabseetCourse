                            if (data[i].LectureLink_Host) {
                                s += '<td>مباشر</td>' +
                                    '<td><a href="' + data[i].LectureLink_Host + '" target="_blank"> للمحاضر  </a>/<a href="' + data[i].LectureLink_Client + '" target="_blank">  للطالب </a></td>';
                            } else {
                                s += '<td>مباشر</td>' +
                                    '<td><a href="' + data[i].LectureLink_Client + '" target="_blank"> رابط المحاضرة المباشرة </a></td>';
                            }
                        } else {
                            s += '<td>مسجلة</td>' +
                                '<td><a href="' + (data[i].LectureLink_Client || '#') + '" target="_blank"> رابط المحاضرة المسجلة </a></td>';
                        }

                        s += '<td>' +
                            '<div class="btn-group">';
                        var LectureEdit = $("#LectureEdit").val();
                        if (LectureEdit != null) {
                            s += '<button class="btn btn-info" onclick="GetLectureByID(' + data[i].ID + ')" data-toggle="modal" data-target="#EditModal">' +
                                '<i class="fas fa-edit">' +
                                '</i>' +
                                'تعديل' +
                                '</button>';
                        }
                        var LectureDelete = $("#LectureDelete").val();
                        if (LectureDelete != null) {

                            s +=   '<button class="btn btn-danger" onclick = "btnDelete(' + data[i].ID + ')" >' +
                                '<i class="fas fa-trash">' +
                                '</i>' +
                                'حذف' +
                                '</button>';
                        }
                        if (data[i].LectureTypeOnOff == 0) {
                            if (data[i].Count > 0) {
                                var AssingmentEdit = $("#AssingmentEdit").val();
                                if (AssingmentEdit != null) {

                                    s += '<button class="btn btn-primary" onclick="ViewAssingment(' + data[i].ID + ')">' +
                                        '<i class="nav-icon fas fa-book">' +
                                        '</i>' +
                                        'عرض الوظيفة' +
                                        '</button>';
                                }
                            } else {
                                var AssingmentView = $("#AssingmentView").val();
                                if (AssingmentView != null) {
                                    s += '<button class="btn btn-default" onclick="addassignment(' + data[i].ID + ')">' +
                                        '<i class="nav-icon fas fa-book">' +
                                        '</i>' +
                                        'اضافة وظيفة' +
                                        '</button>';
                                }
                            }
                        }
                        s += '</div>' +
                             '</td>' +
                             '</tr>';
                    }
                    $("#tableContent_ID").html(s);

                },
                error: function (response) {
                    alert("the problem is " + response.responseText);
                },
                complete: function (response) {
                    $('#example1').DataTable({
                        "paging": true,
                        "lengthChange": true,
                        "searching": true,
                        "ordering": true,
                        "info": true,
                        "autoWidth": true,
