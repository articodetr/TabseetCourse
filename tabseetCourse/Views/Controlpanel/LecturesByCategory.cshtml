
@{
    ViewBag.Title = "LecturesByCategory";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
 
  var viewModel = (tabseetCourse.Models.UserModel)ViewBag._UsermodelModel;
}


<link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700&display=fallback">
<!-- Font Awesome -->
<link rel="stylesheet" href="~/Content/plugins/fontawesome-free/css/all.min.css">
<!-- DataTables -->
<link rel="stylesheet" href="~/Content/plugins/datatables-bs4/css/dataTables.bootstrap4.min.css">
<link rel="stylesheet" href="~/Content/plugins/datatables-responsive/css/responsive.bootstrap4.min.css">
<link rel="stylesheet" href="~/Content/plugins/datatables-buttons/css/buttons.bootstrap4.min.css">
<!-- Theme style -->
<link rel="stylesheet" href="~/Content/dist/css/adminlte.min.css">
<script src="//cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>المحاضرات لمادة @ViewBag.Name</h1>
                <input type="hidden" value="@ViewBag.Name" id="lectureName_ID" />
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                </ol>
            </div>
        </div>
    </div><!-- /.container-fluid -->
</section>

<div class="card">
    <div class="card-header">
        @if (viewModel != null && viewModel.L_role.Count > 0)
        {
            foreach (var item in viewModel.L_role)
            {
                if (item.RoleName == "Admin" || item.RoleName == "LectureView")
                {
                    <input type="button" value="اضافة محاضرة جديد" id="addNew" data-toggle="modal" data-target="#modal-lg" class="btn btn-success float-left" />
                }
                if (item.RoleName == "Admin" || item.RoleName == "LectureEdit")
                {
                    <input type="hidden" value="LectureEdit" id="LectureEdit" />
                }
                if (item.RoleName == "Admin" || item.RoleName == "LectureDelete")
                {
                    <input type="hidden" value="LectureDelete" id="LectureDelete" />
                }
                if (item.RoleName == "Admin" || item.RoleName == "AssingmentView")
                {
                    <input type="hidden" value="AssingmentView" id="AssingmentView" />
                }
                if (item.RoleName == "Admin" || item.RoleName == "AssingmentEdit")
                {
                    <input type="hidden" value="AssingmentEdit" id="AssingmentEdit" />

                }

            }
        }
    </div>
    <!-- /.card-header -->
    <div class="card-body">
        <input type="text" value="@ViewBag.CategoryID" hidden="hidden" id="CategoryID" />
        <table id="example1" class="table table-bordered table-hover">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>الاسم المحاضرة</th>

                    <th>الفئة</th>
                    <th>نوع المحاضرة</th>
                    <th>رابط دخول المحاضرة</th>


                    <th> </th>

                </tr>
            </thead>
            <tbody id="tableContent_ID">
            </tbody>
            <tfoot>
                <tr>
                    <th>ID</th>
                    <th>الاسم المحاضرة</th>

                    <th>الفئة</th>
                    <th>نوع المحاضرة</th>
                    <th>رابط دخول المحاضرة</th>



                    <th></th>
                </tr>
            </tfoot>
        </table>
    </div>
    <!-- /.card-body -->
</div>

<div class="modal fade" id="modal-lg">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">إضافة محاضرة</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <table style="width:100%">
                    <tr>
                        <td colspan="3">
                            <div class="row">
                                <div class="col-sm-12">
                                    <!-- select -->
                                    <div class="form-group">
                                        <label>إسم المحاضرة</label><label style="color:red">*</label>
                                        <input type="text" id="LectureName_ID" onkeyup="validationAdd()" class="form-control" style="width:100%" placeholder="اسم الفئة" required />
                                        @*<span id="reqNameAR_ID" style="color:red"></span>*@
                                    </div>
                                </div>
                            </div>
                        </td>


                    </tr>
                    <tr>
                        <td>

                            <div class="row">
                                <div class="col-sm-12">
                                    <!-- select -->
                                    <div class="form-group">
                                        <label>نوع </label><label style="color:red">*</label>
                                        <select id="LectureType_ID" class="form-control" onchange="TypeChange(this.value)" required>
                                            <option value="1">مباشر</option>
                                            <option value="0">مسجلة</option>
                                        </select>

                                    </div>

                                </div>
                            </div>
                        </td>
                        <td>
                            <div class="row">
                                <div class="col-sm-12" id="DivTime_ID">
                                    <div class="form-group">
                                        <label>وقت</label><label style="color:red">*</label>
                                        <input type="datetime-local" id="DateTime_ID" onchange="validationAdd()" class="form-control" />
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-12" id="LectureDivMiniTime_ID">
                                    <div class="form-group">
                                        <label> الوقت الاصغري للحضور بلدقيقة</label>
                                        <input type="number" id="LictureMiniTime_ID" class="form-control" value="0" min="0" max="90" onchange="validationAdd()" style="width:100%" required placeholder="Mini Time" />
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="3">
                            <div class="row">
                                <div class="col-sm-12" id="LectureDIV_ID">
                                    <div class="form-group">
                                        <label>رابط الفيديو</label><label style="color:red">*</label>
                                        <input type="url" id="LictureLink_ID" class="form-control" onkeyup="validationAdd()" style="width:100%" required placeholder="URL LINK" />
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td>

                            <div class="row">
                                <div class="col-sm-12">
                                    <!-- select -->
                                    <div class="form-group">
                                        <label>نوع الملف </label>
                                        <select id="DocType" class="form-control" onchange="FileType(this.value)" required>
                                            <option value="1">تحميل ملف</option>
                                            <option value="0">روابط</option>
                                        </select>

                                    </div>

                                </div>
                            </div>
                        </td>
                        <td colspan="2">
                            <div class="row">
                                <div class="col-sm-12" id="UploadFileDiv_ID">
                                    <!-- select -->
                                    <div class="form-group">
                                        <label>ملفات</label>
                                        <input type="file" id="UploadFile_ID" class="form-control" onchange="validationAdd()" required accept="application/pdf" />

                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-12">
                                    <!-- select -->
                                    <div class="form-group" id="LinkDIV_ID">
                                        <label>روابط اخرى</label>
                                        <input type="url" id="otherLink_ID" class="form-control" onkeyup="validationAdd()" style="width:100%" required placeholder="URL LINK" />
                                        @*<span id="reqCategory_ID" style="color:red"></span>*@

                                    </div>
                                </div>
                            </div>
                        </td>

                    </tr>
                    <tr>
                        <td colspan="3">
                            <div class="row">
                                <div class="col-sm-12">
                                    <!-- select -->
                                    <div class="form-group">
                                        <label>وصف </label>
                                        <input type="text" multiple name="Text1" id="Description_ID" onkeyup="validationAdd()" cols="40" rows="3" class="form-control" />

                                        @*<span id="reqNameAR_ID" style="color:red"></span>*@
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>

                </table>
            </div>
            <div class="modal-footer justify-content-between">
                <button type="button" class="btn btn-default" data-dismiss="modal">الغاء</button>
                <button type="button" class="btn btn-primary" id="btnSave">حفظ</button>
            </div>
        </div>
        <!-- /.modal-content -->
    </div>
    <!-- /.modal-dialog -->
</div>

