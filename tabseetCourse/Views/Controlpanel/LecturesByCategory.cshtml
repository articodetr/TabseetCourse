                success: function (data) {
                    var s = '';
                    for (var i = 0; i < data.length; i++) {
                        s += '<tr>' +
                            '<td>' + data[i].ID + '</td>' +
                            '<td>' + data[i].Lecture_Name + '</td>' +
                            '<td>' + data[i].NameAr + '</td>';
