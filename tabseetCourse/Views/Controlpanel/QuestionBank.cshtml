<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>الأسئلة</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                </ol>
            </div>
        </div>
    </div><!-- /.container-fluid -->
</section>

<div class="card">
    <div class="card-header">
        @if (viewModel != null && viewModel.L_role.Count > 0)
        {
            foreach (var item in viewModel.L_role)
            {
                if (item.RoleName == "Admin" || item.RoleName == "QuestionBankView")
                {
                    <div>
                        <input type="button" value="إضافة سؤال" id="addNew" data-toggle="modal" data-target="#modal-lg" class="btn btn-success float-left" />
                    </div>
                    <div>
                        <input type="button" value="Upload Excel File" data-toggle="modal" data-target="#modal-Excel" class="btn btn-info float-left" />
                    </div>
                }
                if (item.RoleName == "Admin" || item.RoleName == "QuestionBankEdit")
                {
                    <input type="hidden" value="QuestionBankEdit" id="QuestionBankEdit" />
                }
                if (item.RoleName == "Admin" || item.RoleName == "QuestionBankDelete")
                {
                    <input type="hidden" value="QuestionBankDelete" id="QuestionBankDelete" />
                }
            }
        }
    </div>
    <!-- /.card-header -->
    <div class="card-body">
        <input type="text" value="@ViewBag.CategoryID" hidden="hidden" id="CategoryID" />
        <table id="example1" class="table table-bordered table-hover">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>النمط</th>
                    <th>الفئة</th>
                    <th>إسم السؤال</th>


                    <th> </th>

                </tr>
            </thead>
            <tbody id="tableContent_ID">
            </tbody>
            <tfoot>
                <tr>
                    <th>ID</th>
                    <th>النمط</th>
                    <th>الفئة</th>
                    <th>إسم السؤال</th>


                    <th></th>
                </tr>
            </tfoot>
        </table>
    </div>
    <!-- /.card-body -->
</div>

<div class="modal fade" id="modal-Excel" role="dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">إضافة السؤال</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <table class="table table-active">
                    <tr>
                        <td>
                            <label>نمط السؤال</label>
                        </td>

                    </tr>
                    <tr>

                        <td>
                            <select id="Q_Type1" data-placeholder="Your Favorite Football Team" class="chosen" style="width: 100%;">
                                <option value="1">صح او خطأ</option>
                                <option value="2">خيار من متعدد</option>
                                @*<option value="3">وصل بين الخيارات</option>*@
                            </select>
                        </td>

                    </tr>
                </table>
                <div>
                    <label>Excel File</label>
                    <input type="file" id="EUploadFile" class="form-control" />
                    <input type="button" onclick="UploadExcel()" class="btn btn-primary" value="Upload" />

                </div>
            </div>
            <div class="modal-footer justify-content-between">
                <button type="button" class="btn btn-default" data-dismiss="modal">الغاء</button>

            </div>
        </div>
        <!-- /.modal-content -->
    </div>
    <!-- /.modal-dialog -->
</div>
