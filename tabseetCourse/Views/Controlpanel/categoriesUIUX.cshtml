<script>
    $(document).ready(function () {
        document.getElementById("btnSave").disabled = true;
        document.getElementById("btnUpdate").disabled = true;



        $.ajax(
            {
                async: true,
                type: 'POST',

                url: '@Url.Action("GetAllCategoryType", "Controlpanel")',
                success: function (data) {
                    var s = '<option value=0> Select Type </option>';
                    for (var i = 0; i < data.length; i++) {
                        s += '<option value="' + data[i].ID + '">' + data[i].NameAR + '</option>';
                    }
                    $("#Type_ID").html(s);
                    $("#EType_ID").html(s);
                },
                error: function (response) {
                    alert("the problem is " + response.responseText);
                },
                complete: function (response) {
                    //alert("finish call jasion " + response);
                }
            });
    });
    function validationAdd() {
        var NameAR_ID = $("#NameAR_ID").val();
        var UploadFile = $("#UploadFile").val();
        var Type_ID = $("#Type_ID").val();
        if (NameAR_ID != "" && UploadFile != "" && Type_ID!=0) {
            document.getElementById("btnSave").disabled = false;
        } else
            document.getElementById("btnSave").disabled = true;
    }

    function validationEdit() {
        var NameAR_ID = $("#ENameAR_ID").val();
        //var UploadFile = $("#EUploadFile").val();
        var Type_ID = $("#EType_ID").val();
        console.log("Type_ID" + Type_ID);
        console.log("NameAR_ID;" + NameAR_ID);
        if (NameAR_ID != ""   && Type_ID != 0) {
            document.getElementById("btnUpdate").disabled = false;
        } else
            document.getElementById("btnUpdate").disabled = true;
    }

    $(function () {
        $('#example1').DataTable({
            "paging": true,
            "lengthChange": true,
            "searching": true,
            "ordering": true,
            "info": true,
            "autoWidth": true,
            "responsive": true,
            "buttons": ["copy", /*"csv",*/ "excel",   "colvis"]
        }).buttons().container().appendTo('#example1_wrapper .col-md-6:eq(0)');

    });

    const checkbox = document.getElementById('IsPayed_ID');

    checkbox.addEventListener('change', (event) => {
        if (event.currentTarget.checked) {
            $("#PayedValueDIV_ID").show();
            $("#IsPayed_ID").val(1);
        } else {
            $("#PayedValueDIV_ID").hide();
            $("#IsPayed_ID").val(0);
        }
    });
    const Echeckbox = document.getElementById('EIsPayed_ID');
    Echeckbox.addEventListener('change', (event) => {
        if (event.currentTarget.checked) {
            $("#EPayedValueDIV_ID").show();
            $("#EIsPayed_ID").val(1);
        } else {
            $("#EPayedValueDIV_ID").hide();
            $("#EIsPayed_ID").val(0);
        }
    });

    $('#btnSave').click(function () {

        validationAdd();
        var fd = new FormData();

        var NameAR_ID = $("#NameAR_ID").val();
        var NameEN_ID = $("#NameEN_ID").val();
        var Type_ID = $("#Type_ID").val();
        var timeEnd = $("#timeEnd").val();
        var discription_ID = $("#discription_ID").val();

        var ispayed = document.getElementById('IsPayed_ID').checked;
        var IsPayed_ID = 0;
        if (ispayed == true) {
             IsPayed_ID = 1;
        } else {
             IsPayed_ID = 0;
        }
        var CanRegister = document.getElementById('CanRegister').checked;
        var CanRegister_ID = 1;
        if (CanRegister == false) {
            CanRegister_ID = 0;
        } else {
            CanRegister_ID = 1;
        }


        var PayedValue_ID = $("#PayedValue_ID").val();
        var Categories_ID = $("#Categories_ID").val();
        var PCImage_ID = $('#UploadFile')[0].files[0];
        var PCImage_IDEN = $('#UploadFileEN')[0].files[0];

        var UploadIconFile = $('#UploadIconFile')[0].files[0];
        var UploadFilePost = $('#UploadFilePost')[0].files[0];

        fd.append("NameAR",NameAR_ID);
        fd.append("NameEN", NameEN_ID);
        fd.append("CategoryType_ID",Type_ID);
        fd.append("IsPayed",IsPayed_ID);
        fd.append("PayedValue",PayedValue_ID);
        fd.append("ParentCateogry_ID",Categories_ID);
        fd.append("FileImagePost", PCImage_ID);
        fd.append("FileImagePost_EN", PCImage_IDEN);
        fd.append("timeEnd", timeEnd);
        fd.append("CanRegister", CanRegister_ID);

        fd.append("UploadIcon", UploadIconFile);
        fd.append("UploadDocumentBook", UploadFilePost);
        fd.append("Description", discription_ID);
        //var dataJson = JSON.stringify(fd);
        $("div.spanner").addClass("show");
        $("div.overlay").addClass("show");
        $.ajax(
            {
                async: true,
                type: 'POST',
                data: fd,
                contentType: false,
                processData: false,
                url: '@Url.Action("CreateCategories", "Controlpanel")',
                success: function (data) {
                    $("div.spanner").addClass("hide");
                    $("div.overlay").addClass("hide");
                    window.location.reload();
                },
                error: function (response) {

                    alert("the problem is " + response.responseText);
                },
                complete: function (response) {
                    $("div.spanner").addClass("hide");
                    $("div.overlay").addClass("hide");
                }
            });
    });
    $('#btnUpdate').click(function () {
        validationAdd();
        var fd = new FormData();

        var EditID = $("#EditID").val();
        var ENameAR_ID = $("#ENameAR_ID").val();
        var ENameEN_ID = $("#ENameEN_ID").val();
        var EType_ID = $("#EType_ID").val();
        var ECategories_ID = $("#ECategories_ID").val();
        var timeEnd = $("#EtimeEnd").val();
        var ispayed = document.getElementById('EIsPayed_ID').checked;
        if (ispayed == true) {
            var EIsPayed_ID = 1;
        } else {
            var EIsPayed_ID = 0;
        }
        var CanRegister = document.getElementById('ECanRegister').checked;
        var CanRegister_ID = 1;
        if (CanRegister == false) {
            CanRegister_ID = 0;
        } else {
            CanRegister_ID = 1;
        }
        var EPayedValue_ID = $("#EPayedValue_ID").val();

        var PCImage_ID = $('#EUploadFile')[0].files[0];
        var PCImage_IDEN = $('#EUploadFileEN')[0].files[0];
        var UploadIconFile = $('#EUploadIconFile')[0].files[0];
        var UploadFilePost = $('#EUploadFilePost')[0].files[0];
        var discription_ID = $("#Ediscription_ID").val();
        fd.append("ID",EditID);
        fd.append("NameAR", ENameAR_ID);
        fd.append("NameEN", ENameEN_ID);
        fd.append("CategoryType_ID", EType_ID);
        fd.append("IsPayed", EIsPayed_ID);
        fd.append("PayedValue", EPayedValue_ID);
        fd.append("ParentCateogry_ID", ECategories_ID);
        fd.append("FileImagePost", PCImage_ID);
        fd.append("FileImagePost_EN", PCImage_IDEN);
        fd.append("timeEnd", timeEnd);
        fd.append("CanRegister", CanRegister_ID);
        fd.append("UploadIcon", UploadIconFile);
        fd.append("UploadDocumentBook", UploadFilePost);
        fd.append("Description", discription_ID);
        $("div.spanner").addClass("show");
        $("div.overlay").addClass("show");
        $.ajax(
            {
                async: true,
                type: 'POST',
                data: fd,
                contentType: false,
                processData: false,
                url: '@Url.Action("EditeCategories", "Controlpanel")',
                success: function (data) {
                    $("div.spanner").addClass("hide");
                    $("div.overlay").addClass("hide");
                    window.location.reload();
                },
                error: function (response) {
                    alert("the problem is " + response.responseText);
                },
                complete: function (response) {
                    $("div.spanner").addClass("hide");
                    $("div.overlay").addClass("hide");
                    //alert("finish call jasion " + response);
                }
            });
    });

    function GetCategoryByID(categoryID) {

        $.ajax(
            {
                async: true,
                type: 'POST',
                data: { catID: categoryID },
                url: '@Url.Action("EditCategorie", "Controlpanel")',
                success: function (data) {
                    TypeChange(data.CategoryType_ID);
                    $("#EditID").val(data.ID);
                    $("#ENameAR_ID").val(data.NameAr);
                    $("#ENameEN_ID").val(data.NameEn);
                    $("#Ediscription_ID").val(data.Description);

                    if (data.IsPayed == 1) {
                        $("#EIsPayed_ID").val(1);
                        $("#EPayedValueDIV_ID").show();
                        $("#EIsPayed_ID").val(1);
                        $("#EIsPayed_ID").prop("checked", true);

                    } else {
                        $("#EIsPayed_ID").val(0);
                        $("#EPayedValueDIV_ID").show();
                        $("#EIsPayed_ID").val(0);
                        $("#EIsPayed_ID").prop("checked", false);

                    }
                    if (data.CanRegister == 1) {

                        $("#ECanRegister").prop("checked", true);
                    } else {
                        $("#ECanRegister").prop("checked", false);
                    }
                    $("#EtimeEnd").val(data.timeEnd);
                    $("#EType_ID").val(data.CategoryType_ID);
                    $("#ECategories_ID").val(data.ParentCateogry_ID);

                    $("#EPayedValue_ID").val(data.PayedValue);

                },
                error: function (response) {
                    alert("the problem is " + response.responseText);
                },
                complete: function (response) {
                    //alert("finish call jasion " + response);
                }
            });
    }

    function btnDelete(ID) {
            const swalWithBootstrapButtons = Swal.mixin({
                customClass: {
                    confirmButton: 'btn btn-success',
                    cancelButton: 'btn btn-danger'
                },
                buttonsStyling: false
            });

        swalWithBootstrapButtons.fire({
            title: 'Are you sure?',
            text: "You won't be able to delete this!",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Delete it!',
            cancelButtonText: 'Cancel!',
            reverseButtons: true
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax(
                    {
                        async: true,
                        type: 'POST',
                        //dataType: 'JSON',
                        //contentType: 'application/json; charset=utf=8',
                        data: { Categories_ID: ID },
                        url: '@Url.Action("DeleteCategories", "Controlpanel")',
                        success: function (data) {
                            swalWithBootstrapButtons.fire(
                                'Deleted!',
                                'Your file has been deleted.',
                                'success'
                            ).then(function () { window.location.reload(); })

                        },
                        error: function (response) {
                            swalWithBootstrapButtons.fire(
                                'Filed',
                                response.responseText+' :)',
                                'error'
                            )
                        },
                        complete: function (response) {
                            //alert("finish call jasion " + response);
                        }
                    });

            } else if (
                /* Read more about handling dismissals below */
                result.dismiss === Swal.DismissReason.cancel
            ) {
                swalWithBootstrapButtons.fire(
                    'Cancelled',
                    'Your  file is safe :)',
                    'error'
                )
            }
        })

    }

    function TypeChange(Type_ID) {
        validationAdd();


            $.ajax(
                {
                    async: true,
                    type: 'POST',
                    data: { type: Type_ID },
                    url: '@Url.Action("GetCategoriesByType", "Controlpanel")',
                    success: function (data) {
                        if (data.length > 0) {
                            var s = '<option> Select Type </option>';
                            for (var i = 0; i < data.length; i++) {
                                s += '<option value="' + data[i].ID + '">' + data[i].NameAr + '</option>';
                            }
                            $("#Categories_ID").html(s);
                            $("#ECategories_ID").html(s);
                            $("#categoryDiv_ID").show();
                            $("#EcategoryDiv_ID").show();
                        } else {
                            $("#categoryDiv_ID").hide();
                            $("#EcategoryDiv_ID").hide();
                            $("#Categories_ID").html("");
                            $("#ECategories_ID").html("");
                        }

                    },
                    error: function (response) {
                        alert("the problem is " + response.responseText);
                    },
                    complete: function (response) {
                        //alert("finish call jasion " + response);
                    }
                });

    }


    const canRegcheck = document.getElementById('CanRegister');
    canRegcheck.addEventListener('change', (event) => {
        if (event.currentTarget.checked) {
            $('#TimeEndDiv').show();
            $('#IsPayedDIV').show();
            $('#PayedValueDIV_ID').show();
        } else {
            $('#TimeEndDiv').hide();
            $('#IsPayedDIV').hide();
            $('#PayedValueDIV_ID').hide();
        }
    });

    const EcanRegcheck = document.getElementById('ECanRegister');
    EcanRegcheck.addEventListener('change', (event) => {
        if (event.currentTarget.checked) {
            $('#ETimeEndDiv').show();
            $('#EIsPayedDIV_ID').show();
            $('#EPayedValueDIV_ID').show();
        } else {
            $('#ETimeEndDiv').hide();
            $('#EIsPayedDIV_ID').hide();
            $('#EPayedValueDIV_ID').hide();
        }
    });



</script>