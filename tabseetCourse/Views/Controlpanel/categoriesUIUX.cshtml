<style>



    .spanner {
        position: absolute;
        top: 50%;
        left: 0;
        background: #2a2a2a55;
        width: 100%;
        display: block;
        text-align: center;
        height: 300px;
        color: #FFF;
        transform: translateY(-50%);
        z-index: 1000;
        visibility: hidden;
    }

    .overlay {
        position: fixed;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.5);
        visibility: hidden;
    }

    .loader,
    .loader:before,
    .loader:after {
        border-radius: 50%;
        width: 2.5em;
        height: 2.5em;
        -webkit-animation-fill-mode: both;
        animation-fill-mode: both;
        -webkit-animation: load7 1.8s infinite ease-in-out;
        animation: load7 1.8s infinite ease-in-out;
    }

    .loader {
        color: #ffffff;
        font-size: 10px;
        margin: 400px auto;
        position: relative;
        text-indent: -9999em;
        -webkit-transform: translateZ(0);
        -ms-transform: translateZ(0);
        transform: translateZ(0);
        -webkit-animation-delay: -0.16s;
        animation-delay: -0.16s;
    }

        .loader:before,
        .loader:after {
            content: '';
            position: absolute;
            top: 0;
        }

        .loader:before {
            left: -3.5em;
            -webkit-animation-delay: -0.32s;
            animation-delay: -0.32s;
        }

        .loader:after {
            left: 3.5em;
        }

    @@-webkit-keyframes load7 {
        0%,
        80%,
        100% {
            box-shadow: 0 2.5em 0 -1.3em;
        }

        40% {
            box-shadow: 0 2.5em 0 0;
        }
    }

    @@keyframes load7 {
        0%,
        80%,
        100% {
            box-shadow: 0 2.5em 0 -1.3em;
        }

        40% {
            box-shadow: 0 2.5em 0 0;
        }
    }

    .show {
        visibility: visible;
    }

    .spanner, .overlay {
        opacity: 0;
        -webkit-transition: all 0.3s;
        -moz-transition: all 0.3s;
        transition: all 0.3s;
    }

        .spanner.show, .overlay.show {
            opacity: 1;
            z-index: 999999;
            height: 100%;
        }
</style>
<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1> الفئات</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                </ol>
            </div>
        </div>
    </div><!-- /.container-fluid -->
</section>

<div class="card">
    <div class="card-header">
        @if (viewModel != null && viewModel.L_role.Count > 0)
        {
            foreach (var item in viewModel.L_role)
            {
                if (item.RoleName == "Admin" || item.RoleName == "CategoriesView")
                {
                    <input type="button" value="اضافة فئة جديد" id="addNew" data-toggle="modal" data-target="#modal-lg" class="btn btn-success float-left">
                    break;
                }
            }
        }
    </div>
    <!-- /.card-header -->
    <div class="card-body">
        <table id="example1" class="table table-bordered table-hover">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>الاسم</th>
                    <th>Name</th>
                    <th>الفئة</th>
                    <th>تابعة ل</th>
                    <th>مدفوعة</th>
                    <th>قيمة الدفعة</th>
                    <th>متاح للتسجيل</th>

                    <th> </th>

                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.ID</td>
                        <td>@item.NameAr</td>
                        <td>@item.NameEn</td>
                        <td>@item.CategoryTypeName</td>
                        <td>@item.ParentCategoryName</td>


                        @if (item.IsPayed == 0)
                        {
                            <td>
                                مجانية
                            </td>
                        }
                        else
                        {
                            <td>
                                مدفوعة
                            </td>
                        }
                        <td>@item.PayedValue</td>

                        @if (item.CanRegister == 1)
                        {
                            <td>
                                نعم
                            </td>
                        }
                        else
                        {
                            <td>
                                لا
                            </td>
                        }
                        <td>
                            <div class="btn-group">
                                @if (viewModel != null && viewModel.L_role.Count > 0)
                                {
                                    foreach (var item2 in viewModel.L_role)
                                    {
                                        if (item2.RoleName == "Admin" || item2.RoleName == "CategoriesEdit")
                                        {
                                            <button class="btn btn-info" onclick="GetCategoryByID(@item.ID)" data-toggle="modal" data-target="#EditModal">
                                                <i class="fas fa-edit">
                                                </i>
                                                تعديل
                                            </button>
                                            break;
                                        }
                                    }
                                }

                                @if (viewModel != null && viewModel.L_role.Count > 0)
                                {
                                    foreach (var item2 in viewModel.L_role)
                                    {
                                        if (item2.RoleName == "Admin" || item2.RoleName == "CategoriesDelete")
                                        {
                                            <button class="btn btn-danger" onclick="btnDelete(@item.ID)">
                                                <i class="fas fa-trash">
                                                </i>
                                                حذف
                                            </button>
                                            break;
                                        }
                                    }
                                }
                                @if (viewModel != null && viewModel.L_role.Count > 0)
                                {
                                    foreach (var item2 in viewModel.L_role)
                                    {
                                        if (item2.RoleName == "Admin" || item2.RoleName == "LectureView" || item2.RoleName == "LectureDelete" || item2.RoleName == "LectureEdit")
                                        {
                                            <button class="btn btn-primary" onclick="location.href='@Url.Action("LecturesByCategory", "Controlpanel",new {Category_ID= item.ID , categoryName= item.NameAr })'">
                                                <i class="nav-icon fas fa-book">
                                                </i>
                                                المحاضرات
                                            </button>
                                            break;
                                        }
                                    }
                                }

                                @if (item.exam_Name == null)
                                {
                                    if (viewModel != null && viewModel.L_role.Count > 0)
                                    {
                                        foreach (var item2 in viewModel.L_role)
                                        {
                                            if (item2.RoleName == "Admin" || item2.RoleName == "ExamView")
                                            {
                                                <button class="btn  btn-warning" onclick="location.href='@Url.Action("Exams", "Controlpanel", new { Category_ID = item.ID, categoryName = item.NameAr })'">

                                                    <i class="nav-icon fas fa-file"></i>
                                                    إضافة امتحان

                                                </button>
                                            }
                                            break;
                                        }
                                    }
                                }
                                else
                                {
                                    if (viewModel != null && viewModel.L_role.Count > 0)
                                    {
                                        foreach (var item2 in viewModel.L_role)
                                        {
                                            if (item2.RoleName == "Admin" || item2.RoleName == "ExamEdit")
                                            {
                                                <button class="btn btn-default" onclick="location.href='@Url.Action("ViewExam", "Controlpanel", new { Category_ID = item.ID })'">

                                                    <i class="nav-icon fas fa-file"></i>
                                                    تعديل الامتحان

                                                </button>
                                            }
                                            break;
                                        }
                                    }
                                }


                            </div>
                        </td>
                    </tr>

                }

            </tbody>
            <tfoot>
                <tr>
                    <th>ID</th>
                    <th>الاسم</th>
                    <th>Name</th>
                    <th>الفئة</th>
                    <th>تابعة ل</th>
                    <th>مدفوعة</th>
                    <th>قيمة الدفعة</th>
                    <th>متاح للتسجيل</th>

                    <th></th>
                </tr>
            </tfoot>
        </table>
    </div>
    <!-- /.card-body -->
</div>

