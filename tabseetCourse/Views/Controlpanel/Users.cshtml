<script>
    $(function () {

        $("#RoeleTable").hide();
        $('.select2').select2();
        getAllUsers();
        EraseData();
    });

    function getAllUsers() {

        $.ajax(
            {
                async: true,
                type: 'POST',
                url: '@Url.Action("GetUsers", "Controlpanel")',
                success: function (data) {
                    var s = '';
                    for (var i = 0; i < data.length; i++) {

                        s += '<tr>' +

                            '<td>#</td>' +
                            '<td>' + data[i].RealName + '</td>' +
                            '<td>' + data[i].Email + '</td>' +
                            '<td>' + data[i].PhoneNumber + '</td><td>';
                        for (var j = 0; j < data[i].L_role.length; j++) {
                           s+= data[i].L_role[j].RoleName+'<br>'

                        }

                        s += '</td><td>' + data[i].Password + '</td>' +
                             '<td>' +
                             '<div class="btn-group">' +
                            '<button class="btn btn-info" onclick="GetUserByID(' + "'" + data[i].ID + "'" + ')" data-toggle="modal" data-target="#modal-lg">' +
                             '<i class="fas fa-edit">' +
                             '</i>تعديل</button>'+
                            '<button class="btn btn-danger" onclick="btnDelete(' + "'" + data[i].ID + "'" + ')">'+
                             '<i class="fas fa-trash">' +
                             '</i>حذف</button>' +
                             '</div></td></tr>';
                    }
                    $("#tableContent_ID").html(s);

                },
                error: function (response) {

                },
                complete: function (response) {
                    $('#example1').DataTable({
                        "paging": true,
                        "lengthChange": true,
                        "searching": true,
                        "ordering": true,
                        "info": true,
                        "autoWidth": true,
                        "responsive": true,
                        "buttons": ["copy", /*"csv",*/ "excel", /*"pdf",*/ "print", "colvis"]
                    }).buttons().container().appendTo('#example1_wrapper .col-md-6:eq(0)');
                }
            });
    }

    function EraseData() {
        $("#CodeGenerate").prop("checked", false);
        $("#Chat").prop("checked", false);
        $("#PaymentActive").prop("checked", false);
        $("#PaymentView").prop("checked", false);
        $("#UsersTeachersEdit").prop("checked", false);
        $("#UsersTeachersView").prop("checked", false);
        $("#UsersTeachersDelete").prop("checked", false);
        $("#UsersStudentView").prop("checked", false);
        $("#UsersStudentDelete").prop("checked", false);
        $("#UsersStudentEdit").prop("checked", false);
        $("#ExamEdit").prop("checked", false);
        $("#ExamDelet").prop("checked", false);
        $("#ExamView").prop("checked", false);
        $("#AssingmentEdit").prop("checked", false);
        $("#AssingmentDelete").prop("checked", false);
        $("#AssingmentView").prop("checked", false);
        $("#QuestionBankEdit").prop("checked", false);
        $("#QuestionBankDelete").prop("checked", false);
        $("#QuestionBankView").prop("checked", false);
        $("#LectureEdit").prop("checked", false);
        $("#LectureDelete").prop("checked", false);
        $("#LectureView").prop("checked", false);
        $("#CategoriesEdit").prop("checked", false);
        $("#CategoriesDelete").prop("checked", false);
        $("#CategoriesView").prop("checked", false);


        $("#selectedRole_ID").val("Admin");
        $("#RoeleTable").hide();
        $("#EID").val(null);
        $("#FullName_ID").val("");
        $("#PhoneNumber_ID").val("");

        $("#Email_ID").val("");
        $("#Password_ID").val("");
    }

    $('#btnSave').click(function () {
        const swalWithBootstrapButtons = Swal.mixin({});
        var fd = new FormData();
        var ID = $("#EID").val();
        var Fullname = $("#FullName_ID").val();
        var PhoneNumber_ID = $("#PhoneNumber_ID").val();
        var Email_ID = $("#Email_ID").val();
        var Password = $("#Password_ID").val();
        var selectedRole_ID = $("#selectedRole_ID").val();
        var L_role = new Array();
        if (selectedRole_ID == "Admin") {
            var Role = {};
            Role.RoleName = "Admin";
            L_role.push(Role);
        } else {
            arryRole = getSelectedCheckboxValues('rolecheckbox');
            for (var i = 0; i < arryRole.length; i++) {

                var Role = {};
                Role.RoleName = arryRole[i];
                console.log(Role.RoleName);
                L_role.push(Role);

            }
        }


        //var PC_File = $('#customFile')[0].files[0];
        fd.ID = ID;
        fd.RealName= Fullname;
        fd.Email=Email_ID;
        fd.PhoneNumber=PhoneNumber_ID;
        fd.Password= Password;
        //fd.Image_File = PC_File;
        fd.L_role = L_role;

        var dataJson = JSON.stringify(fd);
        $.ajax(
            {
                async: true,

                type: 'POST',
                dataType: 'JSON',
                contentType: 'application/json; charset=utf=8',
                data: dataJson,
                url: '@Url.Action("CreateUser", "Controlpanel")',
                success: function (data) {
                    swalWithBootstrapButtons.fire(
                        'تم الحفظ!',
                        'تم اضافة المدرس بنجاح.',
                        'success'
                    ).then(function () {
                        EraseData();
                        window.location.reload();

                    });
                },
                error: function (response) {
                    swalWithBootstrapButtons.fire(
                        'Filed',
                        response.responseText + ' :)',
                        'error'
                    )
                },
                complete: function (response) {
                }
            });
    });



    function GetUserByID(ID) {
        //EraseData();
        $.ajax(
            {
                async: true,
                type: 'POST',
                data: { UserID: ID },
                url: '@Url.Action("GetUserByID", "Controlpanel")',
                success: function (data) {
                    //EraseData();
                    $("#EID").val(data.ID);
                    $("#FullName_ID").val(data.RealName);
                    $("#PhoneNumber_ID").val(data.PhoneNumber);

                    $("#Email_ID").val(data.Email);
                    $("#Password_ID").val(data.Password);
                    arryRole = getSelectedCheckboxValues('rolecheckbox');
                    for (var i = 0; i < arryRole.length; i++) {

                        $("#" + arryRole[i] ).prop("checked", false);
                    }
                    for (var i = 0; i < data.L_role.length; i++) {
                        if (data.L_role[i].RoleName != "Admin") {
                            $("#selectedRole_ID").val("User");
                            $("#RoeleTable").show();
                            $("#" + data.L_role[i].RoleName).prop("checked", true);
                            //console.log(data.L_role[i].RoleName);
                        }
                        else {
                            $("#selectedRole_ID").val("Admin");
                            $("#RoeleTable").hide();

                        }
