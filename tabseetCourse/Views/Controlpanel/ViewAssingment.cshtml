<!-- Summernote -->
<script src="~/Content/plugins/summernote/summernote-bs4.min.js"></script>
<script src="~/Scripts/CustomJavascript.js"></script>
<script type="text/javascript">

        $(document).ready(function () {
            document.getElementById("btnSave").disabled = true;
            $('#summernote_ID').summernote();
            $('#summernote_ID').on('summernote.change', function (we, e) {

                var summernote = $("#summernote_ID").summernote('code');
                $('#Assingment_Text').val(summernote);
                //console.log(summernote);
            });
            GetQuesiont();
            GetAssingmentByID();

        });
        function GetAssingmentByID() {
            var value=$('#AssignmentID').val();
            $("div.spanner").addClass("show");
            $("div.overlay").addClass("show");
               $.ajax(
                {
                    async: true,
                    type: 'POST',
                       data: { Assingment_ID: value },

                    url: '@Url.Action("GetAssignmentByID", "Controlpanel")',
                       success: function (data) {
                           $("div.spanner").removeClass("show");
                           $("div.overlay").removeClass("show");
                           $("div.spanner").addClass("hide");

                           $("div.overlay").addClass("hide");
                           $("#summernote_ID").summernote('code', data.Description);
                           $('#Assingment_Name').val(data.Name);

                        var degry = 0;
                        var count = 0;
                        var output = '<tr><td></td><td>اسم السؤال</td><td>نوع السؤال</td><td>الدرجة</td><td></td></tr >';
                           for (var i = 0; i < data.L_Assignment_Q.length; i++) {
                            count = i + 1;
                            output += '<tr id="row_' + count + '">';
                               output += '<td>' + count + ' <input type="hidden" name="hidden_option" id="option' + count + '" class="option" value="' + data.L_Assignment_Q[i].QM.ID + '" /></td>';
                               output += '<td>' + data.L_Assignment_Q[i].QM.Q_Name + ' <input type="hidden"  id="option' + count + '" class="option" value="' + data.L_Assignment_Q[i].QM.Q_Name + '" /></td>';
                               if (data.L_Assignment_Q[i].QM.Type == 1) {
                                   output += '<td>صح او خطأ</td>';

                               } else if (data.L_Assignment_Q[i].QM.Type == 2) {
                                   output += '<td>خيار من متعدد</td>';
                               } else {
                                   output += '<td>وصل</td>';
                               }
                               output += '<td>' + data.L_Assignment_Q[i].QM.Q_Degry + ' <input type="hidden" name="hidden_degry" id="degry' + count + '" value="' + data.L_Assignment_Q[i].QM.Q_Degry + '" /></td>';
                            //output += '<td><button type="button" name="view_details" class="btn btn-warning btn-xs view_details" id="' + count + '">View</button></td>';
                               output += '<td>    <button name="remove_details" onclick="RemoveOption(' + count + ',' + data.L_Assignment_Q[i].QM.Q_Degry + ')" class="btn btn-danger" id="' + count + '">' +
                                '<i class="fas fa-trash">' +
                                '</i> حذف </button>';
                            output += '</tr>';

                               var Convertdegry = parseInt(data.L_Assignment_Q[i].QM.Q_Degry);

                            degry = degry + Convertdegry;
                               $('#AssingmentDegry_ID').val(degry);

                           }
                            $('#Assingment_Win_Degry_ID').val(data.Assignmet_degry_Win);
                        $('#Table_Options').html(output);

                    },
                    error: function (response) {
                        alert("the problem is " + response.responseText);
                    },
                    complete: function (response) {
                        $("div.spanner").removeClass("show");
                        $("div.overlay").removeClass("show");
                        $("div.spanner").addClass("hide");

                        $("div.overlay").addClass("hide");
                    }
                });
        }

        function GetQuesiont() {

            var cat_ID = $('#CategoryID').val();;
            $.ajax(
                {
                    async: true,
                    type: 'POST',
                    data: { type: 0, category_ID: cat_ID },
                      url: '@Url.Action("GetAllQuesinBank", "Controlpanel")',
                    success: function (data) {
                        var s = '';
                        for (var i = 0; i < data.length; i++) {
                            s += '<tr>' +
                                '<td> <input type="checkbox" name="question" value="' + data[i].ID + '" /></td>';
                            //'<td>' + data[i].ID + '</td>';
                            if (data[i].Type == 1) {
                                s += '<td>صح او خطأ</td>';

                            } else if (data[i].Type == 2) {
                                s += '<td>خيار من متعدد</td>';
                            } else {
                                s += '<td>وصل</td>';
                            }
                            s += '<td>' + data[i].Q_Name + '</td>' +
                                '</tr>';
                        }
                        $("#tableContent_ID").html(s);

                    },
                    error: function (response) {
                        alert("the problem is " + response.responseText);
                    },
                    complete: function (response) {
                        $('#example1').DataTable({
                            "paging": true,
                            "lengthChange": true,
                            "searching": true,
                            "ordering": true,
                            "order": [],
                            "info": true,
                            "autoWidth": false,
                            "responsive": true,

                        }).buttons().container().appendTo('#example1_wrapper .col-md-6:eq(0)');
                    }
                });
        }
    function SaveBtn() {
        $("div.spanner").addClass("show");
        $("div.overlay").addClass("show");
            const swalWithBootstrapButtons = Swal.mixin({});
            var fd = new FormData();
            var ID = $('#AssignmentID').val();
            var Name = $("#Assingment_Name").val();
            var Description = $("#Assingment_Text").val();

            var Lecture_ID = $("#Lecture_ID").val();

            var Assingment_Win_Degry = $('#Assingment_Win_Degry_ID').val();
            var assingDegry = $('#AssingmentDegry_ID').val();


            var L_Q = new Array();

            var option = document.getElementsByName("hidden_option");



            for (var i = 0; i < option.length; i++) {
                var MultiQ = {};
                //MultiQ.Assignment_ID = option[i].value;
                MultiQ.Q_ID = option[i].value;
                L_Q.push(MultiQ);
            }

            fd.ID = ID;
            fd.Name = Name;
            fd.Description = Description;
            fd.Lecture_ID = Lecture_ID;
            fd.Assignmet_Degry = assingDegry;
            fd.Assignmet_degry_Win = Assingment_Win_Degry;

            fd.L_Assignment_Q = L_Q;

            $.ajax({
                async: true,

                type: 'POST',
                dataType: 'html',
                contentType: 'application/json; charset=utf=8',
                data: JSON.stringify(fd),

                url: '@Url.Action("UpdateAssingQuestionToAssignment", "Controlpanel")',


                success: function (result) {
                    $("div.spanner").removeClass("show");
                    $("div.overlay").removeClass("show");
                    $("div.spanner").addClass("hide");

                    $("div.overlay").addClass("hide");
                    swalWithBootstrapButtons.fire(
                        'تم الحفظ!',
                        'تم اضافة الوظيفة بنجاح.',
                        'success'
                    ).then(function () {
                        var CategoryID = $("#CategoryID").val();
                        var CategoryName = $("#CategoryName").val();

                        window.location.href = '@Url.Action("LecturesByCategory", "Controlpanel")?Category_ID=' + CategoryID+'&categoryName=' + CategoryName;
                        //window.location.href = '@Url.Action("AddAssignment", "Controlpanel")?Lecture_ID=' + lectur_ID + '&categoryName=' + lectureName_ID;
                    });

                },
                error: function (response) {
                    swalWithBootstrapButtons.fire(
                        'Filed',
                        response.responseText + ' :)',
                        'error'
                    )
                },
                complete: function (response) {
                    $("div.spanner").removeClass("show");
                    $("div.overlay").removeClass("show");
                    $("div.spanner").addClass("hide");

                    $("div.overlay").addClass("hide");
                }
            }
            );
        }
        function backtoLecture() {
                 var CategoryID = $("#CategoryID").val();
                        var CategoryName = $("#CategoryName").val();

            window.location.href = '@Url.Action("LecturesByCategory", "Controlpanel")?Category_ID=' + CategoryID+'&categoryName=' + CategoryName;
        }
        $('#btn_AddQuestion').click(function () {
            var value = getSelectedCheckboxValues('question');

            $.ajax(
                {
                    async: true,
                    type: 'POST',
                    data: { L_Q: value },

                    url: '@Url.Action("GetQuestionListByID", "Controlpanel")',
                    success: function (data) {
                        var degry = 0;
                        var count = 0;
                        var output = '<tr><td></td><td>اسم السؤال</td><td>نوع السؤال</td><td>الدرجة</td><td></td></tr >';
                        for (var i = 0; i < data.length; i++) {
                            count = i + 1;
                            output += '<tr id="row_' + count + '">';
                            output += '<td>' + count + ' <input type="hidden" name="hidden_option" id="option' + count + '" class="option" value="' + data[i].ID + '" /></td>';
                            output += '<td>' + data[i].Q_Name + ' <input type="hidden"  id="option' + count + '" class="option" value="' + data[i].Q_Name + '" /></td>';
                            if (data[i].Type == 1) {
                                output += '<td>صح او خطأ</td>';

                            } else if (data[i].Type == 2) {
                                output += '<td>خيار من متعدد</td>';
                            } else {
                                output += '<td>وصل</td>';
                            }
                            output += '<td>' + data[i].Q_Degry + ' <input type="hidden" name="hidden_degry" id="degry' + count + '" value="' + data[i].Q_Degry + '" /></td>';
                            //output += '<td><button type="button" name="view_details" class="btn btn-warning btn-xs view_details" id="' + count + '">View</button></td>';
                            output += '<td>    <button name="remove_details" onclick="RemoveOption(' + count + ',' + data[i].Q_Degry + ')" class="btn btn-danger" id="' + count + '">' +
                                '<i class="fas fa-trash">' +
                                '</i> حذف </button>';
                            output += '</tr>';

                            var Convertdegry = parseInt(data[i].Q_Degry);

                            degry = degry + Convertdegry;
                            $('#AssingmentDegry_ID').val(degry);
                        }
                        $('#Table_Options').html(output);
                        validation();
                        WinChangeDegry();
                    },
                    error: function (response) {
                        alert("the problem is " + response.responseText);
                    },
                    complete: function (response) {
                        //alert("finish call jasion " + response);
                    }
                });
        });
        function RemoveOption(row_id,Q_Degry) {
            //var row_id = $(this).attr("id");

            if (confirm("هل متاكد من حذف هذا الإختيار؟")) {
                $('#row_' + row_id + '').remove();
                var degry = $('#AssingmentDegry_ID').val();
                var value = degry - Q_Degry;
                $('#AssingmentDegry_ID').val(value);
                validation();
            }
        }
    function WinChangeDegry() {
        validation();
            var Assingment_Win_Degry = $('#Assingment_Win_Degry_ID').val();
            var assingDegry = $('#AssingmentDegry_ID').val();

            let value = parseInt(Assingment_Win_Degry);
            let value3 = parseInt(assingDegry);
            if (value > value3) {
                $('#Assingment_Win_Degry_ID').val(value3);
                alert("درجة النجاح اكبر من علامة الوظيفة");
            }
            if (value <= 0) {
                $('#Assingment_Win_Degry_ID').val(value3 / 2);
                alert("يجب تعديل درجة النجاح");
            }
    }
    function validation() {
        var Assingment_Name = $('#Assingment_Name').val();
        var summernote = $("#Assingment_Text").val();
        var AssingmentDegry_ID = $("#AssingmentDegry_ID").val();
        var Assingment_Win_Degry_ID = $("#Assingment_Win_Degry_ID").val();


        if (Assingment_Name != "" && summernote != "" && AssingmentDegry_ID != "" && Assingment_Win_Degry_ID != "") {
            document.getElementById("btnSave").disabled = false;
        } else
            document.getElementById("btnSave").disabled = true;

    }
</script>
