            <tbody id="tableContent_ID">
                @*@foreach (var item in Model)
                    {*@


                @*}*@

            </tbody>
            <tfoot>
                <tr>
                    <th>ID</th>
                    <th>الاسم المحاضرة</th>

                    <th>الفئة</th>
