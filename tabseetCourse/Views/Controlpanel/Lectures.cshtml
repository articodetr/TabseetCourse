<!-- Page specific script -->
<script>
    $(document).ready(function () {


    });

    $(function () {
           $.ajax(
            {
                async: true,
                type: 'POST',
                //dataType: 'JSON',
                //contentType: 'application/json; charset=utf=8',
                //data: dataJson,
                url: '@Url.Action("AllLectures", "Controlpanel")',
                success: function (data) {
                    var s = '';
                    for (var i = 0; i < data.length; i++) {
                        s += '<tr>' +
                            '<td>' + data[i].ID + '</td>' +
                            '<td>' + data[i].Lecture_Name + '</td>' +
                            '<td>' + data[i].NameAr + '</td>';
                        if (data[i].LectureTypeOnOff == 1) {
                            s += '<td>مباشر</td>' +
                                '<td><a href="' + data[i].LectureLink_Host + '"> للمحاضر  </a>/<a href="' + data[i].LectureLink_Client + '">  للطالب </a></td>';
                        } else {
                            s += '<td>مسجلة</td>' +
                                '<td><a href="' + data[i].LectureLink_Client + '"> رابط المحاضرة  </a></td>';
                        }
                        s +=   '<td>' +
                            //'<button class="btn btn-info  float-sm-left" onclick="GetCategoryByID(' + data[i].ID +')" data-toggle="modal" data-target="#EditModal">' +
                            //'<i class="fas fa-edit">' +
                            //'</i>' +
                            //'Edite' +
                            //'</button>' +
                            //'<button class="btn btn-danger  float-sm-right" onclick = "btnDelete(' + data[i].ID +')" >' +
                            //'<i class="fas fa-trash">' +
                            //'</i>' +
                            //'Delete' +
                            //'</button>' +
                            '</td>' +
                    '</tr>';
                    }
                    $("#tableContent_ID").html(s);

                },
                error: function (response) {
                    alert("the problem is " + response.responseText);
                },
                complete: function (response) {
                    $('#example1').DataTable({
                        "paging": true,
                        "lengthChange": true,
                        "searching": true,
                        "ordering": true,
                        "order": [],
                        "info": true,
                        "autoWidth": true,
                        "responsive": true,
                        "buttons": ["copy", /*"csv",*/ "excel", /*"pdf",*/ "print", "colvis"]
                    }).buttons().container().appendTo('#example1_wrapper .col-md-6:eq(0)');
                }
            });


    });

    const checkbox = document.getElementById('IsPayed_ID');

    checkbox.addEventListener('change', (event) => {
        if (event.currentTarget.checked) {
            $("#PayedValueDIV_ID").show();
            $("#IsPayed_ID").val(1);
        } else {
            $("#PayedValueDIV_ID").hide();
            $("#IsPayed_ID").val(0);
        }
    });
    const Echeckbox = document.getElementById('EIsPayed_ID');
    Echeckbox.addEventListener('change', (event) => {
        if (event.currentTarget.checked) {
            $("#EPayedValueDIV_ID").show();
            $("#EIsPayed_ID").val(1);
        } else {
            $("#EPayedValueDIV_ID").hide();
            $("#EIsPayed_ID").val(0);
        }
    });

    $('#btnSave').click(function () {
        validationSaveForm();
        var fd = new FormData();

        var NameAR_ID = $("#NameAR_ID").val();
        var NameEN_ID = $("#NameEN_ID").val();
        var Type_ID = $("#Type_ID").val();
        var IsPayed_ID = $("#IsPayed_ID").val();
        var PayedValue_ID = $("#PayedValue_ID").val();
        var Categories_ID = $("#Categories_ID").val();

        fd.NameAR = NameAR_ID;
        fd.NameEN = NameEN_ID;
        fd.CategoryType_ID = Type_ID;
        fd.IsPayed = IsPayed_ID;
        fd.PayedValue = PayedValue_ID;
        fd.ParentCateogry_ID = Categories_ID;
        var dataJson = JSON.stringify(fd);
        $.ajax(
            {
                async: true,
                type: 'POST',
                dataType: 'JSON',
                contentType: 'application/json; charset=utf=8',
                data: dataJson,
                url: '@Url.Action("CreateCategories", "Controlpanel")',
                success: function (data) {
                    window.location.reload();
                },
                error: function (response) {
                    alert("the problem is " + response.responseText);
                },
                complete: function (response) {
                    //alert("finish call jasion " + response);
                }
            });
    });
    $('#btnUpdate').click(function () {
        validationSaveForm();
        var fd = new FormData();

        var EditID = $("#EditID").val();
        var ENameAR_ID = $("#ENameAR_ID").val();
        var ENameEN_ID = $("#ENameEN_ID").val();
        var EType_ID = $("#EType_ID").val();
        var ECategories_ID = $("#ECategories_ID").val();
        var EIsPayed_ID = $("#EIsPayed_ID").val();
        var EPayedValue_ID = $("#EPayedValue_ID").val();
        fd.ID = EditID;
        fd.NameAR = ENameAR_ID;
        fd.NameEN = ENameEN_ID;
        fd.CategoryType_ID = EType_ID;
        fd.IsPayed = EIsPayed_ID;
        fd.PayedValue = EPayedValue_ID;
        fd.ParentCateogry_ID = ECategories_ID;
        var dataJson = JSON.stringify(fd);
        $.ajax(
            {
                async: true,
                type: 'POST',
                dataType: 'JSON',
                contentType: 'application/json; charset=utf=8',
                data: dataJson,
                url: '@Url.Action("EditeCategories", "Controlpanel")',
                success: function (data) {
                    window.location.reload();
                },
                error: function (response) {
                    alert("the problem is " + response.responseText);
                },
                complete: function (response) {
                    //alert("finish call jasion " + response);
                }
            });
    });

    function GetCategoryByID(categoryID) {

        $.ajax(
            {
                async: true,
                type: 'POST',
                //dataType: 'JSON',
                //contentType: 'application/json; charset=utf=8',
                data: { catID: categoryID },
                url: '@Url.Action("EditCategorie", "Controlpanel")',
                success: function (data) {
                    TypeChange(data.CategoryType_ID);
                    $("#EditID").val(data.ID);
                    $("#ENameAR_ID").val(data.NameAr);
                    $("#ENameEN_ID").val(data.NameEn);
                    if (data.IsPayed == 1) {
                        $("#EIsPayed_ID").val(1);
                        $("#EPayedValueDIV_ID").show();
                        $("#EIsPayed_ID").val(1);
                        $("#EIsPayed_ID").prop("checked", true);

                    } else {
                        $("#EIsPayed_ID").val(0);
                        $("#EPayedValueDIV_ID").show();
                        $("#EIsPayed_ID").val(0);
                        $("#EIsPayed_ID").prop("checked", false);

                    }

                    $("#EType_ID").val(data.CategoryType_ID);
                    console.log(data.ParentCateogry_ID);
                    $("#ECategories_ID").val(data.ParentCateogry_ID);

                    $("#EPayedValue_ID").val(data.PayedValue);

                },
                error: function (response) {
                    alert("the problem is " + response.responseText);
                },
                complete: function (response) {
                    //alert("finish call jasion " + response);
                }
            });
    }

    function btnDelete(ID) {
            const swalWithBootstrapButtons = Swal.mixin({
                customClass: {
                    confirmButton: 'btn btn-success',
                    cancelButton: 'btn btn-danger'
                },
                buttonsStyling: false
            });

        swalWithBootstrapButtons.fire({
            title: 'Are you sure?',
            text: "You won't be able to delete this!",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Delete it!',
            cancelButtonText: 'Cancel!',
            reverseButtons: true
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax(
                    {
                        async: true,
                        type: 'POST',
                        //dataType: 'JSON',
                        //contentType: 'application/json; charset=utf=8',
                        data: { Categories_ID: ID },
                        url: '@Url.Action("DeleteCategories", "Controlpanel")',
                        success: function (data) {
                            swalWithBootstrapButtons.fire(
                                'Deleted!',
                                'Your file has been deleted.',
                                'success'
                            ).then(function () { window.location.reload(); })

                        },
                        error: function (response) {
                            swalWithBootstrapButtons.fire(
                                'Filed',
                                response.responseText+' :)',
                                'error'
                            )
                        },
                        complete: function (response) {
                            //alert("finish call jasion " + response);
                        }
                    });

            } else if (
                /* Read more about handling dismissals below */
                result.dismiss === Swal.DismissReason.cancel
            ) {
                swalWithBootstrapButtons.fire(
                    'Cancelled',
                    'Your  file is safe :)',
                    'error'
                )
            }
        })

    }
    function TypeChange(Type_ID) {
        if (Type_ID == 1) {
            //$("#Categories_ID").disabled = true;
            $("#categoryDiv_ID").hide();
            $("#EcategoryDiv_ID").hide();

        }
        else {
        $.ajax(
            {
                async: true,
                type: 'POST',
                data: { type:1},
                url: '@Url.Action("GetCategoriesByType", "Controlpanel")',
                success: function (data) {
                    var s = '<option> Select Type </option>';
                    for (var i = 0; i < data.length; i++) {
                        s += '<option value="' + data[i].ID + '">' + data[i].NameAr + '</option>';
                    }
                    $("#Categories_ID").html(s);
                    $("#ECategories_ID").html(s);
                    $("#categoryDiv_ID").show();
                    $("#EcategoryDiv_ID").show();
                },
                error: function (response) {
                    alert("the problem is " + response.responseText);
                },
                complete: function (response) {
                    //alert("finish call jasion " + response);
                }
            });
        }
    }
    function validationSaveForm() {
        var first = $("#NameAR_ID").val();
        var value = true;
        if (first == "") {

            $("#reqNameAR_ID").html("* الاسم مطلوب");

            value= false;
        }
        //if (x) {

        //}
    }
</script>