                                        <input type="checkbox" id="EIsPayed_ID" class="form-control" required />
                                        <span id="reqNameEN_ID" style="color:red"></span>
                                    </div>
                                </div>
                            </div>
                        </td>
                        <td>
                            <div class="row">
                                <div class="col-sm-12">
                                    <!-- select -->
                                    <div class="form-group" id="EPayedValueDIV_ID">
                                        <label>قيمة الدفع</label>
                                        <input type="text" id="EPayedValue_ID" class="form-control" style="width:100%" required />
                                        <span id="reqCategory_ID" style="color:red"></span>
