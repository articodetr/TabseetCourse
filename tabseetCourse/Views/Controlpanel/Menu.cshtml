@model IEnumerable<tabseetCourse.Models_UI.MenuModel>

@{
    ViewBag.Title = "Menu";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="main-content">
    <div class="page-title">
        <div class="sub-title"> Menu</div>
    </div>

    <table class="table">
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Title)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.New_Page_Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Lang_ID)
            </th>
            <th></th>
        </tr>

        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Title)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.New_Page_Name)
                </td>
                @*<td>
                    @Html.DisplayFor(modelItem => item.Lang_name)
                </td>*@
                <td>
                    @*@Html.ActionLink("Edit", "Edit", new { id=item.ID }) |*@
                    @*@Html.ActionLink("Details", "Details", new { id=item.ID }) |*@
                    <button type="button" class="btn btn-danger" onclick="DeleteItem(@item.ID)">Delete </button>
                    @*@Html.ActionLink("Delete", "Delete", new { id = item.ID })*@
                </td>
            </tr>
        }

        <tr style="display:none" id="CreateNew">
            <td>
                @*<label for="Item Name">Item name</label>*@
                <input type="text" placeholder="Item Name" id="TxtItemName" />
            </td>
            <td>
                <select id="Page_ID">
                    <option value="-1">Select Pages</option>
                    @*<option value="1">About Us</option>
                        <option value="2">Contact US</option>
                        <option value="3">Horizontal tape</option>
                        <option value="4">vertical tape</option>
                        <option value="5">Page Text</option>*@
                </select>
            </td>
            <td>
                <select id="Language_ID">
                  
                </select>
            </td>
            <td>
                <button type="button" class="btn btn-primary" onclick="Save()">Save</button>
                @*<button type="button" class="btn btn-primary" onclick="Cleare()">Cleare</button>*@
            </td>
        </tr>
    </table>

    <div class="row">
        <div class="col-sm-6">
            <div class="row">
                <div class="col-xs-12 m-b">
                    <div class="demo-button">
                        <button type="button" class="btn btn-primary" onclick="Create()">Add Menu</button>
                        @*<button type="button" class="btn btn-success" onclick="Save()">Save</button>*@
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>

<script src="~/Content/plugins/jquery/jquery.min.js"></script>
<script type="text/javascript">

        function Create() {
            $("#CreateNew").show();

            $.ajax(
                {
                    async: true,

                    type: 'POST',
                    //dataType: 'JSON',
                    //contentType: 'application/json; charset=utf=8',
                    //data: { id: Exam_id },

                    url: '@Url.Action("GetAllLanguages", "Controlpanel")',
                    success: function (data) {

                        var s;
                        for (var i = 0; i < data.length; i++) {
                            s += '<option value="' + data[i].ID + '">' + data[i].Name + '</option>';
                        }
                        $("#Language_ID").html(s);
                    },
                    error: function (response) {
                        alert("there is a problem in supject " + response);
                    },
                    complete: function (response) {
                        //alert("finish call jasion " + response);
                    }
                });

               $.ajax(
                {
                    async: true,

                    type: 'POST',
                    //dataType: 'JSON',
                    //contentType: 'application/json; charset=utf=8',
                    //data: { id: Exam_id },

                    url: '@Url.Action("GetAllPages", "Controlpanel")',
                    success: function (data) {

                        var s;
                        for (var i = 0; i < data.length; i++) {
                            s += '<option value="' + data[i].ID + '">' + data[i].Name + '</option>';
                        }
                        $("#Page_ID").html(s);
                    },
                    error: function (response) {
                        alert("there is a problem in supject " + response);
                    },
                    complete: function (response) {
                        //alert("finish call jasion " + response);
                    }
                })


        }

    function Save() {
        var Language_ID = $("#Language_ID").val();
            //$("#CB_ID").val();
            $.ajax(
                {
                    async: true,

                    type: 'POST',
                    //dataType: 'JSON',
                    //contentType: 'application/json; charset=utf=8',
                    data: { title: $("#TxtItemName").val(), PageID: $("#Page_ID").val(), LangID: Language_ID },

                    url: '@Url.Action("Menu", "Controlpanel")',
                    success: function (result) {

                        location.reload(true);
                        //window.location.reload();
                    },
                    error: function (response) {

                        alert("the problem is " + response);
                    },
                    complete: function (response) {
                        //alert("finish call jasion " + response);
                    }
                });
            $("#CreateNew").hide();
        }

    function DeleteItem(itemID)
    {
        if (confirm("Are you sure to delete the item ?")) {
            $.ajax(
                {
                    async: true,

                    type: 'POST',

                    data: { ID: itemID },

                    url: '@Url.Action("DeleteMenu", "Controlpanel")',
                    success: function (result) {

                        //alert("Items was deleted " + result.result);
                        location.reload(true);

                    },
                    error: function (response) {

                        alert("the problem is " + response);
                    },
                    complete: function (response) {
                        //alert("complete" + response);
                    }
                });
        }


    }


</script>