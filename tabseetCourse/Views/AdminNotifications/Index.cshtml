@model tabseetCourse.Models.NotificationPagedListViewModel

@{
    ViewBag.Title = "إشعارات المدرسين";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var filter = Model.Filter;
    // بعد "تحديد كمقروء" نعود إلى نفس التبويب والبحث والصفحة
    string returnUrl = Request.RawUrl;
    string emptyText = !string.IsNullOrWhiteSpace(filter.Search) ? "لا توجد نتائج مطابقة للبحث"
        : filter.Status == "unread" ? "لا توجد إشعارات غير مقروءة"
        : filter.Status == "read" ? "لا توجد إشعارات مقروءة"
        : "لا توجد إشعارات بعد. ستظهر هنا تغييرات المدرسين على المحاضرات.";
}

@* الـ layout الإداري لا يحمّل jQuery بنفسه؛ كل صفحة تحمّله قبل سكربتات الـ layout (الجرس والقوائم). بدونه يتعطل كل JavaScript في الصفحة. *@
<script src="~/Content/plugins/jquery/jquery.min.js"></script>

<style>
    .notif-item { border-right: 4px solid transparent; }
    .notif-item.unread { border-right-color: #007bff; background-color: #f5f9ff; }
    .notif-title { font-weight: 600; color: #212529; }
    .notif-meta { color: #6c757d; font-size: 0.875rem; }
    .notif-meta span + span::before { content: "•"; margin: 0 8px; color: #adb5bd; }
    .notif-tabs .nav-link { color: #495057; }
    .notif-tabs .nav-link.active { font-weight: 600; }
</style>

<div class="content-header">
    <div class="container-fluid">
        <div class="d-flex justify-content-between align-items-center flex-wrap">
            <h1 class="m-0 text-dark"><i class="fas fa-bell text-warning ml-2"></i> إشعارات المدرسين</h1>
            @if (Model.TotalUnreadCount > 0)
            {
                using (Html.BeginForm("MarkAllAsRead", "AdminNotifications", FormMethod.Post, new { @class = "m-0" }))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                    <button type="submit" class="btn btn-outline-primary btn-sm">
                        <i class="fas fa-check-double ml-1"></i> تحديد الكل كمقروء (@Model.TotalUnreadCount)
                    </button>
                }
            }
        </div>
    </div>
</div>

<div class="container-fluid">
    @if (TempData["NotificationError"] != null)
    {
        <div class="alert alert-danger">@TempData["NotificationError"]</div>
    }

    <div class="card">
        <div class="card-header">
            <div class="d-flex justify-content-between align-items-center flex-wrap">
                <ul class="nav nav-pills notif-tabs">
                    <li class="nav-item">
                        <a class="nav-link @(filter.Status == "all" ? "active" : "")" href="@Url.Action("Index", new { Status = "all", Search = filter.Search })">
                            الكل <span class="badge badge-light">@Model.TotalAllCount</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(filter.Status == "unread" ? "active" : "")" href="@Url.Action("Index", new { Status = "unread", Search = filter.Search })">
                            غير مقروءة <span class="badge badge-warning">@Model.TotalUnreadCount</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(filter.Status == "read" ? "active" : "")" href="@Url.Action("Index", new { Status = "read", Search = filter.Search })">
                            مقروءة <span class="badge badge-light">@Model.TotalReadCount</span>
                        </a>
                    </li>
                </ul>

                <form method="get" action="@Url.Action("Index", "AdminNotifications")" class="form-inline">
                    <input type="hidden" name="Status" value="@filter.Status" />
                    <input type="text" name="Search" value="@filter.Search" class="form-control form-control-sm ml-1" placeholder="بحث باسم المدرس أو الدورة أو المحاضرة" style="min-width: 260px;" />
                    <button type="submit" class="btn btn-sm btn-default"><i class="fas fa-search"></i></button>
                    @if (!string.IsNullOrWhiteSpace(filter.Search))
                    {
                        <a href="@Url.Action("Index", new { Status = filter.Status })" class="btn btn-sm btn-link">مسح البحث</a>
                    }
                </form>
            </div>
        </div>

        <div class="card-body p-0">
            @if (!Model.Items.Any())
            {
                <div class="text-center py-5 text-muted">
                    <i class="far fa-bell-slash" style="font-size: 3rem;"></i>
                    <h5 class="mt-3">@emptyText</h5>
                </div>
            }
            else
            {
                <div class="list-group list-group-flush">
                    @foreach (var item in Model.Items)
                    {
                        <div class="list-group-item notif-item @(item.IsRead ? "" : "unread")" id="notif-item-@item.NotificationId">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    @if (!item.IsRead)
                                    {
                                        <span class="badge badge-primary ml-1">جديد</span>
                                    }
                                    <span class="notif-title">@item.Title</span>
                                    <span class="@item.ActionBadgeClass mr-1">@item.ActionTypeArabic</span>
                                </div>
                                <small class="text-muted text-nowrap" title="@item.CreatedAtFormatted">
                                    <i class="far fa-clock ml-1"></i>@item.TimeAgo
                                </small>
                            </div>

                            <p class="mb-1 mt-1">@item.Details</p>

                            @if (!string.IsNullOrWhiteSpace(item.OldValue) || !string.IsNullOrWhiteSpace(item.NewValue))
                            {
                                <div class="notif-meta">
                                    @if (!string.IsNullOrWhiteSpace(item.OldValue))
                                    {
                                        <span>قبل: @item.OldValue</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(item.NewValue))
                                    {
                                        <span>بعد: @item.NewValue</span>
                                    }
                                </div>
                            }

                            <div class="d-flex justify-content-between align-items-center flex-wrap mt-2">
                                <div class="notif-meta">
                                    <span><i class="fas fa-user-tie ml-1"></i>@item.TeacherName</span>
                                    <span><i class="fas fa-book ml-1"></i>@item.CourseName</span>
                                    <span><i class="fas fa-video ml-1"></i>@item.LectureTitle</span>
                                </div>
                                <div class="d-flex align-items-center">
                                    @if (item.LectureExists && item.CategoryId.HasValue)
                                    {
                                        <a href="@Url.Action("LecturesByCategory", "Controlpanel", new { Category_ID = item.CategoryId.Value, categoryName = item.CourseName })" class="btn btn-outline-secondary btn-sm ml-2">
                                            <i class="fas fa-external-link-alt ml-1"></i> فتح المحاضرة
                                        </a>
                                    }
                                    @if (!item.IsRead)
                                    {
                                        using (Html.BeginForm("MarkAsRead", "AdminNotifications", FormMethod.Post, new { @class = "m-0" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.NotificationId" />
                                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                                            <button type="submit" class="btn btn-success btn-sm">
                                                <i class="fas fa-check ml-1"></i> تحديد كمقروء
                                            </button>
                                        }
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="card-footer d-flex justify-content-between align-items-center">
                @if (Model.CurrentPage > 1)
                {
                    <a class="btn btn-default btn-sm" href="@Url.Action("Index", new { Status = filter.Status, Search = filter.Search, Page = Model.CurrentPage - 1 })">
                        <i class="fas fa-chevron-right ml-1"></i> السابق
                    </a>
                }
                else
                {
                    <span></span>
                }
                <span class="text-muted">صفحة @Model.CurrentPage من @Model.TotalPages (@Model.TotalItems إشعار)</span>
                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <a class="btn btn-default btn-sm" href="@Url.Action("Index", new { Status = filter.Status, Search = filter.Search, Page = Model.CurrentPage + 1 })">
                        التالي <i class="fas fa-chevron-left mr-1"></i>
                    </a>
                }
                else
                {
                    <span></span>
                }
            </div>
        }
    </div>
</div>
